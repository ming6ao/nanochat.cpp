py_test(
    name = "gpu_queue_test",
    srcs = ["tests/gpu_queue_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the distributed launch plan, the launcher JSON summary, and the log
# parser. Hermetic: a fake `tools/nanochat`, so it needs no library, no Bazel,
