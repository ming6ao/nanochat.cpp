# python/ — the single Python surface: the compute layer (`api`), the
# planning layer (`plan`), the chat evaluation (`chat`), and the orchestration
# layer (`toolchain`). See docs/python.md. Nothing here is a runtime dependency
# of the C++ code.
#
# The package imports only the Python standard library, so the tests run on the
# registered local `python3` toolchain and need no third-party wheel. Every
# third-party import has one home: `nanochat_cpp_bridge`, the second import
# package of the one distribution declared in pyproject.toml
# (docs/dependency-layering-plan.md sections 4 and 6.1).

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# The package description: the empty base dependency list and the extras of
# section 6.1. Exported so a test in another package (gate G3, which reads it
# through the runfiles) can name it, and so a consumer sees the file that
# states the invariant.
exports_files(["pyproject.toml"])

# The in-process Python API and the process bridge. `imports = ["."]` puts
# `python/` on the import path of every dependent, so `import nanochat_cpp`
# resolves.
py_library(
    name = "nanochat_cpp",
    srcs = glob(["nanochat_cpp/*.py"]),
    imports = ["."],
)

# The adapter package (Z2 of section 4). One distribution, two import packages
# (D1, D2): the base install carries this library beside `nanochat_cpp`, and a
# module here imports its heavy package inside the function that needs it, so
# the target builds and the import succeeds with no extra installed.
py_library(
    name = "nanochat_cpp_bridge",
    srcs = glob([
        "nanochat_cpp_bridge/*.py",
        "nanochat_cpp_bridge/fixtures/*.py",
    ]),
    imports = ["."],
    deps = [":nanochat_cpp"],
)

# T0: the ctypes core loads the CPU library and runs one forward/backward step.
py_test(
    name = "core_test",
    srcs = ["tests/core_test.py"],
    data = ["//bindings:nanochat_shared"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the on-demand builder key and the library search order. Hermetic: it
# never compiles and needs no library.
py_test(
    name = "build_test",
    srcs = ["tests/build_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the API drives a tiny training run and an evaluation that match the
# committed C++ fixture. The runfiles carry the fixture, the shared library,
# the parquet document set, and the NCTOKEN1 artifact.
py_test(
    name = "api_test",
    srcs = ["tests/api_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//src/parquet:testdata/text.parquet",
        "//tests:api_fixture",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the NCTOKEN1 reader. Hermetic: standard library only. The tokenizer
# bridge coverage reads `nanochat_cpp_bridge.reference_data`, so this test
# depends on the Z2 library.
py_test(
    name = "data_test",
    srcs = ["tests/data_test.py"],
    deps = [
        ":nanochat_cpp",
        ":nanochat_cpp_bridge",
    ],
    size = "small",
)

# T0: the reference-checkpoint name, dtype, container, metadata, and path
# logic. The test reads two files: the committed version 0 fixture
# `//tests:checkpoint_v0_fixture` (`tests/data/checkpoint_v0.ckpt`, the pinned
# bytes a Hub artifact already carries) and `//bindings:nanochat_shared`, whose
# C writer fills the metadata. The version 1 file is written at test time into a
# temporary directory, so no second fixture is committed here
# (docs/checkpoint-metadata-and-examples-plan.md stages A.2 and A.5). The torch
# half of the conversion lives in `nanochat_cpp_bridge.torch_checkpoint`, so
# the test depends on the Z2 library; it drives that builder with fake tensors
# and still needs no torch.
py_test(
    name = "checkpoint_test",
    srcs = ["tests/checkpoint_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//tests:checkpoint_v0_fixture",
    ],
    deps = [
        ":nanochat_cpp",
        ":nanochat_cpp_bridge",
    ],
    size = "small",
)

# T0: the evaluation fixture wire format. Hermetic: standard library only.
py_test(
    name = "eval_fixture_test",
    srcs = ["tests/eval_fixture_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the planning layer matches the reference plan fixture. It needs the
# shared library for `nanochat_params_get` and the committed fixture.
py_test(
    name = "plan_test",
    srcs = ["tests/plan_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//tests:plan_fixture",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the chat prompt renderer and the per-task isolation. It needs the
