py_test(
    name = "sandbox_test",
    srcs = ["tests/sandbox_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the style gate. Hermetic and CPU-only: a fake `clang-format` on PATH and
