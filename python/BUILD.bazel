# `bazelisk` on PATH keeps the startup lookup happy without a Bazel run.
py_test(
    name = "contract_test",
    srcs = ["tests/contract_test.py"],
    data = [
        "//tools:fixtures",
        "//tools:nanochat",
        "//tools:sandbox_data",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the resource sandbox launcher and the limit verifier. The launcher runs
