        "//bindings:nanochat_shared",
        "//tests:chat_fixture",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the SFT packer and the task mixture. Hermetic: a fake tokenizer and a
# fake renderer, so it needs no hub download, no library, and no GPU.
py_test(
    name = "sft_data_test",
    srcs = ["tests/sft_data_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the R1 (P4) data parity gate the docs cite, `docs/sft-parity-plan.md`
# section 7 phase C.1 and `docs/parity.md`: the reference render, pack, and
# mixture order reproduced from the committed pack fixture
# (`//tests:sft_pack_fixture`, `tests/data/sft_pack_fixture.bin`). It reads
# that one file and rebuilds the fixture tokenizer from the fixture's own
# `pieces` table, so it needs no library, no torch, no network, and no GPU --
# only the runfiles carry the bytes.
py_test(
    name = "sft_data_parity_test",
    srcs = ["tests/sft_data_parity_test.py"],
    data = ["//tests:sft_pack_fixture"],
    deps = [":nanochat_cpp"],
    size = "small",
