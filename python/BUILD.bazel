py_test(
    name = "distributed_test",
    srcs = ["tests/distributed_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the RL bridge renders prompts, speaks the worker pipe protocol, and
# reports the loss. Hermetic: a fake worker, tokenizer, task, and shell tool,
