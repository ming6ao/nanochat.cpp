# The five boundary gates of docs/dependency-layering-plan.md section 8. A
# boundary that no test reads is a comment, so each gate is a self-contained
# unittest module that needs no wheel, no library, and no network.

# T0: G1 runs the core import in a fresh `python3 -I -S` subprocess, so the
# runfiles carry the sources that subprocess imports from the tree.
py_test(
    name = "gate_import_isolation_test",
    srcs = ["tests/gate_import_isolation_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: G2 walks the syntax tree of every core module and fails on an import
# outside the standard library, including one inside a function. It reads the
# sources through its library's runfiles.
py_test(
    name = "gate_stdlib_imports_test",
    srcs = ["tests/gate_stdlib_imports_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: G3 reads the package description and fails when the base dependency list
# is missing or not empty (section 6.1), so the file is the test's data.
py_test(
    name = "gate_pyproject_test",
    srcs = ["tests/gate_pyproject_test.py"],
    data = ["pyproject.toml"],
    size = "small",
)

# T0: G4 reads every model manifest and fails on a record with no producer
# (section 7.2). The model's `files` label is the data, so the gate sees the
# same bytes the model package publishes.
py_test(
    name = "gate_provenance_test",
    srcs = ["tests/gate_provenance_test.py"],
    data = ["//models/nanochat-default:files"],
    size = "small",
)

# T0: G5 scans the core text and fails on one mention of the Z2 package, which
# is rule 5 of the zones. It reads the sources through its library's runfiles.
py_test(
    name = "gate_core_independence_test",
    srcs = ["tests/gate_core_independence_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the `tools/nanochat parity` dispatch of the plan's section 7.3. Hermetic
# and torch-free: it runs the dispatch and the producer's own `--help`, and the
# canary asserts that no torch is importable, so a help path that needed an
# extra would fail here instead of on a host. The script is a host file, so it
# travels as data and not as a dependency.
py_test(
    name = "parity_dispatch_test",
    srcs = ["tests/parity_dispatch_test.py"],
    data = ["//tools:nanochat"],
    deps = [
        ":nanochat_cpp",
        ":nanochat_cpp_bridge",
    ],
    size = "small",
)

