# python/ — the single Python surface: the compute layer (`api`), the
# planning layer (`plan`), the chat evaluation (`chat`), and the orchestration
# layer (`toolchain`). See docs/python.md. Nothing here is a runtime dependency
# of the C++ code.
#
# The package imports only the Python standard library, so the tests run on the
# registered local `python3` toolchain and need no third-party wheel.

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# The in-process Python API and the process bridge. `imports = ["."]` puts
# `python/` on the import path of every dependent, so `import nanochat_cpp`
# resolves.
py_library(
    name = "nanochat_cpp",
    srcs = glob(["nanochat_cpp/*.py"]),
    imports = ["."],
)

# T0: the ctypes core loads the CPU library and runs one forward/backward step.
py_test(
    name = "core_test",
    srcs = ["tests/core_test.py"],
    data = ["//bindings:nanochat_shared"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the on-demand builder key and the library search order. Hermetic: it
# never compiles and needs no library.
py_test(
    name = "build_test",
    srcs = ["tests/build_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the API drives a tiny training run and an evaluation that match the
# committed C++ fixture. The runfiles carry the fixture, the shared library,
# the parquet document set, and the NCTOKEN1 artifact.
py_test(
    name = "api_test",
    srcs = ["tests/api_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//src/parquet:testdata/text.parquet",
        "//tests:api_fixture",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the NCTOKEN1 reader. Hermetic: standard library only.
py_test(
    name = "data_test",
    srcs = ["tests/data_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the reference-checkpoint name, dtype, container, and path logic. The
# container bytes come from the C writer, so the test loads the shared library.
py_test(
    name = "checkpoint_test",
    srcs = ["tests/checkpoint_test.py"],
    data = ["//bindings:nanochat_shared"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the evaluation fixture wire format. Hermetic: standard library only.
py_test(
    name = "eval_fixture_test",
    srcs = ["tests/eval_fixture_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the planning layer matches the reference plan fixture. It needs the
# shared library for `nanochat_params_get` and the committed fixture.
py_test(
    name = "plan_test",
    srcs = ["tests/plan_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//tests:plan_fixture",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the chat prompt renderer and the per-task isolation. It needs the
# shared library, the fixture tokenizer, and the committed chat fixture.
py_test(
    name = "chat_test",
    srcs = ["tests/chat_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//tests:chat_fixture",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the SFT packer and the task mixture. Hermetic: a fake tokenizer and a
# fake renderer, so it needs no hub download, no library, and no GPU.
py_test(
    name = "sft_data_test",
    srcs = ["tests/sft_data_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the orchestration layer argv. Hermetic: no library, no Bazel, no GPU.
py_test(
    name = "toolchain_test",
    srcs = ["tests/toolchain_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the Bazel output-base reaper, moved out of shell. Hermetic: a synthetic
# output user root and a fake live server, so it needs no GPU and never touches
# the real `~/.cache/bazel`. See docs/sandbox.md.
py_test(
    name = "prune_test",
    srcs = ["tests/prune_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the observable contract of `tools/nanochat` before the language move
# (docs/script-consolidation-plan.md section 7, P2). It runs the real entry
# script and the real sandbox launcher, so the runfiles carry both. A fake
# `bazelisk` on PATH keeps the startup lookup happy without a Bazel run.
py_test(
    name = "contract_test",
    srcs = ["tests/contract_test.py"],
    data = [
        "//tools:fixtures",
        "//tools:nanochat",
        "//tools:sandbox_scripts",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the GPU job queue store, worker, and state machine. Hermetic and
# CPU-only: a temporary queue directory, a fake `nvidia-smi`, and a fake
# `tools/sandbox.sh`. See docs/gpu-queue-plan.md.
py_test(
    name = "gpu_queue_test",
    srcs = ["tests/gpu_queue_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the distributed launch plan, the launcher JSON summary, and the log
# parser. Hermetic: a fake `tools/nanochat`, so it needs no library, no Bazel,
# and no GPU. See docs/distributed-launch.md section 6.
py_test(
    name = "distributed_test",
    srcs = ["tests/distributed_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the RL bridge renders prompts, speaks the worker pipe protocol, and
# reports the loss. Hermetic: a fake worker, tokenizer, task, and shell tool,
# so it needs no library, no Bazel, and no GPU.
py_test(
    name = "rl_test",
    srcs = ["tests/rl_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T1: the CUDA flavor of the fixture-parity test. The same source and data as
# `api_test`, but linked against the CUDA library under `--config=cuda`.
py_test(
    name = "api_gpu_test",
    srcs = ["tests/api_test.py"],
    main = "tests/api_test.py",
    data = [
        "//bindings:nanochat_shared",
        "//src/parquet:testdata/text.parquet",
        "//tests:api_fixture",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
    tags = ["gpu", "manual"],
)

# T1: the in-process API on the CUDA backend. `tools/nanochat test --gpu`
# builds it under `--config=cuda` and selects it by the `gpu` tag. The same
# source stays out of the CPU loop.
py_test(
    name = "gpu_test",
    srcs = ["tests/gpu_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//src/parquet:testdata/text.parquet",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
    tags = ["gpu", "manual"],
)

# T1: the chat evaluation paths on the CUDA backend. `tools/nanochat test
# --gpu` builds it under `--config=cuda` and selects it by the `gpu` tag. The
# same source stays out of the CPU loop.
py_test(
    name = "chat_gpu_test",
    srcs = ["tests/chat_gpu_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
    tags = ["gpu", "manual"],
)

# T0: the device mesh and the placement language for the single-client
# multi-device runtime (docs/client-runtime-design.md sections 5.1 to 5.4). It
# loads the shared library for `devices()` and checks the rank-1 rule, the axis
# name, and the placement set. CPU only; no GPU and no broker.
py_test(
    name = "mesh_test",
    srcs = ["tests/mesh_test.py"],
    data = ["//bindings:nanochat_shared"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the single-client multi-device runtime client
# (docs/client-runtime-design.md sections 10 and 16). Two and four replicas
# that split one global batch equal one replica on the whole batch. The test
# uses a simulated CPU mesh, so it needs no GPU and no broker.
py_test(
    name = "runtime_test",
    srcs = ["tests/runtime_test.py"],
    data = ["//bindings:nanochat_shared"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the Python client of the C++ mesh training driver
# (docs/client-runtime-design.md section 10.1, docs/training-seam.md
# section 6.6). One driver call runs a two-step job and writes the record and
# the summary. The runfiles carry the shared library, the parquet document set,
# and the tokenizer artifact.
py_test(
    name = "mesh_train_test",
    srcs = ["tests/mesh_train_test.py"],
    data = [
        "//bindings:nanochat_shared",
        "//src/parquet:testdata/text.parquet",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the client entry point re-enters `tools/nanochat client`
# (docs/client-runtime-design.md section 14). Hermetic: a recording tool, so it
# needs no library, no Bazel, and no GPU.
py_test(
    name = "run_test",
    srcs = ["tests/run_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":core_test",
        ":build_test",
        ":api_test",
        ":data_test",
        ":checkpoint_test",
        ":eval_fixture_test",
        ":plan_test",
        ":chat_test",
        ":sft_data_test",
        ":toolchain_test",
        ":prune_test",
        ":contract_test",
        ":gpu_queue_test",
        ":distributed_test",
        ":rl_test",
        ":mesh_test",
        ":runtime_test",
        ":run_test",
    ],
)
