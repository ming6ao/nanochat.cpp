# T0: the orchestration layer argv. Hermetic: no library, no Bazel, no GPU.
py_test(
    name = "toolchain_test",
    srcs = ["tests/toolchain_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T0: the Bazel output-base reaper, moved out of shell. Hermetic: a synthetic
