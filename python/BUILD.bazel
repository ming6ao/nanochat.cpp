test_suite(
    name = "all",
    tests = [
        ":core_test",
        ":build_test",
        ":api_test",
        ":data_test",
        ":checkpoint_test",
        ":eval_fixture_test",
        ":plan_test",
        ":chat_test",
        ":sft_data_test",
        ":sft_data_parity_test",
        ":toolchain_test",
        ":prune_test",
        ":contract_test",
        ":sandbox_test",
        ":lint_test",
        ":cuda_sim_symbols_test",
        ":gpu_queue_test",
        ":distributed_test",
        ":rl_test",
        ":mesh_test",
        ":runtime_test",
        ":run_test",
        ":gate_import_isolation_test",
        ":gate_stdlib_imports_test",
        ":gate_pyproject_test",
        ":gate_provenance_test",
        ":gate_core_independence_test",
        ":parity_dispatch_test",
    ],
)
