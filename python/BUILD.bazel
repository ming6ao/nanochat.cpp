py_test(
    name = "rl_test",
    srcs = ["tests/rl_test.py"],
    deps = [":nanochat_cpp"],
    size = "small",
)

# T1: the CUDA flavor of the fixture-parity test. The same source and data as
# `api_test`, but linked against the CUDA library under `--config=cuda`.
py_test(
    name = "api_gpu_test",
    srcs = ["tests/api_test.py"],
    main = "tests/api_test.py",
    data = [
        "//bindings:nanochat_shared",
        "//src/parquet:testdata/text.parquet",
        "//tests:api_fixture",
        "//tests:data/loader_tokenizer.nctoken",
    ],
    deps = [":nanochat_cpp"],
    size = "small",
    tags = ["gpu", "manual"],
)

