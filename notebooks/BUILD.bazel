# notebooks/ — the Kaggle notebook and the single-client mesh training loop.
#
# A notebook is a host (``docs/build.md``, the Python distribution), so
# its modules import either package of the distribution. The heavy imports stay
# inside the calls of `nanochat_cpp_bridge`: the modules here import the
# standard library and the two packages, and the tests therefore run on the
# registered local `python3` toolchain with no third-party wheel.

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "args",
    srcs = ["args.py"],
    imports = ["."],
    deps = ["//python:nanochat_cpp"],
)

py_library(
    name = "kaggle_setup",
    srcs = ["kaggle_setup.py"],
    imports = ["."],
    deps = ["//python:nanochat_cpp"],
)

# The Colab half of the session setup: the source-tree path of D8 and the
# second call that builds both stage executables. It forwards to
# `kaggle_setup`, so the two hosts share one setup implementation.
py_library(
    name = "colab_setup",
    srcs = ["colab_setup.py"],
    imports = ["."],
    deps = [
        ":kaggle_setup",
        "//python:nanochat_cpp",
    ],
)

py_library(
    name = "target",
    srcs = ["target.py"],
    imports = ["."],
)

py_library(
    name = "session",
    srcs = ["session.py"],
    imports = ["."],
    deps = [
        ":kaggle_setup",
        ":target",
        "//python:nanochat_cpp",
    ],
)

py_library(
    name = "hub_checkpoint",
    srcs = ["hub_checkpoint.py"],
    imports = ["."],
    deps = [
        ":args",
        # The Hub save and load calls have one home in the adapter package
        # (the adapter package). This library forwards to it; `huggingface_hub`
        # is imported
        # inside those calls, so the test needs no wheel and no network.
        "//python:nanochat_cpp_bridge",
        "//python:nanochat_cpp",
    ],
)

py_library(
    name = "mesh_train",
    srcs = ["mesh_train.py"],
    imports = ["."],
    deps = [
        ":target",
        "//python:nanochat_cpp",
    ],
)

py_library(
    name = "mesh_worker",
    srcs = ["mesh_worker.py"],
    imports = ["."],
    deps = [":mesh_train"],
)

py_library(
    name = "pi_agent",
    srcs = ["pi_agent.py"],
    imports = ["."],
)

py_test(
    name = "args_test",
    srcs = ["args_test.py"],
    size = "small",
    deps = [
        ":args",
    ],
)

py_test(
    name = "kaggle_setup_test",
    srcs = ["kaggle_setup_test.py"],
    size = "small",
    deps = [
        ":kaggle_setup",
        "//python:nanochat_cpp",
    ],
)

# The Colab half: the two calls, and the Bazel cache directory each one passes
# (docs/build.md, the Python distribution). The test patches the clone and the build, so it
# needs no network and no card.
py_test(
    name = "colab_setup_test",
    srcs = ["colab_setup_test.py"],
    size = "small",
    deps = [
        ":colab_setup",
        ":kaggle_setup",
        "//python:nanochat_cpp",
    ],
)

py_test(
    name = "session_test",
    srcs = ["session_test.py"],
    size = "small",
    deps = [":session"],
)

py_test(
    name = "target_test",
    srcs = ["target_test.py"],
    size = "small",
    deps = [
        ":mesh_train",
        ":target",
    ],
)

py_test(
    name = "hub_checkpoint_test",
    srcs = ["hub_checkpoint_test.py"],
    size = "small",
    deps = [":hub_checkpoint"],
)

py_test(
    name = "mesh_train_test",
    srcs = ["mesh_train_test.py"],
    size = "small",
    data = ["//bindings:nanochat_shared"],
    deps = [
        ":mesh_train",
        ":mesh_worker",
        ":target",
    ],
)

py_test(
    name = "pi_agent_test",
    srcs = ["pi_agent_test.py"],
    size = "small",
    deps = [":pi_agent"],
)

test_suite(
    name = "all",
    tests = [
        ":args_test",
        ":hub_checkpoint_test",
        ":kaggle_setup_test",
        ":mesh_train_test",
        ":pi_agent_test",
        ":session_test",
        ":target_test",
    ],
)
