# notebooks/ — the Kaggle notebook and the single-client mesh training loop.
#
# The pure modules import only the Python standard library, so the tests run on
# the registered local `python3` toolchain and need no third-party wheel.

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "args",
    srcs = ["args.py"],
    imports = ["."],
    deps = ["//python:nanochat_cpp"],
)

py_library(
    name = "kaggle_setup",
    srcs = ["kaggle_setup.py"],
    imports = ["."],
    deps = ["//python:nanochat_cpp"],
)

py_library(
    name = "session",
    srcs = ["session.py"],
    imports = ["."],
    deps = [
        ":kaggle_setup",
        "//python:nanochat_cpp",
    ],
)

py_library(
    name = "hub_checkpoint",
    srcs = ["hub_checkpoint.py"],
    imports = ["."],
    deps = [
        ":args",
        "//python:nanochat_cpp",
    ],
)

py_library(
    name = "mesh_train",
    srcs = ["mesh_train.py"],
    imports = ["."],
    deps = ["//python:nanochat_cpp"],
)

py_library(
    name = "mesh_worker",
    srcs = ["mesh_worker.py"],
    imports = ["."],
    deps = [":mesh_train"],
)

py_library(
    name = "pi_agent",
    srcs = ["pi_agent.py"],
    imports = ["."],
)

py_test(
    name = "args_test",
    srcs = ["args_test.py"],
    size = "small",
    deps = [
        ":args",
    ],
)

py_test(
    name = "kaggle_setup_test",
    srcs = ["kaggle_setup_test.py"],
    size = "small",
    deps = [":kaggle_setup"],
)

py_test(
    name = "session_test",
    srcs = ["session_test.py"],
    size = "small",
    deps = [":session"],
)

py_test(
    name = "hub_checkpoint_test",
    srcs = ["hub_checkpoint_test.py"],
    size = "small",
    deps = [":hub_checkpoint"],
)

py_test(
    name = "mesh_train_test",
    srcs = ["mesh_train_test.py"],
    size = "small",
    deps = [
        ":mesh_train",
        ":mesh_worker",
    ],
)

py_test(
    name = "pi_agent_test",
    srcs = ["pi_agent_test.py"],
    size = "small",
    deps = [":pi_agent"],
)

test_suite(
    name = "all",
    tests = [
        ":args_test",
        ":hub_checkpoint_test",
        ":kaggle_setup_test",
        ":mesh_train_test",
        ":pi_agent_test",
        ":session_test",
    ],
)
