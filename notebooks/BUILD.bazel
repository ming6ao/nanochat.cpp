# notebooks/ — the Kaggle notebook and its trial runner. See
# docs/notebook-workflow.md.
#
# The runner imports only the Python standard library, so the tests run on the
# registered local `python3` toolchain and need no third-party wheel.

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "kaggle_setup",
    srcs = ["kaggle_setup.py"],
    imports = ["."],
    deps = ["//python:nanochat_cpp"],
)

py_library(
    name = "lab",
    srcs = ["lab.py"],
    imports = ["."],
    deps = ["//python:nanochat_cpp"],
)

py_library(
    name = "parallel",
    srcs = ["parallel.py"],
    imports = ["."],
)

py_library(
    name = "pi_agent",
    srcs = ["pi_agent.py"],
    imports = ["."],
)

py_test(
    name = "kaggle_setup_test",
    srcs = ["kaggle_setup_test.py"],
    size = "small",
    deps = [":kaggle_setup"],
)

py_test(
    name = "lab_test",
    srcs = ["lab_test.py"],
    size = "small",
    deps = [":lab"],
)

py_test(
    name = "parallel_test",
    srcs = ["parallel_test.py"],
    size = "small",
    deps = [":parallel"],
)

py_test(
    name = "pi_agent_test",
    srcs = ["pi_agent_test.py"],
    size = "small",
    deps = [":pi_agent"],
)

test_suite(
    name = "all",
    tests = [
        ":kaggle_setup_test",
        ":lab_test",
        ":parallel_test",
        ":pi_agent_test",
    ],
)
