# Standalone micro-benchmark; run it through the broker, not the test loop.
cc_binary(
    name = "row_bench",
    srcs = ["row_bench.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_test_utils",
        "//backends/cuda/kernels:row_kernels",
        "//include/nanochat:nanochat",
    ],
)

# QkPrep decomposition vs fusion micro-benchmark.
cc_binary(
    name = "qk_prep_bench",
    srcs = ["qk_prep_bench.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":qk_prep_fused",
        ":row_test_utils",
        "//backends/cuda/kernels:row_kernels",
        "//include/nanochat:nanochat",
    ],
)

# Batch-1 decode baseline: eager seam vs cuBLAS + CUDA Graphs. The host file
# uses the CUDA runtime and cuBLAS directly, so it is compiled as a cuda_binary.
cuda_binary(
    name = "decode_fused_bench",
    srcs = [
        "decode_fused_bench.cc",
        "decode_kernels.cu",
    ],
    hdrs = ["decode_kernels.h"],
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        ":row_test_utils",
        "//backends/cuda:all_kernels",
        "//backends/cuda/kernels:device_utils",
        "//include/nanochat:nanochat",
        "@cuda//:cublas",
    ],
)

# Attention-family benchmark: device-event timing of the shipped forward and
# backward at the d8_s512 training shape plus a head-dimension sweep that
# exposes the per-owned-dimension redundancy in OnlineSoftmaxTile. A benchmark,
# not a test: run it through the broker with `tools/nanochat profile`.
cuda_binary(
    name = "attention_bench",
    srcs = ["attention_bench.cc"],
    hdrs = ["bench_utils.h"],
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        ":sequence_test_utils",
        "//backends/cuda/kernels:sequence_kernels",
        "//include/nanochat:nanochat",
    ],
)

# Attention-tile-v3 prototype: the Pascal-native tiled attention experiment.
# The forward tile is implemented here; the backward tile and the correctness
# sweep land in later waves. dev-only; the CUDA backend is unchanged.
cuda_library(
    name = "attention_tile_v3",
    srcs = ["attention_tile_v3.cu"],
    hdrs = ["attention_tile_v3.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda:device",
        "//backends/cuda/kernels:device_utils",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# T1 GPU correctness test for the prototype: compares the device tiled forward
# against sequence_ref.h at tiny and shallow multi-tile shapes, and enters the
# backward stub. Not tagged `manual` so that `tools/nanochat test --gpu //...`
# discovers it.
cc_test(
    name = "attention_tile_v3_gpu_test",
    srcs = ["attention_tile_v3_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":attention_tile_v3",
        ":sequence_test_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# Prototype micro-benchmark; run it through the broker, not the test loop.
cuda_binary(
    name = "attention_tile_v3_bench",
    srcs = ["attention_tile_v3_bench.cc"],
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        ":attention_tile_v3",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":adamw_gpu_test",
        ":attention_gpu_test",
        ":attention_tile_v3_gpu_test",
        ":build_config_test",
        ":classifier_gpu_test",
        ":embedding_gpu_test",
        ":global_norm_gpu_test",
        ":muon_gpu_test",
        ":pascal_spike_gpu_test",
        ":pointwise_gpu_test",
        ":qk_prep_fused_gpu_test",
        ":qk_prep_gpu_test",
        ":rms_norm_gpu_test",
        ":sequence_oracle_gpu_test",
    ],
)
