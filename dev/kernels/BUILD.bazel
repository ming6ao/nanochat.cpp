# Phase 0's sync term: the launch gap of a dependent kernel against the cost of
# a cooperative grid barrier on this card. The barrier needs device code, so the
# whole probe is one CUDA translation unit.
cuda_binary(
    name = "muon_launch_sync_bench",
    srcs = ["muon_launch_sync_bench.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":muon_fused_gemm",
        "//backends/cuda:device",
        "//backends/cuda/kernels/testing:bench_utils",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
