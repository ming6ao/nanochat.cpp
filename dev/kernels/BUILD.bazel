# dev/kernels — standalone prototypes and the P0 CUDA/Pascal toolchain spike.
#
# The per-family correctness tests and the micro-benchmarks now live next to
# the kernels they cover, in backends/cuda/kernels/. This package holds only
# work that is not promoted: the combined QkPrep fusion prototype, the
# decode-path CUDA-graph baseline, the toolchain spike, and one CPU build smoke
# test.
#
# See dev/kernels/README.md and docs/testing.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_binary",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# One kernel, compiled for the default sm_61 (and sm_75 via --config=sm_75).
cuda_library(
    name = "pascal_spike",
    srcs = ["pascal_spike.cu"],
    hdrs = ["pascal_spike.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    alwayslink = True,
)

# gpu + small: a gate, not an iteration tool. Not tagged `manual` so that
# `tools/nanochat test --gpu //...` discovers it; the CPU loop excludes it with
# `--test_tag_filters=-gpu`.
cc_test(
    name = "pascal_spike_gpu_test",
    srcs = ["pascal_spike_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":pascal_spike",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# CPU smoke test: keeps the default (non-GPU) test loop non-empty and checks
# that the precision config and the sandbox guard are wired.
cc_test(
    name = "build_config_test",
    srcs = ["build_config_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
    size = "small",
)

# QkPrep fusion prototype (RMSNorm + RoPE + scale on q and k): the combined
# fused kernel and the explicit decomposed baseline used by the benchmark.
# Unpromoted; the CUDA backend is unchanged.
cuda_library(
    name = "qk_prep_fused",
    srcs = ["qk_prep_fused.cu"],
    hdrs = ["qk_prep_fused.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda:device",
        "//backends/cuda/kernels:device_utils",
        "//backends/cuda/kernels:rms_norm",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Capture-safe local decode kernels for the cuBLAS + CUDA Graphs baseline.
cuda_library(
    name = "decode_kernels",
    srcs = ["decode_kernels.cu"],
    hdrs = ["decode_kernels.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda/kernels:device_utils",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Prototype correctness test for the combined QkPrep fusion.
cc_test(
    name = "qk_prep_fused_gpu_test",
    srcs = ["qk_prep_fused_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":qk_prep_fused",
        "//backends/cuda/kernels:row_kernels",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# QkPrep decomposition vs fusion micro-benchmark.
cc_binary(
    name = "qk_prep_bench",
    srcs = ["qk_prep_bench.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":qk_prep_fused",
        "//backends/cuda/kernels:row_kernels",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
)

# CPU GEMM micro-benchmark: the reference backend's C = A * B over a few
# shapes. CPU-only, so it runs under the `t0-cpu` profile.
#
# `-fopenmp` in `copts` defines `_OPENMP` in the benchmark translation unit, so
# `ActiveThreadCount()` reports the real OpenMP pool instead of the scalar
# fallback. The linked `//backends/cpu:cpu` library already carries OpenMP, so
# the flag changes only the reported thread count, not the GEMM math.
cc_binary(
    name = "cpu_gemm_bench",
    srcs = ["cpu_gemm_bench.cc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    defines = precision_defines(),
    deps = [
        "//backends/cpu:cpu",
        "//include/nanochat:nanochat",
    ],
)

# CPU operand-layout probe. The model's `ops::LinearForward` uses
# `transpose_b = true` (weights `[out, in]`), but the original Phase 1
# benchmark timed only `transpose_b = false`. This probe times the same logical
# shapes under both layouts and confirms that the model-layout fix makes them
# agree. See docs/cpu-performance.md.
cc_binary(
    name = "cpu_linear_layout_probe",
    srcs = ["cpu_linear_layout_probe.cc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    defines = precision_defines(),
    deps = [
        "//backends/cpu:cpu",
        "//include/nanochat:nanochat",
    ],
)

# Batch-1 decode baseline: eager seam vs cuBLAS + CUDA Graphs. The host file
# uses the CUDA runtime and cuBLAS directly, so it is compiled as a cuda_binary.
cuda_binary(
    name = "decode_fused_bench",
    srcs = [
        "decode_fused_bench.cc",
        "decode_kernels.cu",
    ],
    hdrs = ["decode_kernels.h"],
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        "//backends/cuda:all_kernels",
        "//backends/cuda/kernels:device_utils",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
        "@cuda//:cublas",
    ],
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":build_config_test",
        ":pascal_spike_gpu_test",
        ":qk_prep_fused_gpu_test",
    ],
)
