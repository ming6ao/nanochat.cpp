# dev/kernels — standalone prototypes.
#
# The per-family correctness tests and the micro-benchmarks now live next to
# the kernels they cover, in backends/cuda/kernels/. This package holds only
# work that is not promoted: the combined QkPrep fusion prototype, the
# decode-path CUDA-graph baseline, and one CPU build smoke test.
#
# See dev/kernels/README.md and docs/testing.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_binary",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# CPU smoke test: keeps the default (non-GPU) test loop non-empty and checks
# that the precision config and the sandbox guard are wired.
cc_test(
    name = "build_config_test",
    srcs = ["build_config_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
    size = "small",
)

# QkPrep fusion prototype (RMSNorm + RoPE + scale on q and k): the combined
# fused kernel and the explicit decomposed baseline used by the benchmark.
# Unpromoted; the CUDA backend is unchanged.
cuda_library(
    name = "qk_prep_fused",
    srcs = ["qk_prep_fused.cu"],
    hdrs = ["qk_prep_fused.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda:device",
        "//backends/cuda/kernels:device_utils",
        "//backends/cuda/kernels:rms_norm",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Capture-safe local decode kernels for the cuBLAS + CUDA Graphs baseline.
cuda_library(
    name = "decode_kernels",
    srcs = ["decode_kernels.cu"],
    hdrs = ["decode_kernels.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda/kernels:device_utils",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Prototype correctness test for the combined QkPrep fusion.
cc_test(
    name = "qk_prep_fused_gpu_test",
    srcs = ["qk_prep_fused_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":qk_prep_fused",
        "//backends/cuda/kernels:row_kernels",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# QkPrep decomposition vs fusion micro-benchmark.
cc_binary(
    name = "qk_prep_bench",
    srcs = ["qk_prep_bench.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":qk_prep_fused",
        "//backends/cuda/kernels:row_kernels",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
)

# CPU GEMM micro-benchmark: the reference backend's C = A * B over a few
# shapes. CPU-only, so it runs under the `t0-cpu` profile.
#
# `-fopenmp` in `copts` and `linkopts` gives `ActiveThreadCount()` the real
# OpenMP pool, rather than a scalar fallback. The linked `//backends/cpu:cpu`
# library already carries OpenMP, so the flag changes only the reported thread
# count, not the GEMM math.
cc_binary(
    name = "cpu_gemm_bench",
    srcs = ["cpu_gemm_bench.cc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    defines = precision_defines(),
    deps = [
        "//backends/cpu:cpu",
        "//include/nanochat:nanochat",
    ],
)

# CPU operand-layout probe. The model's `ops::LinearForward` uses
# `transpose_b = true` (weights `[out, in]`), but the original Phase 1
# benchmark timed only `transpose_b = false`. This probe times the same logical
# shapes under both layouts and confirms that the model-layout fix makes them
# agree. See docs/performance.md.
cc_binary(
    name = "cpu_linear_layout_probe",
    srcs = ["cpu_linear_layout_probe.cc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    defines = precision_defines(),
    deps = [
        "//backends/cpu:cpu",
        "//include/nanochat:nanochat",
    ],
)

# Batch-1 decode baseline: eager seam vs cuBLAS + CUDA Graphs. The host file
# uses the CUDA runtime and cuBLAS directly, so it is compiled as a cuda_binary.
cuda_binary(
    name = "decode_fused_bench",
    srcs = [
        "decode_fused_bench.cc",
        "decode_kernels.cu",
    ],
    hdrs = ["decode_kernels.h"],
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        "//backends/cuda:all_kernels",
        "//backends/cuda/kernels:device_utils",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
        "@cuda//:cublas",
    ],
)

# Muon fusion prototype (Phase 1): the device-side batched fp32 GEMM of the
# Polar Express iteration, in the section 4 schedule. Unpromoted and dev-only:
# `backends/cuda` does not depend on this directory.
cuda_library(
    name = "muon_fused_gemm",
    srcs = ["muon_fused_gemm.cu"],
    hdrs = [
        "muon_fused_gemm.cuh",
        "muon_fused_gemm.h",
    ],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# gpu: the five operand forms against the seam GEMM, which is the cuBLAS call
# `MuonUpdate` issues for the same product.
#
# The prototype takes fp32 operands, so the build selects its source and not a
# preprocessor guard: a bf16 build compiles the stand-in `main`, because the
# body names `float` buffers where the seam takes `ComputeType`.
cc_test(
    name = "muon_fused_gemm_gpu_test",
    srcs = select({
        "//:fp32": ["muon_fused_gemm_test.cc"],
        "//conditions:default": ["muon_fused_gemm_absent.cc"],
    }),
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":muon_fused_gemm",
        "//backends/cuda:all_kernels",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# Hand GEMM versus cuBLAS on the groups the fusion targets, with the gate share
# of section 4. Run it through the broker. It takes the same fp32 stand-in as the
# prototype test above.
cuda_binary(
    name = "muon_fused_gemm_bench",
    srcs = select({
        "//:fp32": ["muon_fused_gemm_bench.cc"],
        "//conditions:default": ["muon_fused_gemm_absent.cc"],
    }),
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        ":muon_fused_gemm",
        "//backends/cuda:all_kernels",
        "//backends/cuda/kernels/testing:bench_utils",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
)

# Phase 0's sync term: the launch gap of a dependent kernel against the cost of
# a cooperative grid barrier on this card. The barrier needs device code, so the
# whole probe is one CUDA translation unit.
cuda_binary(
    name = "muon_launch_sync_bench",
    srcs = ["muon_launch_sync_bench.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":muon_fused_gemm",
        "//backends/cuda:device",
        "//backends/cuda/kernels/testing:bench_utils",
        "//backends/cuda/kernels/testing:row_test_utils",
        "//include/nanochat:nanochat",
    ],
)

# Phase 0 of docs/kernels.md Part 3: the WGMMA ceiling probe. It holds one hand
# built shared descriptor, one interleaved staging pass, and one
# `wgmma.mma_async.m64n128k16` instruction, and it reports the rate of a
# warpgroup on a resident tile against the card's bf16 peak. The result is
# checked against a host reference first, so a wrong descriptor fails instead of
# measuring.
#
# WGMMA is architecture conditional, so this target needs `sm_90a` on the
# compile line and the tree's device configurations emit `sm_90`. Build and run
# it by hand, and only on a Hopper card:
#
#   tools/nanochat build //dev/kernels:wgmma_probe \
#       --@rules_cuda//cuda:archs=sm_90a
#
# The emulation engine maps no WGMMA, so there is no off-device leg and the
# target carries `manual`. docs/kernels.md Part 3 section 9 is the risk record.
cuda_binary(
    name = "wgmma_probe",
    srcs = ["wgmma_probe.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    tags = [
        "gpu",
        "manual",
    ],
    deps = ["//include/nanochat:nanochat"],
)

# Phase H1 of docs/attention.md Part 8: the copy path of the Hopper tile.
#
# The ceiling probe above measures the instruction from a resident tile. A real
# attention tile reads a new key tile every step, so this probe measures the
# same product from a resident tile and from a tile that the copy engine stages
# into a three-stage window, and reports both against the declared peak of
# `backends/cuda/caps.json`. Part 8 section 6 is the gate that reads the two.
#
# **The target states its own architecture.** WGMMA is architecture
# conditional, and `rules_cuda` lets one target name `archs` for itself, so the
# value below replaces the command line for this target alone: no `.bazelrc`
# line moves and the default build stays at the tree's own architecture
# (docs/build.md, and the CUTLASS candidates of backends/cuda/gemm/BUILD.bazel
# are the precedent). The tripwire in the source refuses a build that names any
# other architecture.
#
# The emulation engine maps neither WGMMA nor a tensor copy, so there is no
# off-device leg and the target carries `manual`. Its gate is the H100 leg:
#
#   modal run tools/modal/app.py::card_job --name attention_wgmma
cuda_binary(
    name = "attention_wgmma_probe",
    srcs = ["attention_wgmma_probe.cu"],
    archs = ["sm_90a"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    tags = [
        "gpu",
        "manual",
    ],
    deps = ["//include/nanochat:nanochat"],
)
# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":build_config_test",
        ":muon_fused_gemm_gpu_test",
        ":qk_prep_fused_gpu_test",
    ],
)
