# dev/kernels — standalone per-kernel tests and benchmarks, llm.c dev/cuda
# style. This package holds the P0 CUDA/Pascal toolchain spike plus the
# per-family tests for the row/elementwise kernels (RmsNorm, QkPrep,
# Pointwise, GlobalNorm). See dev/kernels/README.md and docs/testing.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_binary",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# One kernel, compiled for the default sm_61 (and sm_75 via --config=sm_75).
cuda_library(
    name = "pascal_spike",
    srcs = ["pascal_spike.cu"],
    hdrs = ["pascal_spike.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    alwayslink = True,
)

# gpu + small: a gate, not an iteration tool. Not tagged `manual` so that
# `tools/nanochat test --gpu //...` discovers it; the CPU loop excludes it with
# `--test_tag_filters=-gpu`.
cc_test(
    name = "pascal_spike_gpu_test",
    srcs = ["pascal_spike_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":pascal_spike",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# CPU smoke test: keeps the default (non-GPU) test loop non-empty and checks
# that the precision config and the sandbox guard are wired.
cc_test(
    name = "build_config_test",
    srcs = ["build_config_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
    size = "small",
)

# Host-only scaffolding shared by the row/elementwise GPU tests: the reference
# port of backends/cpu/kernels.cc plus the device-buffer and finite-difference
# helpers.
cc_library(
    name = "row_test_utils",
    hdrs = [
        "gpu_test_utils.h",
        "row_ref.h",
    ],
    deps = ["//include/nanochat:nanochat"],
)

# Host-only scaffolding shared by the sequence GPU tests: the reference port of
# the Attention/Classifier/Embedding kernels plus the same device-buffer and
# finite-difference helpers.
cc_library(
    name = "sequence_test_utils",
    hdrs = [
        "gpu_test_utils.h",
        "sequence_ref.h",
    ],
    deps = ["//include/nanochat:nanochat"],
)

# Host-only scaffolding shared by the optimizer GPU tests: the reference port
# of AdamW and Muon plus the same device-buffer helpers.
cc_library(
    name = "optim_test_utils",
    hdrs = [
        "gpu_test_utils.h",
        "optim_ref.h",
    ],
    deps = ["//include/nanochat:nanochat"],
)

# QkPrep fusion prototype (RMSNorm + RoPE + scale on q and k): the combined
# fused kernel and the explicit decomposed baseline used by the benchmark.
# dev-only; the CUDA backend is unchanged.
cuda_library(
    name = "qk_prep_fused",
    srcs = ["qk_prep_fused.cu"],
    hdrs = ["qk_prep_fused.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda:device",
        "//backends/cuda/kernels:device_utils",
        "//backends/cuda/kernels:rms_norm",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Capture-safe local decode kernels for the cuBLAS + CUDA Graphs baseline.
cuda_library(
    name = "decode_kernels",
    srcs = ["decode_kernels.cu"],
    hdrs = ["decode_kernels.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda/kernels:device_utils",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# T1 GPU correctness + finite-difference tests, one per row/elementwise family.
cc_test(
