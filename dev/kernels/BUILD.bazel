# dev/kernels — standalone per-kernel tests and benchmarks, llm.c dev/cuda
# style. This package holds the P0 CUDA/Pascal toolchain spike plus the
# per-family tests for the row/elementwise kernels (RmsNorm, QkPrep,
# Pointwise, GlobalNorm). See dev/kernels/README.md and docs/testing.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# One kernel, compiled for the default sm_61 (and sm_75 via --config=sm_75).
cuda_library(
    name = "pascal_spike",
    srcs = ["pascal_spike.cu"],
    hdrs = ["pascal_spike.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    alwayslink = True,
)

# gpu + small: a gate, not an iteration tool. Not tagged `manual` so that
# `tools/nanochat test --gpu //...` discovers it; the CPU loop excludes it with
# `--test_tag_filters=-gpu`.
cc_test(
    name = "pascal_spike_gpu_test",
    srcs = ["pascal_spike_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":pascal_spike",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# CPU smoke test: keeps the default (non-GPU) test loop non-empty and checks
# that the precision config and the sandbox guard are wired.
cc_test(
    name = "build_config_test",
    srcs = ["build_config_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
    size = "small",
)

# Host-only scaffolding shared by the row/elementwise GPU tests: the reference
# port of backends/cpu/kernels.cc plus the device-buffer and finite-difference
# helpers.
cc_library(
    name = "row_test_utils",
    hdrs = [
        "gpu_test_utils.h",
        "row_ref.h",
    ],
    deps = ["//include/nanochat:nanochat"],
)

# T1 GPU correctness + finite-difference tests, one per row/elementwise family.
cc_test(
    name = "rms_norm_gpu_test",
    srcs = ["rms_norm_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_test_utils",
        "//backends/cuda/kernels:rms_norm",
        "//backends/cuda/kernels:row_kernels",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

cc_test(
    name = "qk_prep_gpu_test",
    srcs = ["qk_prep_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_test_utils",
        "//backends/cuda/kernels:row_kernels",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

cc_test(
    name = "pointwise_gpu_test",
    srcs = ["pointwise_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_test_utils",
        "//backends/cuda/kernels:row_kernels",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

cc_test(
    name = "global_norm_gpu_test",
    srcs = ["global_norm_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_test_utils",
        "//backends/cuda/kernels:row_kernels",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# Standalone micro-benchmark; run it through the broker, not the test loop.
cc_binary(
    name = "row_bench",
    srcs = ["row_bench.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_test_utils",
        "//backends/cuda/kernels:row_kernels",
        "//include/nanochat:nanochat",
    ],
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":build_config_test",
        ":global_norm_gpu_test",
        ":pascal_spike_gpu_test",
        ":pointwise_gpu_test",
        ":qk_prep_gpu_test",
        ":rms_norm_gpu_test",
    ],
)
