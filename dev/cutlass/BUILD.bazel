# dev/cutlass/ -- the CUTLASS bring-up probe (docs/kernels.md Part 3 section 5).
#
# The probe answers three questions and measures no rate:
#
#   1. does the vendored header tree compile here, at CUDA 12.0 and C++20?
#   2. does a target that states `archs = ["sm_90a"]` build beside the tree's
#      command-line `sm_75`, so the default build needs no Hopper flag?
#   3. which tile candidates fit the Hopper window, and what stage count does
#      the collective builder choose for each?
#
# Question 2 is why the device half and the binary are separate: the device
# half states the architecture on itself, and the binary keeps the command
# line's. A build of both is the proof.
#
# **One compiler action per entry.** Every row of the report is a Hopper kernel
# body. One body costs 42 s and 3.0 GiB here, and `-O0`, `-O1`, and `-O2` cost
# the same, so the price is template instantiation and PTX generation. Twelve
# bodies in one translation unit was one action of about nine minutes, and it
# stalled: the compiler waited on memory and used 20 percent of a processor.
# The split gives one action per entry, so the peak is one body and each
# finished entry stays cached. `//backends/cuda/gemm` builds its candidates the
# same way. See `README.md` section 7 and the log in docs/build.md.
#
# **Build it by label with one action.** Each entry holds 3.0 GiB and the
# session's build ceiling is 5 GiB, so two at once stall (measured: 3.8 GiB and
# 30 percent of a processor each). Every target here is `manual`, so a `//...`
# wildcard skips the probe and cannot schedule twelve heavy actions:
#
#   tools/nanochat build --jobs=1 //dev/cutlass:cutlass_probe
#
# **The vendor options are this directory's own, not `nanochat_cuda_copts`.**
# The CUTLASS headers emit thousands of warnings, and every build turns a
# warning into an error. `third_party/cutlass.bzl` states `includes = ["include"]`,
# which is `-isystem` here, so the header warnings do not reach this warning
# policy either.

load("//:nanochat.bzl", "cuda_binary", "cuda_library")

package(default_visibility = ["//visibility:public"])

# The architecture the WGMMA atom and the Tensor Memory Accelerator need. No
# `.bazelrc` line and no command-line flag carries it.
CUDA_HOPPER_ARCHS = ["sm_90a"]

# Keeps the probe out of a `//...` wildcard. See the header.
PROBE_TAGS = ["manual"]

# The flags the object under `cuobjdump` was built with, which keeps the
# instruction counts of `README.md` section 2 reproducible.
_PROBE_COPTS = [
    "-O2",
    "-Xcompiler",
    "-O2",
]

# The entries to compile, one kernel body each: the five tiles, the four
# bf16-store cases, and the three fp32-store cases that are not the tile. The
# report has thirteen rows and two share a type, so there are twelve entries,
# and `kEntryOfRow` in `cutlass_probe.cu` maps each row to its entry.
# `NANOCHAT_FOR_EACH_PROBE_ENTRY` in `cutlass_probe_rows.h` declares the same
# indexes.
_PROBE_ENTRIES = [str(index) for index in range(12)]

# The report: the two row tables, the row-to-entry map, and the window test. It
# names every row's type and emits no kernel body, so it is the cheap action.
cuda_library(
    name = "cutlass_probe_rows",
    srcs = ["cutlass_probe.cu"],
    hdrs = [
        "cutlass_probe.h",
        "cutlass_probe_rows.h",
        "cutlass_probe_types.h",
    ],
    archs = CUDA_HOPPER_ARCHS,
    copts = _PROBE_COPTS,
    tags = PROBE_TAGS,
    deps = ["@cutlass//:cutlass"],
)

# One entry's kernel body, in one action. The source is the same for all twelve
# targets, and `NANOCHAT_PROBE_ENTRY` selects the entry, as
# `backends/cuda/gemm` selects a candidate with `NANOCHAT_CANDIDATE_INDEX`.
[
    cuda_library(
        name = "cutlass_probe_entry_" + entry,
        srcs = ["cutlass_probe_entry.cu"],
        hdrs = [
            "cutlass_probe_rows.h",
            "cutlass_probe_types.h",
        ],
        archs = CUDA_HOPPER_ARCHS,
        copts = _PROBE_COPTS,
        local_defines = ["NANOCHAT_PROBE_ENTRY=" + entry],
        tags = PROBE_TAGS,
        deps = ["@cutlass//:cutlass"],
        alwayslink = True,
    )
    for entry in _PROBE_ENTRIES
]

# The device half, as the binary links it: the report and the twelve bodies.
# This is the target `docs/kernels.md` Part 3 names, and it states `sm_90a` on
# itself.
cuda_library(
    name = "cutlass_probe_lib",
    deps = [":cutlass_probe_rows"] + [
        ":cutlass_probe_entry_" + entry
        for entry in _PROBE_ENTRIES
    ],
    archs = CUDA_HOPPER_ARCHS,
    tags = PROBE_TAGS,
)

# The host report, at the command line's architecture, which is the point.
cuda_binary(
    name = "cutlass_probe",
    srcs = ["cutlass_probe_main.cu"],
    hdrs = ["cutlass_probe.h"],
    copts = _PROBE_COPTS,
    tags = PROBE_TAGS,
    deps = [
        ":cutlass_probe_lib",
        "//include/nanochat:nanochat",
    ],
)
