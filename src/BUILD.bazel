# a requested position and token-id set. CPU only; the fixture accessors stage
# through the kernel seam so the same source could build against CUDA.
cc_test(
    name = "eval_test",
    srcs = ["eval_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Grad mode (docs/eval.md): the forward-only path reproduces the training
