# src/ — backend-agnostic workflow, model, optimizer, harness, CLI. Targets
# land here in P0 (model skeleton) and P2 (workflow, optimizer, harness). See
# docs/build.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# The backend-agnostic workflow: runtime tensor plumbing (`tensor.cc`,
# `workspace.h`), the reusable graph pieces (`ops.cc`), the fixed train graph
# (`model.cc`), the two inference graphs (`generate.cc`), and the harness
# (`data.cc`, `eval.cc`, `train.cc`). It is a kernel-sequence graph, not an
# autograd engine (DESIGN.md section 6).
cc_library(
    name = "model",
    srcs = [
        "data.cc",
        "eval.cc",
        "generate.cc",
        "model.cc",
        "ops.cc",
        "optim.cc",
        "tensor.cc",
        "train.cc",
    ],
    hdrs = [
        "cli.h",
        "eval.h",
        "model_impl.h",
        "ops.h",
        "optim_state.h",
        "train.h",
        "workspace.h",
    ],
    copts = nanochat_copts(),
    defines = precision_defines(),
    # Backend selection is a build/link choice (docs/build.md): the same
    # workflow sources link the reference CPU backend by default or the CUDA
    # backend under `--config=cuda`.
    deps = select({
        "//:backend_cuda": ["//backends/cuda:all_kernels"],
        "//:backend_cpu": ["//backends/cpu"],
    }) + [
        # `eval.cc` decodes the generated rows through the tokenizer stream
        # decoder, so the workflow library links the host tokenizer.
        "//src/tokenizer:tokenizer",
        # `train.cc` builds a document-mode loader from the native parquet
        # reader (docs/parquet-native.md), so the workflow links it too.
        "//src/parquet:parquet",
        "//include/nanochat:nanochat",
    ],
)

# Model oracle parity: loads the committed CPU fixture and compares the model's
# forward logits, loss, and every parameter gradient. See docs/testing.md.
cc_test(
    name = "model_oracle_test",
    srcs = ["model_oracle_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["//tests:data/debug_state.bin"],
    args = ["$(rootpath //tests:data/debug_state.bin)"],
    deps = [
        ":model",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
)

# CUDA flavor of the oracle-parity test: same source and fixture, but linked
# against the CUDA backend under `--config=cuda` (which `tools/nanochat test
# --gpu` selects). The `gpu` tag keeps it out of the default CPU test loop;
# `//src:model_oracle_test` above remains the CPU proof.
cc_test(
    name = "model_oracle_gpu_test",
    srcs = ["model_oracle_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["//tests:data/debug_state.bin"],
    args = ["$(rootpath //tests:data/debug_state.bin)"],
    deps = [
        ":model",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
    tags = ["gpu"],
)

# Supplementary finite-difference check: the fixture zero-initializes the two
# projections, and zero-initializes `smear_lambda`, so the oracle test cannot
# exercise the attention/QkPrep/MLP backward or the smear input gradient. This
# test makes them nonzero and checks the analytic gradient along random
# directions over every parameter.
cc_test(
    name = "model_gradient_test",
    srcs = ["model_gradient_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Prefill/decode consistency and batched generation: proves the inference
# graphs agree with the train forward at the same positions, that decode samples
# a valid token, and that `GenerateBatch` (prefill once, clone the cache per
# row, decode in lockstep) matches a naive single-row loop for greedy and
# sampled decoding, including per-row terminal ids and the 1/0 mask.
cc_test(
    name = "generate_test",
    srcs = ["generate_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# CUDA flavor of the prefill/decode consistency test: same source, but linked
# against the CUDA backend under `--config=cuda` (which `tools/nanochat test
# --gpu` selects). This covers the inference-only wiring that the train-graph
# oracle does not touch: the KV-cache append, the cache-offset attention, the
# rotary-table offset, and the decode prev-embedding smear. The `gpu` tag keeps
# it out of the default CPU test loop; `//src:generate_test` above remains the
# CPU proof.
cc_test(
    name = "generate_gpu_test",
    srcs = ["generate_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# Optimizer grouping and schedules: the setup_optimizer AdamW/Muon parameter
# groups, the moments, the global gradient clip, and the learning-rate /
# momentum / weight-decay schedules. See docs/model.md.
cc_test(
    name = "optim_test",
    srcs = ["optim_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Data containers: token-shard round-trip, the DataLoader batch shape and
# targets shift, the Checkpoint container, and the LoadTokenizer contract.
cc_test(
    name = "data_test",
    srcs = ["data_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//src/tokenizer:tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# ScoreBatch (docs/eval.md section 3.2): the NLL/argmax shape contract, the
# masking of a row's final position and its padding, agreement with a hand-built
# ForwardLoss over the same shifted targets, and the focused-logit extraction at
# a requested position and token-id set. CPU only; the fixture accessors stage
# through the kernel seam so the same source could build against CUDA.
cc_test(
    name = "eval_test",
    srcs = ["eval_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Grad mode (docs/eval.md): the forward-only path reproduces the training
# forward row for row, the classifier tiling path agrees, and the evaluation
# arena is much smaller than the training arena. CPU only.
cc_test(
    name = "grad_mode_test",
    srcs = ["grad_mode_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# CUDA flavor of the grad-mode test: same source, but linked against the CUDA
# backend under `--config=cuda`. This proves the forward-only path allocates and
# runs against device memory, not only host memory. The `gpu` tag keeps it out
# of the default CPU test loop; `//src:grad_mode_test` above remains the CPU
# proof.
cc_test(
    name = "grad_mode_gpu_test",
    srcs = ["grad_mode_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# Harness: Logger, the mfu.h numbers, the Checkpointer round-trip, and one
# TrainLoop step against a hand-run TrainStep.
cc_test(
    name = "harness_test",
    srcs = ["harness_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//src/tokenizer:tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Masked loss and the weighted backward (docs/post-training.md section 2): the
# forward mean divides by the valid-target count, an ignored target carries a
# zero per-row loss, `BackwardWeighted` shares the valid-count divisor, and a
# row weight of 0 matches an ignored target. CPU only.
cc_test(
    name = "masked_loss_test",
    srcs = ["masked_loss_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Optimizer-state records in NCHKPT01 (docs/post-training.md section 7): a
# save-and-reload test that continues a run, checks the loss curve is
# continuous, compares the AdamW moments and Muon buffers byte for byte, and
# keeps a parameter-only file loadable with zero moments. CPU only.
cc_test(
    name = "optimizer_state_test",
    srcs = ["optimizer_state_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# CLI entry points. Each calls `nanochat::RequireSandboxOrDie` at the top of
# main, so they refuse to run outside `tools/nanochat`. CPU only.
cc_binary(
    name = "train_main",
    srcs = ["train_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//src/parquet:parquet",
        "//include/nanochat:nanochat",
    ],
)

cc_binary(
    name = "eval_main",
    srcs = ["eval_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//src/parquet:parquet",
        "//include/nanochat:nanochat",
    ],
)

# Forward-only evaluation benchmark (docs/eval.md, docs/performance.md). It
# times the grad-mode `ForwardLoss` on random tokens and reports the eval arena
# size, so the C++ column of the eval comparison reproduces on demand. Not a
# test; run it with `tools/nanochat bench`. Built as a plain `cc_binary`, so the
# same source runs the CPU reference backend or the CUDA backend
# (`--config=cuda`).
cc_binary(
    name = "eval_bench",
    srcs = ["eval_bench.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
)

# Stateless scorer over an evaluation fixture: reads a `NANOEVL1` file, runs one
# `ScoreBatch`, and writes the per-position NLL, argmax, and focused logits as a
# result fixture. The wire format is owned by `python/nanochat_cpp/
# eval_fixture.py` (docs/eval.md section 3.2).
cc_binary(
    name = "score_main",
    srcs = ["score_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
)

cc_binary(
    name = "generate_main",
    srcs = ["generate_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//src/tokenizer:tokenizer",
        "//include/nanochat:nanochat",
    ],
)

# The tiny CLI flag helpers shared by the entry points (docs/build.md).
cc_library(
    name = "cli",
    hdrs = ["cli.h"],
    deps = ["//include/nanochat:nanochat"],
)

# Aggregation point consumed by //:all_tests.
test_suite(name = "all", tests = [
    ":model_oracle_test",
    ":model_gradient_test",
    ":generate_test",
    ":eval_test",
    ":grad_mode_test",
    ":optim_test",
    ":data_test",
    ":harness_test",
    ":masked_loss_test",
    ":optimizer_state_test",
    # The tokenizer host package owns its own test suite.
    "//src/tokenizer:all",
])
