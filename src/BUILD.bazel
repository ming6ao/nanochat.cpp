# src/ — backend-agnostic workflow, model, optimizer, harness, CLI. Targets
# land here in P0 (model skeleton) and P2 (workflow, optimizer, harness). See
# docs/build.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# The device capability table the simulator reads (docs/simulator.md section 7).
# It is a leaf: it depends only on `nanochat/tensor.h`, so the CPU reference
# backend can link it to answer `GetCaps()` under `--config=sim` without
# gaining a dependency on the workflow layer. `PeakFlopsForDevice` in
# `train.cc` remains the authority for the MFU string patterns;
# `//tests:device_profile_test` keeps the two consistent.
cc_library(
    name = "device_profile",
    srcs = ["device_profile.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
)

# The vendor-free gradient-sync seam (docs/distributed-design.md section 4).
# The host reference and the NCCL backend share this header, so neither backend
# depends on the other.
cc_library(
    name = "distributed_seam",
    hdrs = ["distributed.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
)

# The vendor-free control plane shared by every gradient-sync backend
# (docs/distributed-native-plan.md section 4). POSIX sockets only; no vendor
# header, so the `src` layer stays vendor-free (DESIGN.md section 2.1).
cc_library(
    name = "rendezvous",
    srcs = ["rendezvous.cc"],
    hdrs = ["rendezvous.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":distributed_seam",
        "//include/nanochat:nanochat",
    ],
)

# The host reference for the gradient-sync seam
# (docs/distributed-design.md section 5). It defines `CreateGradientSync` for
# the CPU backend. A CUDA build gets that symbol from
# `//backends/cuda:nccl_sync`.
cc_library(
    name = "distributed_host",
    srcs = ["distributed.cc"],
    # `distributed.cc` uses the `AsF`/`ToC` conversion helpers from `ops.h`.
    hdrs = ["ops.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":distributed_seam",
        ":rendezvous",
        "//include/nanochat:nanochat",
    ],
)

# The backend-agnostic workflow: runtime tensor plumbing (`tensor.cc`,
# `workspace.h`), the reusable graph pieces (`ops.cc`), the fixed train graph
# (`model.cc`), the two inference graphs (`generate.cc`), and the harness
# (`data.cc`, `eval.cc`, `train.cc`). It is a kernel-sequence graph, not an
# autograd engine (DESIGN.md section 6).
cc_library(
    name = "model",
    srcs = [
        "data.cc",
        "eval.cc",
        "generate.cc",
        "mesh.cc",
        "mesh_collective.cc",
        "mesh_runtime.cc",
        "mesh_train.cc",
        "sft_shard.cc",
        "model.cc",
        "ops.cc",
        "optim.cc",
        "performance_model.cc",
        "tensor.cc",
        "train.cc",
    ],
    hdrs = [
        "cli.h",
        "eval.h",
        "generate.h",
        "mesh_collective.h",
        "mesh_runtime.h",
        "mesh_train.h",
        "sft_shard.h",
        "model_impl.h",
        "ops.h",
        "optim_state.h",
        "train.h",
        "workspace.h",
    ],
    copts = nanochat_copts(),
    defines = precision_defines(),
    # Backend selection is a build/link choice (docs/build.md): the same
    # workflow sources link the reference CPU backend by default or the CUDA
    # backend under `--config=cuda`. The gradient-sync factory follows the same
    # choice: the host reference on the CPU and NCCL on the GPU. There is no
    # host-reference fallback on the CUDA path.
    deps = select({
        "//:backend_cuda": [
            "//backends/cuda:all_kernels",
            "//backends/cuda:gradient_sync",
        ],
        "//:backend_cpu": [
            "//backends/cpu",
            ":distributed_host",
        ],
    }) + [
        ":distributed_seam",
        # `train.cc` reads the device capability table for the precision-aware
        # MFU peak (docs/precision.md).
        ":device_profile",
        # `eval.cc` decodes the generated rows through the tokenizer stream
        # decoder, so the workflow library links the host tokenizer.
        "//src/tokenizer:tokenizer",
        # `train.cc` builds a document-mode loader from the native parquet
        # reader (docs/parquet-native.md), so the workflow links it too.
        "//src/parquet:parquet",
        # `mesh_train.cc` and `sft_shard.cc` read the `NCSFT001` shard through
        # the shared record file (docs/training-seam.md section 6.2).
        ":record_file",
        "//include/nanochat:nanochat",
    ],
)

# The reinforcement-learning optimizer step (docs/rl-notebook.md section 4,
# docs/training-seam.md section 5.7). One library so the divisor lives in one
# place and the file-driven `rl_step` binary, the persistent worker, and the C
# ABI all share `RlStep` instead of copying it. It links the public headers and
# the workflow (for `Model`/`Optimizer`), so it adds no vendor dependency.
cc_library(
    name = "rl",
    srcs = ["rl.cc"],
    hdrs = ["rl.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
)

# The shared little-endian typed-record file (docs/rl-notebook.md section
# 4, docs/training-seam.md section 6.2). One layout backs the oracle fixture,
# the RL fixture, the evaluation fixture, the tokenizer fixture, and the numeric
# trace, so a test and a production binary read the same records. It is a leaf:
# the standard library only.
cc_library(
    name = "record_file",
    srcs = ["record_file.cc"],
    hdrs = ["record_file.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
)

# The `NANOORC1` RL fixture (docs/rl-notebook.md section 4). It is the shared
# record file under the RL magic. The persistent worker reads its configuration
# and initial parameters from the same fixture the file-driven `rl_step` binary
# consumes, so the worker has a fixture-driven smoke mode that needs no bridge.
# It is dependency-free, so a production binary can link it without depending
# on `//tests`.
cc_library(
    name = "rl_fixture",
    hdrs = ["rl_fixture.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":record_file",
        "//include/nanochat:nanochat",
    ],
)

# The persistent reinforcement-learning worker and its pipe protocol
# (docs/rl-notebook.md section 4, docs/training-seam.md section 6.4). It holds
# the model and the optimizer across messages and reaches the shared `RlStep`
# through `//src:rl`.
cc_library(
    name = "rl_worker_lib",
    srcs = ["rl_worker.cc"],
    hdrs = ["rl_worker.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        ":rl",
        "//include/nanochat:nanochat",
    ],
)

# The worker entry point. Without `--steps` it serves the pipe protocol on
# stdin/stdout; with `--fixture --steps N` it replays recorded rollouts so the
# worker can be gated without the Python bridge.
cc_binary(
    name = "rl_worker",
    srcs = ["rl_worker_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        ":rl",
        ":rl_fixture",
        ":rl_worker_lib",
        "//include/nanochat:nanochat",
    ],
)

# Model oracle parity: loads the committed CPU fixture and compares the model's
# forward logits, loss, and every parameter gradient. See docs/testing.md.
cc_test(
    name = "model_oracle_test",
    srcs = ["model_oracle_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["//tests:data/debug_state.bin"],
    args = ["$(rootpath //tests:data/debug_state.bin)"],
    deps = [
        ":model",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
)

# CUDA flavor of the oracle-parity test: same source and fixture, but linked
# against the CUDA backend under `--config=cuda` (which `tools/nanochat test
# --gpu` selects). The `gpu` tag keeps it out of the default CPU test loop;
# `//src:model_oracle_test` above remains the CPU proof.
cc_test(
    name = "model_oracle_gpu_test",
    srcs = ["model_oracle_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["//tests:data/debug_state.bin"],
    args = ["$(rootpath //tests:data/debug_state.bin)"],
    deps = [
        ":model",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
    tags = ["gpu"],
)

# Model configuration validation catches invalid graph dimensions and
# metadata before model allocation.
cc_test(
    name = "config_test",
    srcs = ["config_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Supplementary finite-difference check: the fixture zero-initializes the two
# projections, and zero-initializes `smear_lambda`, so the oracle test cannot
# exercise the attention/QkPrep/MLP backward or the smear input gradient. This
# test makes them nonzero and checks the analytic gradient along random
# directions over every parameter.
cc_test(
    name = "model_gradient_test",
    srcs = ["model_gradient_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Prefill/decode consistency and batched generation: proves the inference
# graphs agree with the train forward at the same positions, that decode samples
# a valid token, and that `GenerateBatch` (prefill once, clone the cache per
# row, decode in lockstep) matches a naive single-row loop for greedy and
# sampled decoding, including per-row terminal ids and the 1/0 mask.
cc_test(
    name = "generate_test",
    srcs = ["generate_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# CUDA flavor of the prefill/decode consistency test: same source, but linked
# against the CUDA backend under `--config=cuda` (which `tools/nanochat test
# --gpu` selects). This covers the inference-only wiring that the train-graph
# oracle does not touch: the KV-cache append, the cache-offset attention, the
# rotary-table offset, and the decode prev-embedding smear. The `gpu` tag keeps
# it out of the default CPU test loop; `//src:generate_test` above remains the
# CPU proof.
cc_test(
    name = "generate_gpu_test",
    srcs = ["generate_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# Optimizer grouping and schedules: the setup_optimizer AdamW/Muon parameter
# groups, the moments, the global gradient clip, and the learning-rate /
# momentum / weight-decay schedules. See docs/model.md.
cc_test(
    name = "optim_test",
    srcs = ["optim_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Data containers: token-shard round-trip, the DataLoader batch shape and
# targets shift, the Checkpoint container, and the LoadTokenizer contract.
cc_test(
    name = "data_test",
    srcs = ["data_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":model",
        "//src/tokenizer:tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# ScoreBatch (docs/eval.md section 3.2): the NLL/argmax shape contract, the
