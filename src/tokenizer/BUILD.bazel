# src/tokenizer/ — the native tokenizer host package. It owns the tokenizer,
# the byte pair encoding trainer, the parquet reader, the shard writer, and
# their command lines. See docs/tokenizer.md and docs/build.md.
#
# This is the one host package that may include the host-only DuckDB header.
# The model, the kernels, and the training runtime never link DuckDB
# (DESIGN.md section 2.1, invariant 1).

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# The native tokenizer (docs/tokenizer.md): the fixed-pattern splitter, the
# Unicode 16.0.0 tables, and the `NCTOKEN1` artifact loader. It is a host
# utility with no kernel dependency. OpenMP serves the trainer's split-and-count
# step, which shares the scanner.
cc_library(
    name = "tokenizer",
    srcs = [
        "bpe_trainer.cc",
        "split_pattern.cc",
        "tokenizer.cc",
        "utf8.cc",
    ],
    hdrs = [
        "split_pattern.h",
        "tokenizer_internal.h",
        "utf8.h",
    ],
    textual_hdrs = ["unicode_tables.inc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    deps = ["//include/nanochat:nanochat"],
)

# The tokenizer round trip: a tiny artifact, the special ids, the token bytes,
# the encoder, the lossy decoder, the stream decoder, and the bad-file contract.
cc_test(
    name = "tokenizer_test",
    srcs = ["tokenizer_test.cc"],
    copts = nanochat_copts(),
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# The splitter: the curated cases, the possessive and lookahead edge cases, the
# Unicode table boundaries, and a deterministic random corpus.
cc_test(
    name = "split_pattern_test",
    srcs = ["split_pattern_test.cc"],
    copts = nanochat_copts(),
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Reference parity: builds an `NCTOKEN1` artifact from
# `tests/data/tokenizer_fixture.bin` and compares the merges, the token bytes,
# the split cases, the encode cases, the decode cases, and the stream decoder.
cc_test(
    name = "tokenizer_parity_test",
    srcs = ["tokenizer_parity_test.cc"],
    copts = nanochat_copts(),
    data = ["//tests:data/tokenizer_fixture.bin"],
    args = ["$(rootpath //tests:data/tokenizer_fixture.bin)"],
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
)

# The trainer merge list, rank by rank, against the reference fixture. The
# trainer source lives in the `tokenizer` library because it shares the
# splitter and the OpenMP flags.
cc_test(
    name = "bpe_trainer_test",
    srcs = ["bpe_trainer_test.cc"],
    copts = nanochat_copts(),
    data = ["//tests:data/tokenizer_fixture.bin"],
    args = ["$(rootpath //tests:data/tokenizer_fixture.bin)"],
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
)

# The DuckDB C++ parquet reader (docs/tokenizer.md section 10). It is a host
# library; the model and the kernels do not link DuckDB. The release static
# archive omits the generated static-extension loader, so
# `duckdb_static_loader.cc` supplies the documented no-op.
cc_library(
    name = "parquet_reader",
    srcs = [
        "duckdb_static_loader.cc",
        "parquet_reader.cc",
    ],
    hdrs = ["parquet_reader.h"],
    # The DuckDB headers live in the external `@duckdb` repository root, whose
    # `cc_import` adds them to the quote-include path only. Add the same
    # directory to the angle-include path so `#include <duckdb.hpp>` resolves.
    # The path is relative to this package directory, so it climbs out of
    # `src/tokenizer/` to the exec root `external/` directory.
    includes = ["../../external/+http_archive+duckdb"],
    # The loader shim defines a symbol that `libduckdb_static.a` references but
    # does not define, so force every object of this library into the link.
    alwayslink = 1,
    copts = nanochat_copts(),
    linkopts = [
        "-ldl",
        "-lpthread",
    ],
    deps = [
        "@duckdb//:duckdb",
        "//include/nanochat:nanochat",
    ],
)

# The parquet reader: the dataset order and the text column on a tiny fixture
# that the test writes at run time with DuckDB.
cc_test(
    name = "parquet_reader_test",
    srcs = ["parquet_reader_test.cc"],
    copts = nanochat_copts(),
    deps = [
        ":parquet_reader",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# The `NANO` shard writer and the `<shard>.bytes` sidecar writer (docs/model.md,
# docs/tokenizer.md section 10).
cc_library(
    name = "shard_writer",
    srcs = ["shard_writer.cc"],
    hdrs = ["shard_writer.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
)

# The native trainer command line. DuckDB enters through `parquet_reader`.
cc_binary(
    name = "tok_train_main",
    srcs = ["tok_train_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":parquet_reader",
        ":tokenizer",
        "//include/nanochat:nanochat",
        "//src:cli",
    ],
)

# The parquet-to-shard command line. DuckDB enters through `parquet_reader`.
cc_binary(
    name = "tok_shard_main",
    srcs = ["tok_shard_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":parquet_reader",
        ":shard_writer",
        ":tokenizer",
        "//include/nanochat:nanochat",
        "//src:cli",
    ],
)

# Aggregation point consumed by //src:all and //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":tokenizer_test",
        ":split_pattern_test",
        ":tokenizer_parity_test",
        ":bpe_trainer_test",
        ":parquet_reader_test",
    ],
)
