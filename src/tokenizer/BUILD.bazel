# src/tokenizer/ — the native tokenizer host package. It owns the tokenizer,
# the byte pair encoding trainer, and the trainer command line. See
# docs/tokenizer.md and docs/build.md.
#
# The parquet reader moved to //src/parquet (docs/parquet-native.md). That
# package owns the only ZSTD header; this package and the training runtime no
# longer link DuckDB (DESIGN.md section 2.1, invariant 1).

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# The native tokenizer (docs/tokenizer.md): the fixed-pattern splitter, the
# Unicode 16.0.0 tables, and the `NCTOKEN1` artifact loader. It is a host
# utility with no kernel dependency. OpenMP serves the trainer's split-and-count
# step, which shares the scanner.
cc_library(
    name = "tokenizer",
    srcs = [
        "bpe_trainer.cc",
        "split_pattern.cc",
        "tokenizer.cc",
        "utf8.cc",
    ],
    hdrs = [
        "split_pattern.h",
        "tokenizer_internal.h",
        "utf8.h",
    ],
    textual_hdrs = ["unicode_tables.inc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    deps = ["//include/nanochat:nanochat"],
)

# The tokenizer round trip: a tiny artifact, the special ids, the token bytes,
# the encoder, the lossy decoder, the stream decoder, and the bad-file contract.
cc_test(
    name = "tokenizer_test",
    srcs = ["tokenizer_test.cc"],
    copts = nanochat_copts(),
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# The splitter: the curated cases, the possessive and lookahead edge cases, the
# Unicode table boundaries, and a deterministic random corpus.
cc_test(
    name = "split_pattern_test",
    srcs = ["split_pattern_test.cc"],
    copts = nanochat_copts(),
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# The UTF-8 code-point helpers that the trainer crop uses. They mirror Python's
# `len(str)` and `str[:n]`, so the native `--doc-cap` matches the reference.
cc_test(
    name = "utf8_test",
    srcs = ["utf8_test.cc"],
    copts = nanochat_copts(),
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Reference parity: builds an `NCTOKEN1` artifact from
# `tests/data/tokenizer_fixture.bin` and compares the merges, the token bytes,
# the split cases, the encode cases, the decode cases, and the stream decoder.
cc_test(
    name = "tokenizer_parity_test",
    srcs = ["tokenizer_parity_test.cc"],
    copts = nanochat_copts(),
    data = ["//tests:data/tokenizer_fixture.bin"],
    args = ["$(rootpath //tests:data/tokenizer_fixture.bin)"],
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
)

# The trainer merge list, rank by rank, against the reference fixture. The
# trainer source lives in the `tokenizer` library because it shares the
# splitter and the OpenMP flags.
cc_test(
    name = "bpe_trainer_test",
    srcs = ["bpe_trainer_test.cc"],
    copts = nanochat_copts(),
    data = ["//tests:data/tokenizer_fixture.bin"],
    args = ["$(rootpath //tests:data/tokenizer_fixture.bin)"],
    deps = [
        ":tokenizer",
        "//include/nanochat:nanochat",
        "//tests:oracle_fixture",
    ],
    size = "small",
)

# The native trainer command line. The native parquet reader supplies the
# documents (docs/parquet-native.md).
cc_binary(
    name = "tok_train_main",
    srcs = ["tok_train_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//src/parquet:parquet",
        ":tokenizer",
        "//include/nanochat:nanochat",
        "//src:cli",
    ],
)

# Aggregation point consumed by //src:all and //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":tokenizer_test",
        ":split_pattern_test",
        ":utf8_test",
        ":tokenizer_parity_test",
        ":bpe_trainer_test",
    ],
)
