# examples/hello_world — the smallest end-to-end inference example
# (docs/checkpoint-metadata-and-examples-plan.md section 6, decisions E1-E6,
# and stage B.1). One source builds as both a binary and a test, so the
# documented run command and the guard rail cannot drift apart (stage B.4).

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# The example itself. It links the workflow through the public headers only:
# `//src:model` selects the backend (CPU by default, CUDA under
# `--config=cuda`), exactly as the other entry points do.
cc_binary(
    name = "hello_world",
    srcs = ["hello_world.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# The same source as a T0 CPU test: the fixed seed pins the row count, the
# shape, and the mask (stage B.4), and `tools/nanochat test` runs it with the
# rest of `//:all_tests`.
cc_test(
    name = "hello_world_test",
    srcs = ["hello_world.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

test_suite(
    name = "all",
    tests = [":hello_world_test"],
)
