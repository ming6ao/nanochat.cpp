# Root package for nanochat.cpp.
#
# This file is the aggregation point for the per-directory BUILD files: the
# precision config_settings that every select() consumes live here, and
# :all_tests rolls up each package's `test_suite(name = "all")`. The canonical
# recursive target is `bazel build //...` / `bazel test //...`; :all_tests is
# the explicit alias for it. Per-directory packages load their CUDA rules and
# common options from //:nanochat.bzl. See docs/build.md.

package(default_visibility = ["//visibility:public"])

# Precision selection (docs/precision.md). See .bazelrc.
config_setting(
    name = "fp32",
    define_values = {"precision": "fp32"},
)

config_setting(
    name = "bf16",
    define_values = {"precision": "bf16"},
)

# The fp8 tier: an fp8 build computes in bf16 and quantizes the eligible
# matmuls (docs/fp8-training.md section 3.3).
config_setting(
    name = "fp8",
    define_values = {"precision": "fp8"},
)

# Backend selection (docs/build.md). `--backend=cpu` links the reference
# backend; `--backend=cuda` links the CUDA backend. `src/**` selects between
# them, so the shared workflow compiles once and links against either.
config_setting(
    name = "backend_cpu",
    define_values = {"backend": "cpu"},
)

config_setting(
    name = "backend_cuda",
    define_values = {"backend": "cuda"},
)

# Collective selection (docs/distributed-native-plan.md section 7, phase 0).
# `collective=nccl` is the default until the native path reaches parity;
# `--config=native` (or `--define=collective=native`) selects the native ring.
config_setting(
    name = "collective_native",
    define_values = {"collective": "native"},
)

config_setting(
    name = "collective_nccl",
    define_values = {"collective": "nccl"},
)

# Simulator selection (docs/simulator.md sections 4.1 and 8). `--config=sim` sets
# `--define=simulator=1`; the reference CPU backend then answers `GetCaps()`
# from `NANOCHAT_SIM_PROFILE` through the device profile table instead of
# reporting the host. It changes capabilities, never numerics.
config_setting(
    name = "sim",
    define_values = {"simulator": "1"},
)

# Simulator compile gate (docs/simulator.md section 8). `--config=sim-gate` sets
# `--define=simulator_gate=1`; `nanochat.bzl` then adds `-Werror` and the ptxas
# resource request to the CUDA compiler options. The setting stays out of the
# normal build, so the inner loop keeps its warnings.
config_setting(
    name = "sim_gate",
    define_values = {"simulator_gate": "1"},
)

# Aggregation point: each package publishes `test_suite(name = "all")`; new
# packages add their label here. Kept in sync with `bazel test //...`.
#
# Evaluation additions ride the existing package suites rather than adding new
# labels here: the sequence scorer lands as `//src:score_main` with its T0 unit
# test `//src:eval_test`, the batched generator extends `//src:generate_main` and
# `//src:generate_test`, and the parity fixtures land as
# `//tests:score_parity_test` and `//tests:generate_parity_test`. All of those
# are wired into `//src:all` and `//tests:all` by their owning packages, so they
# are aggregated here without the root graph referencing a target that does not
# exist yet. A genuinely new package (a new directory with its own BUILD file)
# is the only case that would add a label to this list. The two example
# packages are that case: each is a new directory, so each `//examples/<x>:all`
# rides here next to the package suites below (docs/examples.md).
test_suite(
    name = "all_tests",
    tests = [
        "//backends/cpu:all",
        "//backends/cuda:all",
        "//backends/cuda/collective:all",
        "//backends/cuda/kernels:all",
        "//bindings:all",
        "//dev/kernels:all",
        "//examples/checkpoint_roundtrip:all",
        "//examples/hello_world:all",
        "//notebooks:all",
        "//python:all",
        "//src:all",
        "//tests:all",
        "//tools:all",
        "//tools/modal:all",
    ],
)

# Reproducibility surface for the module graph: the lock file is exported
# beside the module declaration so a reviewer can pin the resolved repository
# set from the root package.
exports_files([
    "MODULE.bazel",
    "MODULE.bazel.lock",
    ".bazelrc",
    ".clang-format",
    "Makefile",
    "duckdb.BUILD",
])
