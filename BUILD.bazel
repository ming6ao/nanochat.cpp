# Root package for nanochat.cpp.
#
# This file is the aggregation point for the per-directory BUILD files: the
# precision config_settings that every select() consumes live here, and
# :all_tests rolls up each package's `test_suite(name = "all")`. The canonical
# recursive target is `bazel build //...` / `bazel test //...`; :all_tests is
# the explicit alias for it. Per-directory packages load their CUDA rules and
# common options from //:nanochat.bzl. See docs/build.md.

package(default_visibility = ["//visibility:public"])

# Precision selection (docs/precision.md). `--config=fp32` is the default and
# `--config=fp16` selects the half-precision build; see .bazelrc.
config_setting(
    name = "fp32",
    define_values = {"precision": "fp32"},
)

config_setting(
    name = "fp16",
    define_values = {"precision": "fp16"},
)

# Backend selection (docs/backends.md). `--backend=cpu` links the reference
# backend; `--backend=cuda` links the CUDA backend. `src/**` selects between
# them, so the shared workflow compiles once and links against either.
config_setting(
    name = "backend_cpu",
    define_values = {"backend": "cpu"},
)

config_setting(
    name = "backend_cuda",
    define_values = {"backend": "cuda"},
)

# Aggregation point: each package publishes `test_suite(name = "all")`; new
# packages add their label here. Kept in sync with `bazel test //...`.
#
# Evaluation additions ride the existing package suites rather than adding new
# labels here: the sequence scorer lands as `//src:score_main` with its T0 unit
# test `//src:eval_test`, the batched generator extends `//src:generate_main` and
# `//src:generate_test`, and the parity fixtures land as
# `//tests:score_parity_test` and `//tests:generate_parity_test`. All of those
# are wired into `//src:all` and `//tests:all` by their owning packages, so they
# are aggregated here without the root graph referencing a target that does not
# exist yet. A genuinely new package (a new directory with its own BUILD file)
# is the only case that would add a label to this list.
test_suite(
    name = "all_tests",
    tests = [
        "//backends/cpu:all",
        "//backends/cuda:all",
        "//backends/cuda/kernels:all",
        "//dev/kernels:all",
        "//src:all",
        "//tests:all",
        "//tools:all",
    ],
)

# Reproducibility surface for the module graph: the lock file is exported
# beside the module declaration so a reviewer can pin the resolved repository
# set from the root package.
exports_files([
    "MODULE.bazel",
    "MODULE.bazel.lock",
    ".bazelrc",
    ".clang-format",
    "Makefile",
])
