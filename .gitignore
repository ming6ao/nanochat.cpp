# Bazel convenience symlinks and output directory.
/bazel-*
# Makefile fallback build directory.
/build/
# Per-host Bazel options (compiler, arch, resource budget).
/.bazelrc.local
# Kaggle session scratch.
/.nanochat.env
# Profile artifacts: traces, measurements, and the reports of a loop run. They
# are measurements of one host on one day, not source, and a trace is hundreds
# of megabytes. docs/profile-guided-optimization.md says how to regenerate them.
/profiles/

# Python bytecode caches from the tool and test scripts.
__pycache__/
*.pyc
