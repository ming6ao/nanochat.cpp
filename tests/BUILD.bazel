    copts = nanochat_copts(),
    deps = [
        "//backends/cpu:cpu",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["sim"],
)

# The CPU GEMM thread-independence guard (docs/numerics-integration.md section
# 6.2). The numeric trace pins the kernel reductions to one thread for a stable
