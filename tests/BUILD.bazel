        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["sim"],
)

# The standalone hardware correctness gate (docs/correctness-gates.md section
# 4.6). `manual` keeps it out of the default run; `gpu` selects the broker.
