# tests/ — the oracle fixture and the end-to-end oracle harness. The fixture
# itself is data (`data/debug_state.bin`), produced offline by
# `tools/dump_oracle.py`; `oracle_fixture.h` is a torch-free reader that any
# backend or the model skeleton can reuse. See docs/testing.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# Backend marker for the oracle source. Under `--config=cuda` (which sets
# `--define=backend=cuda`, see .bazelrc) the source declares and calls the
# backend-internal fused-attention dispatch predicate. The CPU backend does not
# define that symbol, so the marker keeps the CPU build honest. A `select`
# concatenated with a list is the same pattern `//src:model` uses for its
# backend dependency.
_BACKEND_COPTS = select({
    "//:backend_cuda": ["-DNANOCHAT_BACKEND_CUDA"],
    "//:backend_cpu": [],
})

# Header-only reader for the binary oracle fixture. Kept separate from the test
# so `//src` (and the CUDA parity tests) can parse the same reference tensors.
cc_library(
    name = "oracle_fixture",
    hdrs = ["oracle_fixture.h"],
)

# The reference tokenizer fixture, `NANOTOK1`, produced by
# `tools/dump_tokenizer_fixture.py`. The tokenizer parity test in `//src` reads
# it with `//tests:oracle_fixture`. See docs/tokenizer.md section 12.
filegroup(
    name = "tokenizer_fixture",
    srcs = ["data/tokenizer_fixture.bin"],
)

# The Python-API reference fixture, `NANOEVL1`, produced by
# `tools/dump_api_fixture.py`. The in-process Python tests read it as data and
# compare the `Trainer` loss curve and the `Evaluator` bits-per-byte result
# against the committed C++ run. The parameter trajectory stays in
# `tests/data/train_parity.bin`; the `api/data/train_parity` record names it.
filegroup(
    name = "api_fixture",
    srcs = ["data/api_fixture.bin"],
)

# The planning reference fixture, `NANOPLAN`, produced by
# `tools/dump_plan_fixture.py`. The Python plan test reads it as data and
# compares the C parameter counts and the reference base_train.py plan
# arithmetic. See docs/python.md sections 4.3 and 11.
filegroup(
    name = "plan_fixture",
    srcs = ["data/plan_fixture.bin"],
)

# The chat prompt fixture, `NANCHAT1`, produced by
# `tools/dump_chat_fixture.py`. The Python chat test reads it as data and
# compares the prompt renderer to the reference tokenizer. See docs/python.md
# sections 5 and 11.
filegroup(
    name = "chat_fixture",
    srcs = ["data/chat_fixture.bin"],
)

# The document-mode loader parity gate (docs/parquet-native.md phase 8). The
# C++ rows must match the reference
# `tokenizing_distributed_data_loader_bos_bestfit` for a fixed corpus and
# tokenizer. `tools/dump_loader_fixture.py` writes both files.
cc_test(
    name = "loader_parity_test",
    srcs = ["loader_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/loader_parity.bin",
        "data/loader_tokenizer.nctoken",
    ],
    args = [
        "$(rootpath data/loader_parity.bin)",
        "$(rootpath data/loader_tokenizer.nctoken)",
    ],
    deps = [
        "//include/nanochat:nanochat",
        "//src:model",
        "//src/tokenizer:tokenizer",
    ],
    size = "small",
)

# CPU oracle: checks the reference softcap, cross-entropy, classifier
# gradients, parameter gradients, and the first optimizer step, then builds the
# C++ model from the same fixture and checks forward, backward, and the
# optimizer trajectory (the Wave-boundary parity gate).
cc_test(
    name = "oracle_test",
    srcs = ["oracle_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = ["data/debug_state.bin"],
    args = ["$(rootpath data/debug_state.bin)"],
    deps = [
        ":oracle_fixture",
        "//backends/cuda/kernels/testing:sequence_test_utils",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# CUDA flavor of the same parity gate: same source and fixture, linked against
# the CUDA backend under `--config=cuda` (which `tools/nanochat test --gpu`
# selects). The `gpu` tag keeps it out of the default CPU test loop;
# `//tests:oracle_test` remains the CPU proof.
cc_test(
    name = "oracle_cuda_test",
    srcs = ["oracle_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = ["data/debug_state.bin"],
    args = ["$(rootpath data/debug_state.bin)"],
    deps = [
        ":oracle_fixture",
        "//backends/cuda/kernels/testing:sequence_test_utils",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# Multi-step training parity: drives the C++ model over a recorded training
# trajectory (initial parameters, exact batches, per-step loss, gradient norm,
# and parameter L2) produced by `tools/dump_train_fixture.py`. The committed
# fixture is the compact CPU case; the same source also builds as the
# `train_parity` binary for a production fixture run under the sandbox.
cc_test(
    name = "train_parity_test",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/train_parity.bin"],
    args = ["$(rootpath data/train_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:train_parity_cuda_test` runs it.
cc_test(
    name = "train_parity_cuda_test",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/train_parity.bin"],
    args = ["$(rootpath data/train_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# Standalone runner for arbitrary (for example production, d8_s512) fixtures.
# Built under the selected backend; run it through `tools/nanochat`.
cc_binary(
    name = "train_parity",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# Generation parity: drives `GenerateBatch` in greedy mode from the parameters
# and prompt recorded by `tools/dump_generate_fixture.py`, and compares the
# generated token ids and the per-position 1/0 mask against the PyTorch
# reference exactly. The fixture's parameters are trained briefly so the
# classifier is peaked and the argmax is stable against roundoff. The committed
# fixture is the compact CPU case; the same source also builds against the CUDA
# backend for the `generate_parity_cuda_test` target below.
cc_test(
    name = "generate_parity_test",
    srcs = ["generate_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/generate_parity.bin"],
    args = ["$(rootpath data/generate_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:generate_parity_cuda_test` runs it.
cc_test(
    name = "generate_parity_cuda_test",
    srcs = ["generate_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/generate_parity.bin"],
    args = ["$(rootpath data/generate_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# RL parity: drives the shared `RlStep` over the rollouts, the targets, and the
# advantages recorded by `tools/dump_rl_fixture.py`, then runs the file-driven
# `//src:rl_step_main` on the same fixture and compares the loss, the gradient
# norm, and the parameter trajectory. The fixture records the model-independent
# normalization reference (the valid-target count and the divisor
# `num_valid * num_passes * examples_per_rank`), which the test also checks.
# The binary is launched as a subprocess from the runfiles tree, so this test
# exercises the fixture input/output, not just the in-process step.
cc_test(
    name = "rl_parity_test",
    srcs = ["rl_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/rl_parity.bin",
        "//src:rl_step_main",
    ],
    args = ["$(rootpath data/rl_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
        "//src:rl",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:rl_parity_cuda_test` runs it.
cc_test(
    name = "rl_parity_cuda_test",
    srcs = ["rl_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/rl_parity.bin",
        "//src:rl_step_main",
    ],
    args = ["$(rootpath data/rl_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
        "//src:rl",
    ],
    size = "small",
    tags = ["gpu"],
)

# Score parity: runs the real `score_main` on the synthetic CORE fixture from
# `tools/dump_eval_fixture.py` and compares its per-position NLL, argmax, and
# focused logits against the recorded PyTorch reference. The fixture carries
# the model parameters, so the test rebuilds the reference model and writes the
# checkpoint `score_main` loads; the runfiles also carry the `score_main`
# binary, which the test launches as a subprocess. The fixture is hermetic: no
# network, no `eval_bundle.zip`, no tokenizer. See docs/eval.md section 4.3.
cc_test(
    name = "score_parity_test",
    srcs = ["score_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/core_eval.bin",
        "//src:score_main",
    ],
    args = ["$(rootpath data/core_eval.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# The whole-campaign gate (docs/post-training.md): a tiny CPU model proves
# that `ForwardLoss` normalizes by the valid-target count, that
# `BackwardWeighted` with all-ones weights matches `Backward`, and that two
# `BackwardAccumulate` passes over micro-batches that share a token id sum to
# one `Backward` over the concatenated batch. It needs no fixture and no torch,
# so it stays a plain T0 CPU test.
cc_test(
    name = "post_training_core_test",
    srcs = ["post_training_core_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# The device profile / MFU consistency gate (docs/simulator.md section 7): the
# simulator's capability table and `PeakFlopsForDevice` must agree on every
# shared entry. Vendor-free and GPU-free, so it runs in the default T0 loop;
# it carries the `sim` tag because it is part of the S0 simulator tier.
cc_test(
    name = "device_profile_test",
    srcs = ["device_profile_test.cc"],
    copts = nanochat_copts(),
    deps = [
        "//include/nanochat:nanochat",
        # `PeakFlopsForDevice` stays the MFU authority and lives with the
        # harness; the test reads both tables to compare them.
        "//src:model",
    ],
    size = "small",
    tags = ["sim"],
)

# The fabricated `cudaDeviceProp` cross-check (docs/simulator.md section 5.1):
# the interposer's prefix must sit at the vendor field offsets, or `GetCaps()`
# reads the wrong bytes. Compiled against the real `<driver_types.h>`, so drift
# is a build failure. The asserts are constexpr; no device, no broker, no GPU.
# It needs the CUDA toolkit headers, so it builds on a host with the toolkit.
cc_test(
    name = "cuda_device_prop_abi_test",
    srcs = ["cuda_device_prop_abi_test.cc"],
    copts = nanochat_copts(),
    deps = [
        "//include/nanochat:nanochat",
        "//tools/cuda_sim:cuda_device_prop_prefix",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the reference engine. Same graph and fixture as `oracle_test`,
# run with and without the capability override, and asserted to produce
# identical values (docs/simulator.md section 4.4). It carries the `sim` tag so
# a merge gate can select it by name, but it stays in the default T0 loop: with
# no `--config=sim` the override is inert, which the test also pins. Add it to
# the `simulate` correctness suite, which runs it under `--config=sim`.
cc_test(
    name = "sim_numerics_test",
    srcs = ["sim_numerics_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//include/nanochat:nanochat",
        "//src:device_profile",
        "//src:model",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the emulation engine. Compares the real device kernels from
# backends/cuda/kernels/ (compiled by the host compiler against the emulator's
# CUDA stubs) against the CPU reference, kernel for kernel
# (docs/simulator.md section 9.3). CPU only, so it runs in the default loop.
cc_test(
    name = "kernel_emu_test",
    srcs = ["kernel_emu_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cpu:cpu",
        "//include/nanochat:nanochat",
        "//tools/cuda_sim/emu:emulated_kernels",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the collective path. Four rank processes run the NCCL mock, and
# the run must end with the elementwise sum on every rank; a rank that skips
# the all-reduce must be reported as a timeout, not a hang (docs/simulator.md
# section 12.3). CPU only.
cc_test(
    name = "collective_sim_test",
    srcs = ["collective_sim_test.cc"],
    copts = nanochat_copts(),
    deps = [
        "//include/nanochat:nanochat",
        "//tools/cuda_sim/collective:nccl_mock",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the API interposer, exercised in process. This is a *mock unit*
# test: it links //tools/cuda_sim:cuda_sim_interposer_impl directly and drives
# the mock's own entry points, asserting the named semantic invariants of
# docs/simulator.md section 12.2. It is not a binding test -- nothing here
# links the CUDA backend or exercises `LD_PRELOAD`; that is
# //tests:cuda_sim_preload_test, run by `tools/nanochat simulate --suite api`.
# CPU only; no GPU, driver, or toolkit.
cc_test(
    name = "cuda_sim_test",
    srcs = ["cuda_sim_test.cc"],
    copts = nanochat_copts(),
    deps = [
        "//include/nanochat:nanochat",
        "//tools/cuda_sim:cuda_sim_interposer_impl",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the real interposition path. Unlike `cuda_sim_test`, this links
# the *real* CUDA backend (device.cu + gemm.cu) and is run with
# `LD_PRELOAD=libcuda_sim_interposer.so`, so the calls below are bound to the
# mock by the dynamic linker. It drives `kernels::GetCaps`, the memory calls,
# both GEMM paths, and `Synchronize`, then asserts the mock's JSON log. It is
# `manual` because it must only run under `tools/nanochat simulate --suite api`,
# which supplies `LD_PRELOAD`, `NANOCHAT_SIM_LOG`, and `NANOCHAT_SIM_PROFILE`.
cc_test(
    name = "cuda_sim_preload_test",
    srcs = ["cuda_sim_preload_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda:cuda",
        "//include/nanochat:nanochat",
        # To derive the expected caps from the profile name the run simulates.
        "//src:device_profile",
    ],
    size = "small",
    tags = [
        "manual",
        "sim",
    ],
)

# The staged numeric trace of docs/numerics-integration.md. One source computes
# the whole trace (training, evaluation, greedy generation, the SFT arithmetic,
# and the RL arithmetic) as a flat list of named records; the emitter writes the
# committed golden file, and the two tests replay it. The library is shared so
# the emitter and the test cannot drift apart.
cc_library(
    name = "numerics_trace",
    srcs = ["numerics_trace.cc"],
    hdrs = ["numerics_trace.h"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# The golden-trace emitter, driven by `tools/dump_numerics_golden.py`. It writes
# `tests/data/numerics_golden_10l.bin` from the fp32 CPU reference build; run it
# through `tools/nanochat run t0-cpu --`, never directly.
cc_binary(
    name = "numerics_trace_emit",
    srcs = ["numerics_trace_emit_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":numerics_trace",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# The numeric-trace replay gate (docs/numerics-integration.md): the CPU trace
# must equal the committed golden byte for byte, and `tools/nanochat simulate
# --suite correctness` runs this same target under `--config=sim` as the
# regression guard (section 2.2). A 10-layer run with double GEMM over five
# steps is the slow part, so the target carries `manual` and stays out of the
# default test loop; run it as `tools/nanochat test //tests:numerics_trace_test`
# or through the simulator correctness suite.
cc_test(
    name = "numerics_trace_test",
    srcs = ["numerics_trace_test.cc"],
    # The exactness intent belongs to the target, not to a backend define: this
    # target must reproduce the golden byte for byte, on the reference CPU
    # backend and on the same backend under `--config=sim`.
    copts = nanochat_copts() + ["-DNANOCHAT_TRACE_EXACT"],
    defines = precision_defines(),
    data = [
        "data/loader_tokenizer.nctoken",
        "data/numerics_golden_10l.bin",
    ],
    args = [
        "$(rootpath data/numerics_golden_10l.bin)",
        "$(rootpath data/loader_tokenizer.nctoken)",
    ],
    deps = [
        ":numerics_trace",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "medium",
    tags = [
        "manual",
        "sim",
    ],
)

# Same gate on the CUDA backend: the scalars must match the golden within the
# measured tolerance table and the greedy identifiers must match exactly. The
# parameter and gradient hashes are skipped (atomic scatter-adds change the
# bytes by design). `gpu` keeps it out of the default loop, and
# `tools/nanochat test --gpu` discovers it.
cc_test(
    name = "numerics_trace_cuda_test",
    srcs = ["numerics_trace_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/loader_tokenizer.nctoken",
        "data/numerics_golden_10l.bin",
    ],
    args = [
        "$(rootpath data/numerics_golden_10l.bin)",
        "$(rootpath data/loader_tokenizer.nctoken)",
    ],
    deps = [
        ":numerics_trace",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = [
        "gpu",
    ],
)

# Aggregation point consumed by //:all_tests.
test_suite(name = "all", tests = [
    ":oracle_test",
    ":oracle_cuda_test",
    ":train_parity_test",
    ":train_parity_cuda_test",
    ":rl_parity_test",
    ":generate_parity_test",
    ":generate_parity_cuda_test",
    ":score_parity_test",
    ":loader_parity_test",
    ":post_training_core_test",
    ":device_profile_test",
    ":cuda_device_prop_abi_test",
    ":sim_numerics_test",
    ":kernel_emu_test",
    ":collective_sim_test",
    ":cuda_sim_test",
])
