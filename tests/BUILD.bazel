# tests/ — the oracle fixture and the end-to-end oracle harness. The fixture
# itself is data (`data/debug_state.bin`), produced offline by
# `tools/dump_oracle.py`; `oracle_fixture.h` is a torch-free reader that any
# backend or the model skeleton can reuse. See docs/testing.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# Backend marker for the oracle source. Under `--config=cuda` (which sets
# `--define=backend=cuda`, see .bazelrc) the source declares and calls the
# backend-internal fused-attention dispatch predicate. The CPU backend does not
# define that symbol, so the marker keeps the CPU build honest. A `select`
# concatenated with a list is the same pattern `//src:model` uses for its
# backend dependency.
_BACKEND_COPTS = select({
    "//:backend_cuda": ["-DNANOCHAT_BACKEND_CUDA"],
    "//:backend_cpu": [],
})

# Header-only reader for the binary oracle fixture. Kept separate from the test
# so `//src` (and the CUDA parity tests) can parse the same reference tensors.
cc_library(
    name = "oracle_fixture",
    hdrs = ["oracle_fixture.h"],
)

# The reference tokenizer fixture, `NANOTOK1`, produced by
# `tools/dump_tokenizer_fixture.py`. The tokenizer parity test in `//src` reads
# it with `//tests:oracle_fixture`. See docs/tokenizer.md section 12.
filegroup(
    name = "tokenizer_fixture",
    srcs = ["data/tokenizer_fixture.bin"],
)

# The Python-API reference fixture, `NANOEVL1`, produced by
# `tools/dump_api_fixture.py`. The in-process Python tests read it as data and
# compare the `Trainer` loss curve and the `Evaluator` bits-per-byte result
# against the committed C++ run. The parameter trajectory stays in
# `tests/data/train_parity.bin`; the `api/data/train_parity` record names it.
filegroup(
    name = "api_fixture",
    srcs = ["data/api_fixture.bin"],
)

# The document-mode loader parity gate (docs/parquet-native.md phase 8). The
# C++ rows must match the reference
# `tokenizing_distributed_data_loader_bos_bestfit` for a fixed corpus and
# tokenizer. `tools/dump_loader_fixture.py` writes both files.
cc_test(
    name = "loader_parity_test",
    srcs = ["loader_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/loader_parity.bin",
        "data/loader_tokenizer.nctoken",
    ],
    args = [
        "$(rootpath data/loader_parity.bin)",
        "$(rootpath data/loader_tokenizer.nctoken)",
    ],
    deps = [
        "//include/nanochat:nanochat",
        "//src:model",
        "//src/tokenizer:tokenizer",
    ],
    size = "small",
)

# CPU oracle: checks the reference softcap, cross-entropy, classifier
# gradients, parameter gradients, and the first optimizer step, then builds the
# C++ model from the same fixture and checks forward, backward, and the
# optimizer trajectory (the Wave-boundary parity gate).
cc_test(
    name = "oracle_test",
    srcs = ["oracle_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = ["data/debug_state.bin"],
    args = ["$(rootpath data/debug_state.bin)"],
    deps = [
        ":oracle_fixture",
        "//backends/cuda/kernels/testing:sequence_test_utils",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# CUDA flavor of the same parity gate: same source and fixture, linked against
# the CUDA backend under `--config=cuda` (which `tools/nanochat test --gpu`
# selects). The `gpu` tag keeps it out of the default CPU test loop;
# `//tests:oracle_test` remains the CPU proof.
cc_test(
    name = "oracle_cuda_test",
    srcs = ["oracle_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = ["data/debug_state.bin"],
    args = ["$(rootpath data/debug_state.bin)"],
    deps = [
        ":oracle_fixture",
        "//backends/cuda/kernels/testing:sequence_test_utils",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# Multi-step training parity: drives the C++ model over a recorded training
# trajectory (initial parameters, exact batches, per-step loss, gradient norm,
# and parameter L2) produced by `tools/dump_train_fixture.py`. The committed
# fixture is the compact CPU case; the same source also builds as the
# `train_parity` binary for a production fixture run under the sandbox.
cc_test(
    name = "train_parity_test",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/train_parity.bin"],
    args = ["$(rootpath data/train_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:train_parity_cuda_test` runs it.
cc_test(
    name = "train_parity_cuda_test",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/train_parity.bin"],
    args = ["$(rootpath data/train_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# Standalone runner for arbitrary (for example production, d8_s512) fixtures.
# Built under the selected backend; run it through `tools/nanochat`.
cc_binary(
    name = "train_parity",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# Generation parity: drives `GenerateBatch` in greedy mode from the parameters
# and prompt recorded by `tools/dump_generate_fixture.py`, and compares the
# generated token ids and the per-position 1/0 mask against the PyTorch
# reference exactly. The fixture's parameters are trained briefly so the
# classifier is peaked and the argmax is stable against roundoff. The committed
# fixture is the compact CPU case; the same source also builds against the CUDA
# backend for the `generate_parity_cuda_test` target below.
cc_test(
    name = "generate_parity_test",
    srcs = ["generate_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/generate_parity.bin"],
    args = ["$(rootpath data/generate_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:generate_parity_cuda_test` runs it.
cc_test(
    name = "generate_parity_cuda_test",
    srcs = ["generate_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/generate_parity.bin"],
    args = ["$(rootpath data/generate_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# Score parity: runs the real `score_main` on the synthetic CORE fixture from
# `tools/dump_eval_fixture.py` and compares its per-position NLL, argmax, and
# focused logits against the recorded PyTorch reference. The fixture carries
# the model parameters, so the test rebuilds the reference model and writes the
# checkpoint `score_main` loads; the runfiles also carry the `score_main`
# binary, which the test launches as a subprocess. The fixture is hermetic: no
# network, no `eval_bundle.zip`, no tokenizer. See docs/eval.md section 4.3.
cc_test(
    name = "score_parity_test",
    srcs = ["score_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/core_eval.bin",
        "//src:score_main",
    ],
    args = ["$(rootpath data/core_eval.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# Aggregation point consumed by //:all_tests.
test_suite(name = "all", tests = [
    ":oracle_test",
    ":oracle_cuda_test",
    ":train_parity_test",
    ":train_parity_cuda_test",
    ":generate_parity_test",
    ":generate_parity_cuda_test",
    ":score_parity_test",
    ":loader_parity_test",
])
