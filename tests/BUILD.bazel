# tests/ — the oracle fixture and the end-to-end oracle harness. The fixture
# itself is data (`data/debug_state.bin`), produced offline by
# `tools/dump_fixtures.py oracle`; `oracle_fixture.h` is a torch-free reader that any
# backend or the model skeleton can reuse. See docs/testing.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# Backend marker for the oracle source. Under `--config=cuda` (which sets
# `--define=backend=cuda`, see .bazelrc) the source declares and calls the
# backend-internal fused-attention dispatch predicate. The CPU backend does not
# define that symbol, so the marker keeps the CPU build honest. A `select`
# concatenated with a list is the same pattern `//src:model` uses for its
# backend dependency.
_BACKEND_COPTS = select({
    "//:backend_cuda": ["-DNANOCHAT_BACKEND_CUDA"],
    "//:backend_cpu": [],
})

# Header-only reader for the binary oracle fixture, plus the shared parameter
# staging helper. `param_stage.h` writes fp32 fixture values into the parameter
# master and refreshes the compute copy (docs/precision.md section 5), so the
# fixture tests work in both the fp32 and the bf16 build. Kept separate from the
# test so `//src` (and the CUDA parity tests) can parse the same reference
# tensors.
cc_library(
    name = "oracle_fixture",
    hdrs = [
        "oracle_fixture.h",
        "param_stage.h",
    ],
    deps = [
        "//include/nanochat:nanochat",
        "//src:record_file",
    ],
)

# The reference tokenizer fixture, `NANOTOK1`, produced by
# `tools/dump_fixtures.py tokenizer`. The tokenizer parity test in `//src` reads
# it with `//tests:oracle_fixture`. See docs/tokenizer.md section 12.
filegroup(
    name = "tokenizer_fixture",
    srcs = ["data/tokenizer_fixture.bin"],
)

# The Python-API reference fixture, `NANOEVL1`, produced by
# `tools/dump_fixtures.py api`. The in-process Python tests read it as data and
# compare the `Trainer` loss curve and the `Evaluator` bits-per-byte result
# against the committed C++ run. The parameter trajectory stays in
# `tests/data/train_parity.bin`; the `api/data/train_parity` record names it.
filegroup(
    name = "api_fixture",
    srcs = ["data/api_fixture.bin"],
)

# The planning reference fixture, `NANOPLAN`, produced by
# `tools/dump_fixtures.py plan`. The Python plan test reads it as data and
# compares the C parameter counts and the reference base_train.py plan
# arithmetic. See docs/python.md sections 4.3 and 11.
filegroup(
    name = "plan_fixture",
    srcs = ["data/plan_fixture.bin"],
)

# The chat prompt fixture, `NANCHAT1`, produced by
# `tools/dump_fixtures.py chat`. The Python chat test reads it as data and
# compares the prompt renderer to the reference tokenizer. See docs/python.md
# sections 5 and 11.
filegroup(
    name = "chat_fixture",
    srcs = ["data/chat_fixture.bin"],
)

# The five SFT fixtures of docs/sft-parity-plan.md sections 6.1 to 6.4, one
# filegroup each so a test takes only the bytes it reads. Every one comes from
# `tools/dump_fixtures.py sft` or `tools/dump_fixtures.py sft_loop`; the durable
# record of what each file holds is `tests/data/sft_fixtures.txt`. Together they
# are 732 KiB, so the gates that read them stay in the T0 size class (section
# 5.5). Nothing here is regenerated by a test.

# `NANCHAT1`: the version word and one JSON object with the settings, the
# fixture tokenizer, the eight conversations, the render section, the packed
# rows, and the two mixture orders. The phase C.1 Python gate and the phase B
# load test read it.
filegroup(
    name = "sft_pack_fixture",
    srcs = ["data/sft_pack_fixture.bin"],
)

# `NANOORC1`: the eight-step reference trajectory (the run config, the rate
# table, the recorded micro-batch pairs, and the five per-step scalars).
# //tests:sft_step_parity_test reads it.
filegroup(
    name = "sft_step_fixture",
    srcs = ["data/sft_step_fixture.bin"],
)

# `NANOORC1`: the reference loop trace (the progress, the rate multiplier, the
# momentum, and the logged loss per step, plus the final evaluation).
# //tests:sft_loop_parity_test and //tests:sft_parity_test read it.
filegroup(
    name = "sft_loop_fixture",
    srcs = ["data/sft_loop_fixture.bin"],
)

# `NCSFT001`: the four packed rows, shape [4, 32], with -1 where a target is
# masked. The driver and the packed-row evaluator read it.
filegroup(
    name = "sft_rows_fixture",
    srcs = ["data/sft_rows_fixture.nchsft"],
)

# `NCHKPT01` version 1: the reference parameters and the (zero) optimizer
# moments at step 0, under the canonical C++ names. This is the warm start of
# design decision D5.
filegroup(
    name = "sft_base_fixture",
    srcs = ["data/sft_base_fixture.ckpt"],
)

# The version 0 checkpoint fixture, `tests/data/checkpoint_v0.ckpt`, produced by
# `tools/dump_fixtures.py checkpoint` from the writer before the metadata work
# moved it, so the bytes are the ones a Hub artifact already carries
# (docs/checkpoint-metadata-and-examples-plan.md stage A.2).
# `//tests:checkpoint_compat_test` reads it with the shipped reader; the note
# `tests/data/checkpoint_v0.txt` is the durable record this summary cites:
#
#   name               dtype       shape   payload bytes   FNV-1a 64
#   fixture/weights    float32     (2, 3)             24   0x7610708711193cf0
#   fixture/bias       bfloat16    (3,)                6   0x702bf156049a2035
#
# Concatenated payload checksum 0x41273f0935abaaa8, file size 145 bytes,
# sha256 f7a5b88723bc5f50787eddf63f6166d36df42df3217c4f078a97bb7e1f6c3a27.
# Never regenerate it: once `Checkpoint::Save` writes a version word above 0 the
# generator command produces version 1 bytes, and writing them here would delete
# the guard this file exists to provide.
filegroup(
    name = "checkpoint_v0_fixture",
    srcs = ["data/checkpoint_v0.ckpt"],
)

# The document-mode loader parity gate (docs/parquet-native.md phase 8). The
# C++ rows must match the reference
# `tokenizing_distributed_data_loader_bos_bestfit` for a fixed corpus and
# tokenizer. `tools/dump_fixtures.py loader` writes both files.
cc_test(
    name = "loader_parity_test",
    srcs = ["loader_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/loader_parity.bin",
        "data/loader_tokenizer.nctoken",
    ],
    args = [
        "$(rootpath data/loader_parity.bin)",
        "$(rootpath data/loader_tokenizer.nctoken)",
    ],
    deps = [
        "//include/nanochat:nanochat",
        "//src:model",
        "//src/tokenizer:tokenizer",
    ],
    size = "small",
)

# The version 0/1 checkpoint compatibility guard
# (docs/checkpoint-metadata-and-examples-plan.md stage A.4 and section 5's case
# table): the release gate that keeps the artifacts already on the Hub loading.
# It reads the pinned version 0 fixture and asserts its record names, storage
# dtypes, shapes, payload bytes, and checksums, that a version 1 file round-trips
# every field, that both drift directions are accepted and counted (`extra_u32`
# and `missing_fields`), and that every malformed input is a hard error with no
# partial load. It also carries section 8's precision gate, so the same target
# runs in the bf16 and fp8 builds:
# `tools/nanochat test //tests:checkpoint_compat_test --config=bf16`.
cc_test(
    name = "checkpoint_compat_test",
    srcs = ["checkpoint_compat_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/checkpoint_v0.ckpt"],
    args = ["$(rootpath data/checkpoint_v0.ckpt)"],
    deps = [
        "//include/nanochat:nanochat",
        # `Checkpoint` lives with the workflow (`src/data.cc`), and
        # `BuildComputePrecision`/`PrecisionName` live in
        # `src/performance_model.cc`, so the precision gate can report the build.
        "//src:model",
    ],
    size = "small",
)

# CPU oracle: checks the reference softcap, cross-entropy, classifier
# gradients, parameter gradients, and the first optimizer step, then builds the
# C++ model from the same fixture and checks forward, backward, and the
# optimizer trajectory (the Wave-boundary parity gate).
cc_test(
    name = "oracle_test",
    srcs = ["oracle_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = ["data/debug_state.bin"],
    args = ["$(rootpath data/debug_state.bin)"],
    deps = [
        ":oracle_fixture",
        "//backends/cuda/kernels/testing:sequence_test_utils",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# CUDA flavor of the same parity gate: same source and fixture, linked against
# the CUDA backend under `--config=cuda` (which `tools/nanochat test --gpu`
# selects). The `gpu` tag keeps it out of the default CPU test loop;
# `//tests:oracle_test` remains the CPU proof.
cc_test(
    name = "oracle_cuda_test",
    srcs = ["oracle_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = ["data/debug_state.bin"],
    args = ["$(rootpath data/debug_state.bin)"],
    deps = [
        ":oracle_fixture",
        "//backends/cuda/kernels/testing:sequence_test_utils",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# Multi-step training parity: drives the C++ model over a recorded training
# trajectory (initial parameters, exact batches, per-step loss, gradient norm,
# and parameter L2) produced by `tools/dump_fixtures.py train`. The committed
# fixture is the compact CPU case; the same source also builds as the
# `train_parity` binary for a production fixture run under the sandbox.
cc_test(
    name = "train_parity_test",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/train_parity.bin"],
    args = ["$(rootpath data/train_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:train_parity_cuda_test` runs it.
cc_test(
    name = "train_parity_cuda_test",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/train_parity.bin"],
    args = ["$(rootpath data/train_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# --- the supervised-fine-tuning gates (docs/sft-parity-plan.md section 7) ---

# The phase B gate: the five SFT fixtures load with no reference checkout, no
# torch, and no network. It opens the two record fixtures through
# `tests/oracle_fixture.h`, reads the shard with `LoadSftShard`, loads the base
# checkpoint with `Checkpoint::Load`, and parses the pack fixture's `NANCHAT1`
# header and JSON. T0, CPU, and it computes no model number.
cc_test(
    name = "sft_fixture_load_test",
    srcs = ["sft_fixture_load_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/sft_pack_fixture.bin",
        "data/sft_step_fixture.bin",
        "data/sft_loop_fixture.bin",
        "data/sft_rows_fixture.nchsft",
        "data/sft_base_fixture.ckpt",
    ],
    args = [
        "$(rootpath data/sft_step_fixture.bin)",
        "$(rootpath data/sft_loop_fixture.bin)",
        "$(rootpath data/sft_rows_fixture.nchsft)",
        "$(rootpath data/sft_base_fixture.ckpt)",
        "$(rootpath data/sft_pack_fixture.bin)",
    ],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        # `Checkpoint` lives with the workflow (`src/data.cc`) and the shard
        # reader with the mesh training driver (`src/sft_shard.cc`).
        "//src:model",
        # The pack fixture is JSON: one strict reader, the same one that reads
        # `spec.json` and `caps.json`.
        "//src:json",
    ],
    size = "small",
)

# The R2 arithmetic parity gate (phase D): the C++ trajectory -- `ForwardLoss`,
# `BackwardWeighted`, the progress rate multiplier, and `Optimizer::Step` -- over
# the eight recorded steps from the recorded parameters and moments. Tolerance:
# loss 1e-5, parameter L2 1e-4 (docs/testing.md). T0 on the CPU reference.
cc_test(
    name = "sft_step_parity_test",
    srcs = ["sft_step_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/sft_step_fixture.bin",
        "data/sft_base_fixture.ckpt",
    ],
    args = [
        "$(rootpath data/sft_step_fixture.bin)",
        "$(rootpath data/sft_base_fixture.ckpt)",
    ],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        # The optimizer-state records (`src/optim_state.h`) live with the
        # workflow, so the warm start restores the moments through the same two
        # functions `src/train.cc` uses.
        "//src:model",
    ],
    size = "small",
)

# Same gate on the CUDA backend, at T1: `gpu` keeps it out of the T0 loop and
# `manual` keeps it out of the wildcard GPU sweep, because the plan runs the GPU
# parity legs at a wave boundary only. Naming the target runs it:
# `tools/nanochat test --gpu //tests:sft_step_parity_gpu_test`.
cc_test(
    name = "sft_step_parity_gpu_test",
    srcs = ["sft_step_parity_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/sft_step_fixture.bin",
        "data/sft_base_fixture.ckpt",
    ],
    args = [
        "$(rootpath data/sft_step_fixture.bin)",
        "$(rootpath data/sft_base_fixture.ckpt)",
    ],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = [
        "gpu",
        "manual",
    ],
)

# The standalone runner for a larger fixture (T2): the same source, with the
# fixture paths as arguments, run through the sandbox at a wave boundary.
cc_binary(
    name = "sft_step_parity",
    srcs = ["sft_step_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# The R3 schedule gate (phase E): the recorded progress through
# `Scheduler::LrMultiplierForProgress`, the recorded step through
# `Scheduler::MuonMomentum`, the loss curve, and the final evaluation. The
# schedule settings are the pinned section 5.2 ones, which the step fixture
# records; both fixtures come from the same pinned-settings module
# (`tools/sft_fixture.py`), so reading them from one file is what keeps the two
# from drifting. T0, CPU.
cc_test(
    name = "sft_loop_parity_test",
    srcs = ["sft_loop_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/sft_loop_fixture.bin",
        "data/sft_step_fixture.bin",
        "data/sft_rows_fixture.nchsft",
    ],
    args = [
        "$(rootpath data/sft_loop_fixture.bin)",
        "$(rootpath data/sft_step_fixture.bin)",
        "$(rootpath data/sft_rows_fixture.nchsft)",
    ],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# The R3/R4 driver gate (phase F): the real `src/sft_main` binary over the
# committed shard from the committed base checkpoint with the pinned settings,
# compared against the loop fixture's loss curve, bits-per-byte, ChatCORE
# sentinel, and final parameters. `gpu` keeps it out of the T0 loop and `manual`
# out of the wildcard GPU sweep; the plan runs it at a wave boundary:
# `tools/nanochat test --gpu //tests:sft_parity_test`.
cc_test(
    name = "sft_parity_test",
    srcs = ["sft_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/sft_loop_fixture.bin",
        "data/sft_step_fixture.bin",
        "data/sft_rows_fixture.nchsft",
        "data/sft_base_fixture.ckpt",
        # The driver itself: the test launches it as a subprocess from the
        # runfiles tree, so the gate exercises the real flags and the real
        # progress stream.
        "//src:sft_main",
    ],
    args = [
        "$(rootpath data/sft_loop_fixture.bin)",
        "$(rootpath data/sft_step_fixture.bin)",
        "$(rootpath data/sft_rows_fixture.nchsft)",
        "$(rootpath data/sft_base_fixture.ckpt)",
    ],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "medium",
    tags = [
        "gpu",
        "manual",
    ],
)

# Standalone runner for arbitrary (for example production, d8_s512) fixtures.
# Built under the selected backend; run it through `tools/nanochat`.
cc_binary(
    name = "train_parity",
    srcs = ["train_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# Generation parity: drives `GenerateBatch` in greedy mode from the parameters
# and prompt recorded by `tools/dump_fixtures.py generate`, and compares the
# generated token ids and the per-position 1/0 mask against the PyTorch
# reference exactly. The fixture's parameters are trained briefly so the
# classifier is peaked and the argmax is stable against roundoff. The committed
# fixture is the compact CPU case; the same source also builds against the CUDA
# backend for the `generate_parity_cuda_test` target below.
cc_test(
    name = "generate_parity_test",
    srcs = ["generate_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/generate_parity.bin"],
    args = ["$(rootpath data/generate_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:generate_parity_cuda_test` runs it.
cc_test(
    name = "generate_parity_cuda_test",
    srcs = ["generate_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = ["data/generate_parity.bin"],
    args = ["$(rootpath data/generate_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = ["gpu"],
)

# RL parity: drives the shared `RlStep` over the rollouts, the targets, and the
# advantages recorded by `tools/dump_fixtures.py rl`, then runs the file-driven
# `//src:rl_step_main` on the same fixture and compares the loss, the gradient
# norm, and the parameter trajectory. The fixture records the model-independent
# normalization reference (the valid-target count and the divisor
# `num_valid * num_passes * examples_per_rank`), which the test also checks.
# The binary is launched as a subprocess from the runfiles tree, so this test
# exercises the fixture input/output, not just the in-process step.
cc_test(
    name = "rl_parity_test",
    srcs = ["rl_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/rl_parity.bin",
        "//src:rl_step_main",
    ],
    args = ["$(rootpath data/rl_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
        "//src:rl",
    ],
    size = "small",
)

# Same gate on the CUDA backend. Kept out of the default CPU loop by the `gpu`
# tag; `tools/nanochat test --gpu //tests:rl_parity_cuda_test` runs it.
cc_test(
    name = "rl_parity_cuda_test",
    srcs = ["rl_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/rl_parity.bin",
        "//src:rl_step_main",
    ],
    args = ["$(rootpath data/rl_parity.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
        "//src:rl",
    ],
    size = "small",
    tags = ["gpu"],
)

# Score parity: runs the real `score_main` on the synthetic CORE fixture from
# `tools/dump_fixtures.py eval` and compares its per-position NLL, argmax, and
# focused logits against the recorded PyTorch reference. The fixture carries
# the model parameters, so the test rebuilds the reference model and writes the
# checkpoint `score_main` loads; the runfiles also carry the `score_main`
# binary, which the test launches as a subprocess. The fixture is hermetic: no
# network, no `eval_bundle.zip`, no tokenizer. See docs/eval.md section 4.3.
cc_test(
    name = "score_parity_test",
    srcs = ["score_parity_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/core_eval.bin",
        "//src:score_main",
    ],
    args = ["$(rootpath data/core_eval.bin)"],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# The whole-campaign gate (docs/post-training.md): a tiny CPU model proves
# that `ForwardLoss` normalizes by the valid-target count, that
# `BackwardWeighted` with all-ones weights matches `Backward`, and that two
# `BackwardAccumulate` passes over micro-batches that share a token id sum to
# one `Backward` over the concatenated batch. It needs no fixture and no torch,
# so it stays a plain T0 CPU test.
cc_test(
    name = "post_training_core_test",
    srcs = ["post_training_core_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
)

# The device profile / MFU consistency gate (docs/simulator.md section 7) and
# the caps.json derivation gate (docs/model-and-device-bringup.md sections 6 and
# 16): the simulator's capability table and `PeakFlopsForDevice` must agree on
# every shared entry, and every row of the table must re-derive from a
# `devices[]` entry in `backends/<name>/caps.json`. The two declarations are the
# test's data, so it reads the same bytes the derivation reads. Vendor-free and
# GPU-free, so it runs in the default T0 loop; it carries the `sim` tag because
# it is part of the S0 simulator tier.
cc_test(
    name = "device_profile_test",
    srcs = ["device_profile_test.cc"],
    copts = nanochat_copts(),
    data = [
        "//backends/cpu:caps_json",
        "//backends/cuda:caps_json",
    ],
    deps = [
        "//include/nanochat:nanochat",
        # `PeakFlopsForDevice` stays the MFU authority and lives with the
        # harness; the test reads both tables to compare them.
        "//src:model",
        # The declarations are JSON, so the test parses them with the same
        # reader the derivation uses instead of a second hand-rolled scanner.
        "//src:json",
    ],
    size = "small",
    tags = ["sim"],
)

# The section 16 P3 gate: a plan is built under T0 CPU with no device present
# (docs/model-and-device-bringup.md section 9.1 rule 1). Four claims: a complete
# fabricated capability mask builds a plan whose every composition runs the
# composition path; a mask missing a required bit is rejected with the bit and
# its consequence named; a mask that satisfies `requires` but lacks a
# composition's own bit leaves that composition unplaced and names the gap; and
# a mask declaring an override bit selects the fused family and records the
# composition as the declined fallback. No device is opened, no checkpoint is
# read, and no kernel runs.
cc_test(
    name = "plan_gate_test",
    srcs = ["plan_gate_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    # The reference declaration is what a device that reports no mask is read
    # through, so the fabricated device answers are compared with the same file
    # a launch reads.
    data = ["//backends/cpu:caps_json"],
    deps = [
        "//include/nanochat:nanochat",
        "//src:model_spec",
        # `src/plan_internal.h` is the fabricated-device seam: the test supplies
        # the device's answer and the registration table itself.
        "//src:plan",
    ],
    size = "small",
)

# The section 10.4 gate in code: the flagship model's fixtures re-derive from
# their own bytes, diff against their source within
# `models/nanochat-default/tolerances.json`, and stay unchanged when a second
# fabricated model spec is built in a temporary directory (the second model is
# not committed: section 2 keeps it out of scope). Step 3 is the isolation
# proof, and it needs no GPU: the CPU-only path is the whole gate.
cc_test(
    name = "model_isolation_test",
    srcs = ["model_isolation_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    data = [
        # The model package: its spec, its tolerance contract, and its fixtures.
        "//models/nanochat-default:files",
        # The generator's home for the same bytes this release. The two
        # directories coexist; neither is moved and neither is rewritten.
        "data/core_eval.bin",
        "data/debug_state.bin",
        "data/generate_parity.bin",
        "data/numerics_golden_10l.bin",
        "data/numerics_golden_10l_fp8.bin",
        "data/rl_parity.bin",
        "data/train_parity.bin",
    ],
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        # The fabricated second model goes through the real spec reader and the
        # real derivation, so a rename cannot pass as a second model.
        "//src:model_spec",
        # tolerances.json and the manifest are JSON: one reader for both.
        "//src:json",
    ],
    size = "small",
)

# The two generated artifacts as *checks* (docs/model-and-device-bringup.md
# sections 11 and 10.4): the model/device conformance matrix is derived, so a
# hand-added row fails with the offending label named; and the cross-package
# isolation gate fails with the offending fixture and record named. Both
# scripts travel in the runfiles, and both run in check mode against the
# committed tree, so the suite writes nothing into `models/` or `tests/`.
# Hermetic and CPU-only: the standard library, no torch, no GPU, no network.
py_test(
    name = "matrix_gate_test",
    srcs = ["matrix_gate_test.py"],
    data = [
        "//backends/cpu:caps_json",
        "//backends/cuda:caps_json",
        "//models/nanochat-default:files",
        # The isolation gate script and the fixture generator it drives.
        "//tools:isolation_gate",
        # The matrix generator's filegroup.
        "//tools:matrix",
    ],
    size = "small",
)

# The shared fp8 conversion gate (docs/correctness-gates.md section 3.2). The CPU
# reference backend and the emulation engine share `nanochat/fp8.h`, so this test
# pins the header against the format definition: known encodings, the round trip,
# the tie rule, saturation, and the sign. Vendor-free and GPU-free, so it runs in
# the default T0 loop and carries the `sim` tag.
cc_test(
    name = "fp8_rounding_test",
    srcs = ["fp8_rounding_test.cc"],
    copts = nanochat_copts(),
    deps = ["//include/nanochat:nanochat"],
    size = "small",
    tags = ["sim"],
)

# The scaled fp8 seam gate (docs/correctness-gates.md section 3.3). It drives
# `QuantizeFp8` and `GemmScaledFp8` on the CPU reference backend against an
