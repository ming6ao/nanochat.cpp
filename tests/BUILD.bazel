        "//backends/cpu:cpu",
        "//include/nanochat:nanochat",
        "//tools/cuda_sim/emu:emulated_kernels",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the collective path. Four rank processes run the NCCL mock, and
# the run must end with the elementwise sum on every rank; a rank that skips
# the all-reduce must be reported as a timeout, not a hang (docs/simulator.md
# section 12.3). CPU only.
cc_test(
    name = "collective_sim_test",
    srcs = ["collective_sim_test.cc"],
    copts = nanochat_copts(),
    deps = [
        "//include/nanochat:nanochat",
        "//tools/cuda_sim/collective:nccl_mock",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the API interposer, exercised in process. This is a *mock unit*
# test: it links //tools/cuda_sim:cuda_sim_interposer_impl directly and drives
# the mock's own entry points, asserting the named semantic invariants of
# docs/simulator.md section 12.2. It is not a binding test -- nothing here
# links the CUDA backend or exercises `LD_PRELOAD`; that is
# //tests:cuda_sim_preload_test, run by `tools/nanochat simulate --suite api`.
# CPU only; no GPU, driver, or toolkit.
cc_test(
    name = "cuda_sim_test",
    srcs = ["cuda_sim_test.cc"],
    copts = nanochat_copts(),
    deps = [
        "//include/nanochat:nanochat",
        "//tools/cuda_sim:cuda_sim_interposer_impl",
    ],
    size = "small",
    tags = ["sim"],
)

# Simulator: the real interposition path. Unlike `cuda_sim_test`, this links
# the *real* CUDA backend (device.cu + gemm.cu) and is run with
# `LD_PRELOAD=libcuda_sim_interposer.so`, so the calls below are bound to the
# mock by the dynamic linker. It drives `kernels::GetCaps`, the memory calls,
# both GEMM paths, and `Synchronize`, then asserts the mock's JSON log. It is
# `manual` because it must only run under `tools/nanochat simulate --suite api`,
# which supplies `LD_PRELOAD`, `NANOCHAT_SIM_LOG`, and `NANOCHAT_SIM_PROFILE`.
cc_test(
    name = "cuda_sim_preload_test",
    srcs = ["cuda_sim_preload_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda:cuda",
        "//include/nanochat:nanochat",
        # To derive the expected caps from the profile name the run simulates.
        "//src:device_profile",
    ],
    size = "small",
    tags = [
        "manual",
        "sim",
    ],
)

# The staged numeric trace of docs/numerics-integration.md. One source computes
# the whole trace (training, evaluation, greedy generation, the SFT arithmetic,
# and the RL arithmetic) as a flat list of named records; the emitter writes the
# committed golden file, and the two tests replay it. The library is shared so
# the emitter and the test cannot drift apart.
cc_library(
    name = "numerics_trace",
    srcs = ["numerics_trace.cc"],
    hdrs = ["numerics_trace.h"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":oracle_fixture",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# The golden-trace emitter, driven by `tools/dump_fixtures.py numerics`. It writes
# `tests/data/numerics_golden_10l.bin` from the fp32 CPU reference build; run it
# through `tools/nanochat run t0-cpu --`, never directly.
cc_binary(
    name = "numerics_trace_emit",
    srcs = ["numerics_trace_emit_main.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":numerics_trace",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
)

# The numeric-trace replay gate (docs/numerics-integration.md): the CPU trace
# must equal the committed golden byte for byte, and `tools/nanochat simulate
# --suite correctness` runs this same target under `--config=sim` as the
# regression guard (section 2.2). A 10-layer run with double GEMM over five
# steps is the slow part, so the target carries `manual` and stays out of the
# default test loop; run it as `tools/nanochat test //tests:numerics_trace_test`
# or through the simulator correctness suite.
cc_test(
    name = "numerics_trace_test",
    srcs = ["numerics_trace_test.cc"],
    # The exactness intent belongs to the target, not to a backend define: this
    # target must reproduce the golden byte for byte, on the reference CPU
    # backend and on the same backend under `--config=sim`.
    copts = nanochat_copts() + ["-DNANOCHAT_TRACE_EXACT"],
    defines = precision_defines(),
    # One golden per precision. The fp8 build reproduces the fp8 golden exactly;
    # a build whose precision has no golden yet is passed the fp32 file and
    # prints a skip.
    data = [
        "data/loader_tokenizer.nctoken",
    ] + select({
        "//:fp8": ["data/numerics_golden_10l_fp8.bin"],
        "//conditions:default": ["data/numerics_golden_10l.bin"],
    }),
    args = select({
        "//:fp8": ["$(rootpath data/numerics_golden_10l_fp8.bin)"],
        "//conditions:default": ["$(rootpath data/numerics_golden_10l.bin)"],
    }) + [
        "$(rootpath data/loader_tokenizer.nctoken)",
    ],
    deps = [
        ":numerics_trace",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "medium",
    # The trace pins the host thread count to one for determinism, so a
    # ten-layer run with double GEMM over five steps exceeds the medium
    # timeout on the two-CPU sandbox.
    timeout = "long",
    tags = [
        "manual",
        "sim",
    ],
)

# Same gate on the CUDA backend: the scalars must match the golden within the
# measured tolerance table and the greedy identifiers must match exactly. The
# parameter and gradient hashes are skipped (atomic scatter-adds change the
# bytes by design). `gpu` keeps it out of the default loop, and
# `tools/nanochat test --gpu` discovers it.
cc_test(
    name = "numerics_trace_cuda_test",
    srcs = ["numerics_trace_test.cc"],
    copts = _BACKEND_COPTS + nanochat_copts(),
    defines = precision_defines(),
    data = [
        "data/loader_tokenizer.nctoken",
    ] + select({
        "//:fp8": ["data/numerics_golden_10l_fp8.bin"],
        "//conditions:default": ["data/numerics_golden_10l.bin"],
    }),
    args = select({
        "//:fp8": ["$(rootpath data/numerics_golden_10l_fp8.bin)"],
        "//conditions:default": ["$(rootpath data/numerics_golden_10l.bin)"],
    }) + [
        "$(rootpath data/loader_tokenizer.nctoken)",
    ],
    deps = [
        ":numerics_trace",
        "//include/nanochat:nanochat",
        "//src:model",
    ],
    size = "small",
    tags = [
        "gpu",
    ],
)

