# nanochat.cpp — Bazel module graph. See docs/build.md.
#
# The build is Bazel-first: fine-grained targets map to kernel families and the
# action cache keeps parallel work from rebuilding the world. This module wires
# the CUDA rule set and config settings; the per-directory BUILD files supply
# the targets and load their shared options from //:nanochat.bzl.

module(
    name = "nanochat_cpp",
    version = "0.0.1",
)

# rules_cc is declared directly because Bazel 9 removed the native cc_*
# autoloads; the version matches the minimum Bazel 9 resolves transitively
# (protobuf 33.4 pulls rules_cc 0.2.17).
bazel_dep(name = "rules_cc", version = "0.2.17")

# Shell rules for the tools/ host tests. Bazel 8 removed the native sh_* rules
# and Bazel 9 removed the remaining autoloads, so declare the rule set directly,
# as with rules_cc.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Python rules for the py_test coverage of the Python API (docs/python.md).
# The module is already in the graph transitively through rules_cuda/protobuf;
# it is declared directly so the root module can register a toolchain.
bazel_dep(name = "rules_python", version = "1.7.0")

# ZSTD decompresses the parquet data pages. It is a small C library and the
# only decompressor the native reader needs (docs/parquet-native.md). The
# module comes from the Bazel Central Registry; the target is @zstd//:zstd.
bazel_dep(name = "zstd", version = "1.5.7")

# CUDA kernel rules (cuda_library / cuda_binary / cuda_test) plus the
# local-toolkit toolchain. The Debian/Ubuntu toolkit is detected in place, so
# the empty toolkit_path is intentional; CUDA_HOME does not have to point at an
# NVIDIA installer layout.
bazel_dep(name = "rules_cuda", version = "0.3.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "",
)
use_repo(cuda, "cuda")

register_toolchains("@cuda//toolchain:nvcc-local-toolchain")

# NCCL is a system library. The repository rule in //third_party locates it. A
# CUDA build selects //backends/cuda:nccl_sync, which needs this repository; a
# CPU build never reaches it (docs/distributed-plan.md phases 0 and 1).
nccl_repository = use_repo_rule("//third_party:nccl.bzl", "nccl_repository")

nccl_repository(name = "nccl")

# libibverbs for the native collective's RDMA transport
# (docs/distributed-native-plan.md phase 0). The repository is scaffolding: no
# target depends on it by default, because the transport selection falls back to
# host staging when no RDMA adapter is present.
rdma_repository = use_repo_rule("//third_party:rdma.bzl", "rdma_repository")

rdma_repository(name = "rdma")

# Python toolchain for the API tests. The `nanochat_cpp` package imports only
# the standard library, so the system `python3` is enough and no hermetic
# runtime is downloaded. `local_runtime_repo` introspects that interpreter and
# `local_runtime_toolchains_repo` turns the result into a full toolchain.
# `dev_dependency` keeps the local toolchain out of any downstream module.
local_runtime_repo = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_repo",
)

local_runtime_toolchains_repo = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_toolchains_repo",
)

local_runtime_repo(
    name = "local_python3",
    interpreter_path = "python3",
    on_failure = "fail",
    dev_dependency = True,
)

local_runtime_toolchains_repo(
    name = "local_toolchains",
    runtimes = ["local_python3"],
    dev_dependency = True,
)

register_toolchains("@local_toolchains//:all", dev_dependency = True)
