#!/usr/bin/env bash
# nanochat — the single execution entry point.
#
# usage: tools/nanochat <command> [args...]
#
# Every test, training, eval, benchmark, and verification run goes through here
# so the resource sandbox, the GPU broker, and the Bazel test wiring are chosen
# once and cannot be assembled incorrectly. Run `tools/nanochat help` for the
# command list. See docs/sandbox.md and docs/testing.md.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/.." && pwd)
sandbox="$here/sandbox.sh"
broker="$here/gpu.sh"

usage() {
  cat <<'EOF'
tools/nanochat <command> [args...]

  build [targets...]         bazel build (default //...; serialized)
  test [--gpu] [--config NAME] [targets...]
                             run tests; every test is sandboxed per action
  check [--gpu]              build, then CPU tests (and GPU tests with --gpu)
  lint [file...]             style gate: clang-format + the text checks
  shutdown                   stop this workspace's Bazel server now
  prune [--apply] [--worktree DIR]
                             reap orphaned Bazel output bases (dry run by
                             default); see docs/sandbox.md
  run <profile> -- <cmd...>  run a command under a sandbox profile
  train -- <cmd...>          alias for: run train -- <cmd...>
  rl    -- <cmd...>          alias for: run train -- <cmd...>
  eval  -- <cmd...>          alias for: run eval  -- <cmd...>
  bench -- <cmd...>          alias for: run t3-bench -- <cmd...>
  profile [opts]             build + run the attention benchmark under the GPU broker
  doctor [--json]            print environment, device, sandbox, and lock state
  simulate [--device NAME] [--precision fp32|fp16] [--suite S] [--mode compile]
                             S0 CPU-only simulator (no GPU, no broker); see
                             docs/simulator.md. Suites: correctness api
                             collective kernel profile all (default all)
                             `correctness` also carries the staged numeric
                             trace (docs/numerics-integration.md)
  verify -- <cmd...>         alias for: run t2-parity -- <cmd...>
  gpu [--profile P] -- <cmd> acquire the GPU broker, then run
  help                       this message

Profiles: t0-cpu t1-gpu t2-parity t3-bench train eval
Profile budgets: tools/sandbox/profiles.conf
EOF
}

die() {
  echo "nanochat: $*" >&2
  exit 2
}

# Bazel itself does not read .bazelversion; Bazelisk does. Prefer Bazelisk so
# the version pinned in .bazelversion is honored, and fall back to a system
# `bazel` otherwise. See docs/build.md.
if command -v bazelisk >/dev/null 2>&1; then
  bazel_bin=$(command -v bazelisk)
else
  bazel_bin=$(command -v bazel || true)
fi
[[ -n $bazel_bin ]] || die "neither bazelisk nor bazel found on PATH"

# Serialize builds across worktrees. Every worktree and verifier gets its own
# Bazel output base, hence its own persistent server with its own action pool;
# running several at once multiplies the per-server memory budget and has
# exhausted the shared host. The lock lives on this shell's descriptor 9 and is
# closed on the child (9>&-) so the detached Bazel server cannot inherit it --
# that inheritance is what deadlocked the GPU broker before. Idle servers are
# reaped by `startup --max_idle_secs` in .bazelrc; `tools/nanochat shutdown`
# reaps one immediately. Set NANOCHAT_BUILD_LOCK to override the path.
build_lock=${NANOCHAT_BUILD_LOCK:-/tmp/nanochat-build.lock}
with_build_lock() {
  exec 9>"$build_lock"
  flock 9
  "$@" 9>&-
}

run_profile() { # profile [--] cmd...
  local profile=$1
  shift
  [[ ${1:-} == "--" ]] && shift
  (( $# )) || die "no command given; use: tools/nanochat run $profile -- <cmd...>"
  exec "$sandbox" --profile "$profile" -- "$@"
}

(( $# )) || {
  usage
  exit 2
}
command=$1
shift

case "$command" in
  help | -h | --help)
    usage
    ;;

  build)
    # Bounded by the resource flags in .bazelrc; serialized so concurrent
    # worktrees do not each run their own action pool at full width. With no
    # arguments build the whole tree; otherwise build the named targets (so a
    # caller can build just //src:train_main).
    if (( $# )); then
      with_build_lock "$bazel_bin" build "$@"
    else
      with_build_lock "$bazel_bin" build //...
    fi
    ;;

  shutdown)
    # Release this workspace's Bazel server memory now instead of waiting for
    # the idle timeout. Safe: it only stops the server, not the action cache.
    exec "$bazel_bin" shutdown
    ;;

  prune)
    # Reap output bases left behind by removed worktrees. Each worktree is a
    # distinct workspace, so Bazel gives it a persistent output base keyed by
    # the workspace path. Dry run by default; pass --apply to remove. See
    # docs/sandbox.md, "Reaping Bazel output bases".
    exec "$here/prune_bazel_output_bases" "$@"
    ;;

  test)
    gpu=0
    targets=()
    configs=()
    while (( $# )); do
      case "$1" in
        --gpu)
          gpu=1
          shift
          ;;
        --config)
          configs+=(--config "${2:?--config needs a name}")
          shift 2
          ;;
        --config=*)
          configs+=("--config=${1#--config=}")
          shift
          ;;
        *)
          targets+=("$1")
          shift
          ;;
      esac
    done
    (( ${#targets[@]} )) || targets=(//...)
    if (( gpu )); then
      profile=t1-gpu
      tag_filter=gpu
    else
      profile=t0-cpu
      tag_filter=-gpu
    fi
    # --run_under sandboxes each test action; --spawn_strategy=local is required
    # so the wrapper can reach the systemd user manager and /sys/fs/cgroup.
    bazel_args=(
      "${targets[@]}"
      "--test_tag_filters=$tag_filter"
      "--run_under=$sandbox --profile=$profile --"
      --spawn_strategy=local
      "${configs[@]}"
    )
    if (( gpu )); then
      # A GPU run selects the CUDA backend so the shared workflow (//src:model)
      # links the kernels under test instead of the CPU reference.
      bazel_args+=(--config=cuda)
    fi
    if (( gpu )); then
      # Hold the single-GPU lock for the whole suite, and the build lock while
      # the suite's targets compile.
      with_build_lock "$broker" --lock-only --profile "$profile" -- \
        "$bazel_bin" test "${bazel_args[@]}"
    else
      with_build_lock "$bazel_bin" test "${bazel_args[@]}"
    fi
    ;;

  check)
    gpu=0
    [[ ${1:-} == "--gpu" ]] && {
      gpu=1
      shift
    }
    "$0" build
    "$0" test
    if (( gpu )); then
      "$0" test --gpu
    fi
    ;;

  run)
    (( $# )) || die "run needs a profile"
    profile=$1
    shift
    run_profile "$profile" "$@"
    ;;

  lint)
    # Style gate for the Google C++ Style Guide. Fast and CPU-only: it runs
    # clang-format in check mode plus the cheap text checks. See
    # CONTRIBUTING.md and docs/testing.md.
    exec "$here/lint.sh" "$@"
    ;;

  train) run_profile train "$@" ;;
  rl) run_profile train "$@" ;;
  eval) run_profile eval "$@" ;;
  bench) run_profile t3-bench "$@" ;;

  profile)
    # Standard performance battery: build the attention benchmark, then run it
    # under the exclusive benchmark profile with the GPU broker held. Extra
    # arguments pass through to the binary (--json, --out PATH, --iters N,
    # --rounds N). Use this instead of `bench` when timing must be exclusive.
    with_build_lock "$bazel_bin" build //backends/cuda/kernels:attention_benchmark
    exec 9>&-
    exec "$broker" --profile t3-bench -- \
      "$root/bazel-bin/backends/cuda/kernels/attention_benchmark" "$@"
    ;;

  doctor)
    # Read-only diagnostics so an agent can distinguish slow code from a busy
    # or misconfigured host before spending time measuring. See
    # docs/performance.md. `--json` emits one JSON object that the Python
    # orchestration layer parses (docs/python.md section 6).
    doctor_json=0
    if [[ ${1:-} == "--json" ]]; then
      doctor_json=1
      shift
    fi
    d_repo=$root
    d_revision=""
    d_branch=""
    if git -C "$root" rev-parse --short HEAD >/dev/null 2>&1; then
      d_revision=$(git -C "$root" rev-parse --short HEAD)
      d_branch=$(git -C "$root" branch --show-current 2>/dev/null || true)
    fi
    if command -v nvcc >/dev/null 2>&1; then
      d_nvcc=$(nvcc --version 2>/dev/null | grep -o 'release [0-9.]*' \
        | head -1 || true)
    else
      d_nvcc="NOT FOUND"
    fi
    if command -v bazelisk >/dev/null 2>&1; then
      d_bazel=$(bazelisk version 2>/dev/null | head -1 || true)
    else
      d_bazel=""
    fi
    if command -v nvidia-smi >/dev/null 2>&1; then
      d_gpu=$(nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used,utilization.gpu --format=csv,noheader 2>/dev/null | head -1 || true)
      d_gpu_procs=$(nvidia-smi --query-compute-apps=pid,process_name --format=csv,noheader 2>/dev/null | paste -sd'; ' - || true)
    else
      d_gpu="nvidia-smi NOT FOUND"
      d_gpu_procs=""
    fi
    d_sandbox=""
    slice=$(systemctl --user show nanochat.slice -p MemoryCurrent -p MemoryMax -p CPUQuotaPerSecUSec 2>/dev/null || true)
    if [[ -n $slice ]]; then
      d_sandbox=$(echo "$slice" | paste -sd' ' -)
    fi
    # The simulator's S0 tier is CPU-only and takes no broker. The profile name
    # is a build-time capability override, so it is worth reporting beside the
    # device: a run with it set computes on the reference backend as the named
    # target (docs/simulator.md section 10).
    d_sim="${NANOCHAT_SIM_PROFILE:-unset}"
    if [[ -n ${NANOCHAT_SANDBOX_BACKEND:-} ]]; then
      d_sandbox_backend=$NANOCHAT_SANDBOX_BACKEND
    elif systemd-run --user --scope --quiet true >/dev/null 2>&1; then
      d_sandbox_backend=systemd
    else
      d_sandbox_backend="none (systemd unavailable)"
    fi
    # The broker keeps one lock per device set, so probe the same path that
    # tools/gpu.sh locks. See docs/host-portability.md section 5.
    gpu_devices=${NANOCHAT_GPU_DEVICES:-0}
    gpu_lock="/tmp/nanochat-gpu-${gpu_devices//,/_}.lock"
    d_gpu_lock=""
    if [[ -e $gpu_lock ]]; then
      if flock -n "$gpu_lock" -c true 2>/dev/null; then
        d_gpu_lock=free
      else
        d_gpu_lock="HELD (another job is running)"
      fi
    fi

    if (( doctor_json )); then
      NANOCHAT_DOCTOR_repo="$d_repo" \
      NANOCHAT_DOCTOR_revision="$d_revision" \
      NANOCHAT_DOCTOR_branch="$d_branch" \
      NANOCHAT_DOCTOR_nvcc="$d_nvcc" \
      NANOCHAT_DOCTOR_bazel="$d_bazel" \
      NANOCHAT_DOCTOR_gpu="$d_gpu" \
      NANOCHAT_DOCTOR_gpu_procs="$d_gpu_procs" \
      NANOCHAT_DOCTOR_sandbox="$d_sandbox" \
      NANOCHAT_DOCTOR_sandbox_backend="$d_sandbox_backend" \
      NANOCHAT_DOCTOR_gpu_lock="$d_gpu_lock" \
      NANOCHAT_DOCTOR_sim="$d_sim" \
      python3 - <<'PY'
import json, os
keys = ("repo", "revision", "branch", "nvcc", "bazel", "gpu", "gpu_procs",
        "sandbox", "sandbox_backend", "gpu_lock", "sim")
print(json.dumps({key: os.environ.get("NANOCHAT_DOCTOR_" + key, "")
                  for key in keys}))
PY
    else
      echo "nanochat.cpp doctor"
      echo "===================="
      echo "repo:      $d_repo"
      if [[ -n $d_revision ]]; then
        echo "revision:  $d_revision (${d_branch:-detached})"
      fi
      echo "nvcc:      $d_nvcc"
      [[ -n $d_bazel ]] && echo "bazel:     $d_bazel"
      echo "gpu:       $d_gpu"
      [[ -n $d_gpu_procs ]] && echo "gpu procs: $d_gpu_procs"
      [[ -n $d_sandbox ]] && echo "sandbox:   $d_sandbox"
      echo "sandbox backend: $d_sandbox_backend"
      echo "sim profile: $d_sim"
      [[ -n $d_gpu_lock ]] && echo "gpu lock:  $d_gpu_lock"
      for log in /tmp/nanochat-gpu.log /tmp/nanochat-sandbox.log; do
        [[ -f $log ]] || continue
        echo "--- tail $log ---"
        tail -n 5 "$log"
      done
      for binary in "$root/bazel-bin/src/train_main" \
                    "$root/bazel-bin/backends/cuda/kernels/attention_benchmark"; do
        [[ -e $binary ]] || continue
        echo "built:     $binary ($(date -r "$binary" '+%Y-%m-%d %H:%M'))"
      done
    fi
    ;;
  verify) run_profile t2-parity "$@" ;;

  simulate)
    # The S0 simulator (docs/simulator.md section 10). Every suite is CPU-only:
    # the reference engine computes on the CPU backend under a capability
    # override, the API interposer records runtime and cuBLAS calls, the
    # collective mock runs the gradient-sync seam over four rank processes, and
    # the emulation engine runs the real device kernels on the host. None of
    # them touches the GPU, so this command takes the build lock and never the
    # GPU broker.
    sim_mode=run
    sim_device=h100
    sim_precision=""
    sim_suite=all
    while (( $# )); do
      case "$1" in
        --device) sim_device=${2:?--device needs a name}; shift 2 ;;
        --device=*) sim_device=${1#--device=}; shift ;;
        --precision) sim_precision=${2:?--precision needs a value}; shift 2 ;;
        --precision=*) sim_precision=${1#--precision=}; shift ;;
        --suite) sim_suite=${2:?--suite needs a name}; shift 2 ;;
        --suite=*) sim_suite=${1#--suite=}; shift ;;
        --mode) sim_mode=${2:?--mode needs a value}; shift 2 ;;
        --mode=*) sim_mode=${1#--mode=}; shift ;;
        *) die "simulate: unknown argument '$1'" ;;
      esac
    done
    case "$sim_device" in
      h100|h200|a100|t4|gtx1080ti) ;;
      *) die "simulate: unknown device '$sim_device' (h100 h200 a100 t4 gtx1080ti)" ;;
    esac
    # The compile gate uses the device's named target, matching build:h100 and
    # build:h200 in .bazelrc. A numerical run defaults to fp32: the committed
    # oracle and training-parity fixtures are the fp32 CPU case, and the fp16
    # CPU build records its own looser tolerance (docs/testing.md), so
    # `--precision fp16` is explicit rather than implied by the device name.
    if [[ -z $sim_precision ]]; then
      if [[ $sim_mode == compile && $sim_device == h200 ]]; then
        sim_precision=fp16
      else
        sim_precision=fp32
      fi
    fi
    case "$sim_precision" in
      fp32|fp16) ;;
      *) die "simulate: unknown precision '$sim_precision' (fp32 fp16)" ;;
    esac

    if [[ $sim_mode == compile ]]; then
      # The compile gate (section 8): build the whole CUDA backend for the
      # target architecture under --config=sim-gate, so warnings become errors
      # and ptxas reports the register and shared-memory use. No GPU and no
      # broker; the build lock serializes it against every other build.
      #
      # The aggregate library alone carries no actions, so the gate also builds
      # the binaries that link the whole backend: those compile and link every
      # kernel family and the runtime for the target architecture.
      ptxas_log=${NANOCHAT_SIM_PTXAS_LOG:-/tmp/nanochat-sim-ptxas-${sim_device}.log}
      gate_log=$(mktemp)
      gate_status=0
      with_build_lock "$bazel_bin" build \
        --config="$sim_device" --config=sim-gate \
        //backends/cuda:all_kernels \
        //backends/cuda/collective:native_sync \
        //backends/cuda:cuda_runtime_gpu_test \
        //backends/cuda/kernels:precision_gpu_test \
        //backends/cuda/kernels:row_kernels_gpu_test \
        //backends/cuda/kernels:sequence_oracle_gpu_test \
        > "$gate_log" 2>&1 || gate_status=$?
      if (( gate_status != 0 )); then
        cat "$gate_log" >&2
        rm -f "$gate_log"
        exit "$gate_status"
      fi
      # Keep the ptxas resource lines for the record. Bazel prints the compiler
      # stderr as INFO lines when it carries a diagnostic. A cached build
      # compiles nothing, so keep the previous log rather than erase it.
      fresh_log=$(mktemp)
      grep -E "ptxas info|Used [0-9]+ registers" "$gate_log" \
        > "$fresh_log" 2>/dev/null || true
      fresh_count=$(grep -cE "Used [0-9]+ registers" "$fresh_log" 2>/dev/null || true)
      : "${fresh_count:=0}"
      if (( fresh_count > 0 )); then
        mv "$fresh_log" "$ptxas_log"
        record_count=$fresh_count
        record_note=fresh
      elif [[ -s $ptxas_log ]]; then
        rm -f "$fresh_log"
        record_count=$(grep -cE "Used [0-9]+ registers" "$ptxas_log" 2>/dev/null || true)
        : "${record_count:=0}"
        record_note="build cached; kept the previous log"
      else
        rm -f "$fresh_log"
        record_count=0
        record_note="build cached and no earlier log"
      fi
      echo "simulate: compile gate OK ($sim_device, -Werror, ptxas records: $record_count; $record_note)"
      echo "simulate: ptxas resource log -> $ptxas_log"
      rm -f "$gate_log"
      exit 0
    fi
    [[ $sim_mode == run ]] || die "simulate: unknown mode '$sim_mode' (run compile)"

    # The API suite is the only one that interposes over the real CUDA
    # backend: build the preloadable mock and a CUDA-linked test, check the
    # symbol gate against a real CUDA binary, then run the test with
    # `LD_PRELOAD` pointing at the mock. No GPU broker: the preloaded mock
    # serves memory from the host and never calls the real runtime.
    if [[ $sim_suite == api || $sim_suite == all ]]; then
      with_build_lock "$bazel_bin" build --config=cuda \
        //tools/cuda_sim:cuda_sim_interposer \
        //backends/cuda:cuda_runtime_gpu_test \
        //tests:cuda_sim_preload_test
      mock_so=$(readlink -f "$root/bazel-bin/tools/cuda_sim/libcuda_sim_interposer.so")
      real_bin=$(readlink -f "$root/bazel-bin/backends/cuda/cuda_runtime_gpu_test")
      [[ -f $mock_so ]] || die "simulate: the interposer .so was not built ($mock_so)"
      [[ -f $real_bin ]] || die "simulate: $real_bin was not built"
      # The symbol gate: the mock itself, a real CUDA-linked binary, and the
      # negative case (a missing symbol must be rejected).
      "$here/cuda_sim/check_symbols.sh"
      "$here/cuda_sim/check_symbols.sh" "$real_bin"
      "$here/cuda_sim/check_symbols.sh" --negative-self-test
      sim_log=$(mktemp "${TMPDIR:-/tmp}/nanochat-sim-api.XXXXXX.jsonl")
      trap 'rm -f "$sim_log"' EXIT
      with_build_lock "$bazel_bin" test //tests:cuda_sim_preload_test \
        --config=cuda \
        --test_tag_filters=sim \
        "--run_under=$sandbox --profile=t0-cpu --" \
        --spawn_strategy=local \
        "--test_env=NANOCHAT_SIM_PROFILE=$sim_device" \
        "--test_env=LD_PRELOAD=$mock_so" \
        "--test_env=NANOCHAT_SIM_LOG=$sim_log"
      # The in-process mock unit test: same mock, no preload (it links the mock
      # directly). Kept beside the preload run so the suite covers both halves.
      with_build_lock "$bazel_bin" test //tests:cuda_sim_test \
        --test_tag_filters=sim \
        "--run_under=$sandbox --profile=t0-cpu --" \
        --spawn_strategy=local \
        "--test_env=NANOCHAT_SIM_PROFILE=$sim_device"
    fi
    [[ $sim_suite == api ]] && exit 0

    case "$sim_suite" in
      correctness) sim_targets=(//tests:oracle_test //tests:train_parity_test
                                //tests:sim_numerics_test
                                //tests:numerics_trace_test) ;;
      collective) sim_targets=(//tests:collective_sim_test) ;;
      kernel) sim_targets=(//tests:kernel_emu_test) ;;
      profile) sim_targets=(//tests:device_profile_test) ;;
      all) sim_targets=(//tests:oracle_test //tests:train_parity_test
                        //tests:sim_numerics_test //tests:numerics_trace_test
                        //tests:collective_sim_test
                        //tests:kernel_emu_test //tests:device_profile_test) ;;
      *) die "simulate: unknown suite '$sim_suite'" ;;
    esac

    sim_configs=(--config=sim)
    [[ $sim_precision == fp16 ]] && sim_configs+=(--config=fp16)
    # The reference-engine suites assert the override is live under
    # `--config=sim`, so the profile name must reach the test process.
    with_build_lock "$bazel_bin" test \
      "${sim_targets[@]}" \
      --test_tag_filters=-gpu \
      "--run_under=$sandbox --profile=t0-cpu --" \
      --spawn_strategy=local \
      "--test_env=NANOCHAT_SIM_PROFILE=$sim_device" \
      "${sim_configs[@]}"
    ;;

  gpu)
    exec "$broker" "$@"
    ;;

  *)
    die "unknown command '$command' (try: tools/nanochat help)"
    ;;
esac
