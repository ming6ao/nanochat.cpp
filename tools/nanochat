#!/usr/bin/env python3
"""The nanochat.cpp execution entry point.

Every test, training run, evaluation, benchmark, and verification run starts
here, so the resource sandbox, the GPU queue, and the Bazel wiring are chosen
once and cannot be assembled incorrectly. The command table, the argument
assembly, the Bazel wiring, the build lock, and the sandbox and queue routing
live in ``python/nanochat_cpp/cli.py``. Run ``tools/nanochat help`` for the
command list.

The host tool needs Python 3.10 or later, which ``docs/build.md`` records.

This file keeps its name. ``include/nanochat/sandbox.h`` prints
``run: tools/nanochat help``, and every document names the path.
"""

from __future__ import annotations

import sys
from pathlib import Path

# This file lives at <repo>/tools/nanochat; the package lives under
# <repo>/python. Put that on the path, so the tool runs from any directory.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))

from nanochat_cpp import cli  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    """Run one command. ``cli.main`` reports an argument error as code 2."""
    return cli.main(sys.argv[1:] if argv is None else argv)


if __name__ == "__main__":
    raise SystemExit(main())
