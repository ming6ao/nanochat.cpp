#!/usr/bin/env bash
# nanochat — the single execution entry point.
#
# usage: tools/nanochat <command> [args...]
#
# Every test, training, eval, benchmark, and verification run goes through here
# so the resource sandbox, the GPU queue, and the Bazel test wiring are chosen
# once and cannot be assembled incorrectly. Run `tools/nanochat help` for the
# command list. See docs/sandbox.md, docs/testing.md, and docs/gpu-queue-plan.md.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/.." && pwd)
sandbox="$here/sandbox.sh"
self="$here/nanochat"

usage() {
  cat <<'EOF'
tools/nanochat <command> [args...]

  build [targets...]         bazel build (default //...; serialized)
  test [--gpu] [--config NAME] [targets...]
                             run tests; every test is sandboxed per action,
                             and every GPU action is submitted to the queue
  check [--gpu]              build, then CPU tests (and GPU tests with --gpu)
  lint [file...]             style gate: clang-format + the text checks
  shutdown                   stop this workspace's Bazel server now
  prune [--apply] [--worktree DIR]
                             reap orphaned Bazel output bases (dry run by
                             default); see docs/sandbox.md
  gpuq <action> [opts]       the GPU job queue: submit, list, status, wait,
                             logs, cancel, start, stop; see
                             docs/gpu-queue-plan.md
  run <profile> -- <cmd...>  run a command under a sandbox profile; a GPU
                             profile is submitted to the queue
  dist [opts] -- <cmd...>    one process per rank; one queue job for the
                             group; sets the NANOCHAT_* rank variables and
                             expands a `{rank}` token in the command. See
                             docs/distributed-launch.md
  client [opts] -- <cmd...>  one client process; one queue job for the full
                             device set; the client sees all local devices as
                             one mesh. See docs/client-runtime-design.md
  train -- <cmd...>          alias for: run train -- <cmd...>
  rl    -- <cmd...>          alias for: run train -- <cmd...>
  eval  -- <cmd...>          alias for: run eval  -- <cmd...>
  bench -- <cmd...>          alias for: run t3-bench -- <cmd...>
  profile [opts]             build + run the attention benchmark in the queue
  roofline [opts]            build + run the performance model (roofline bound)
                             CPU only, no GPU queue; see
                             docs/performance-model.md
  doctor [--json]            print environment, device, sandbox, and queue state
  simulate [--device NAME] [--suite S] [--mode compile] [--precision P]
                             S0 CPU-only simulator (no GPU, no queue); see
                             docs/simulator.md. Suites: correctness fp8-fast
                             api collective kernel profile all (default all)
                             `correctness` also carries the staged numeric
                             trace (docs/numerics-integration.md)
                             `fp8-fast` is the fast fp8 core
                             (docs/correctness-gates.md section 5.1)
                             Precision: fp32 (default) bf16 fp8
  verify -- <cmd...>         alias for: run t2-parity -- <cmd...>
  gpu [--profile P] -- <cmd> submit one job to the GPU queue
  help                       this message

Profiles: t0-cpu t1-gpu t2-parity t3-bench train eval
Profile budgets: tools/sandbox/profiles.conf
EOF
}

die() {
  echo "nanochat: $*" >&2
  exit 2
}

# True when the host has the NCCL headers and library. The CUDA backend's
# default collective is NCCL; the native ring is the fallback
# (docs/distributed-native-plan.md section 7). The prefixes match
# third_party/nccl.bzl.
have_nccl() {
  local prefixes=()
  [[ -n ${NANOCHAT_NCCL_PATH:-} ]] && prefixes+=("$NANOCHAT_NCCL_PATH")
  prefixes+=(/usr /usr/local /opt/nccl)
  local prefix
  for prefix in "${prefixes[@]}"; do
    [[ -f $prefix/include/nccl.h ]] && return 0
  done
  return 1
}

# Bazel itself does not read .bazelversion; Bazelisk does. Prefer Bazelisk so
# the version pinned in .bazelversion is honored, and fall back to a system
# `bazel` otherwise. See docs/build.md.
if command -v bazelisk >/dev/null 2>&1; then
  bazel_bin=$(command -v bazelisk)
else
  bazel_bin=$(command -v bazel || true)
fi
[[ -n $bazel_bin ]] || die "neither bazelisk nor bazel found on PATH"

# Serialize builds across worktrees. Every worktree and verifier gets its own
# Bazel output base, hence its own persistent server with its own action pool;
# running several at once multiplies the per-server memory budget and has
# exhausted the shared host. The lock lives on this shell's descriptor 9 and is
# closed on the child (9>&-) so the detached Bazel server cannot inherit it --
# that inheritance is what deadlocked the old GPU broker before. Idle servers
# are reaped by `startup --max_idle_secs` in .bazelrc; `tools/nanochat shutdown`
# reaps one immediately. Set NANOCHAT_BUILD_LOCK to override the path.
build_lock=${NANOCHAT_BUILD_LOCK:-/tmp/nanochat-build.lock}
with_build_lock() {
  exec 9>"$build_lock"
  flock 9
  "$@" 9>&-
}

run_profile() { # profile [--] cmd...
  local profile=$1
  shift
  [[ ${1:-} == "--" ]] && shift
  (( $# )) || die "no command given; use: tools/nanochat run $profile -- <cmd...>"
  exec "$sandbox" --profile "$profile" -- "$@"
}

# Submit a GPU job to the queue and wait for its exit code
# (docs/gpu-queue-plan.md). Inside a sandbox or a queued job the command runs
# directly: the queue already sandboxed it, and a nested scope is not useful.
submit_profile() { # profile [--] cmd...
  local profile=$1
  shift
  [[ ${1:-} == "--" ]] && shift
  (( $# )) || die "no command given; use: tools/nanochat run $profile -- <cmd...>"
  if [[ -n ${NANOCHAT_SANDBOX:-} || -n ${NANOCHAT_GPU_QUEUED:-} ]]; then
    exec "$@"
  fi
  exec "$self" gpuq submit --profile "$profile" -- "$@"
}

(( $# )) || {
  usage
  exit 2
}
command=$1
shift

case "$command" in
  help | -h | --help)
    usage
    ;;

  build)
    # Bounded by the resource flags in .bazelrc; serialized so concurrent
    # worktrees do not each run their own action pool at full width. With no
    # arguments build the whole tree; otherwise build the named targets (so a
    # caller can build just //src:train_main).
    if (( $# )); then
      with_build_lock "$bazel_bin" build "$@"
    else
      with_build_lock "$bazel_bin" build //...
    fi
    ;;

  shutdown)
    # Release this workspace's Bazel server memory now instead of waiting for
    # the idle timeout. Safe: it only stops the server, not the action cache.
    exec "$bazel_bin" shutdown
    ;;

  prune)
    # Reap output bases left behind by removed worktrees. Each worktree is a
    # distinct workspace, so Bazel gives it a persistent output base keyed by
    # the workspace path. Dry run by default; pass --apply to remove. See
    # docs/sandbox.md, "Reaping Bazel output bases".
    exec "$here/prune_bazel_output_bases" "$@"
    ;;

  test)
    gpu=0
    targets=()
    configs=()
    while (( $# )); do
      case "$1" in
        --gpu)
          gpu=1
          shift
          ;;
        --config)
          configs+=(--config "${2:?--config needs a name}")
          shift 2
          ;;
        --config=*)
          configs+=("--config=${1#--config=}")
          shift
          ;;
        *)
          targets+=("$1")
          shift
          ;;
      esac
    done
    (( ${#targets[@]} )) || targets=(//...)
    if (( gpu )); then
      profile=t1-gpu
      tag_filter=gpu
    else
      profile=t0-cpu
      tag_filter=-gpu
    fi
    # --run_under wraps each test action. A CPU action runs under the sandbox
    # directly. A GPU action submits to the queue instead: the worker applies
    # the sandbox and owns the device (docs/gpu-queue-plan.md section 3.4).
    # --spawn_strategy=local is required so the CPU wrapper can reach the
    # systemd user manager and /sys/fs/cgroup.
    if (( gpu )); then
      run_under="$self gpuq submit --profile=$profile --"
    else
      run_under="$sandbox --profile=$profile --"
    fi
    bazel_args=(
      "${targets[@]}"
      "--test_tag_filters=$tag_filter"
      "--run_under=$run_under"
      --spawn_strategy=local
      "${configs[@]}"
    )
    if (( gpu )); then
      # A GPU run selects the CUDA backend so the shared workflow (//src:model)
      # links the kernels under test instead of the CPU reference.
      bazel_args+=(--config=cuda)
      # One GPU test action at a time. The queue serializes the jobs anyway;
      # this keeps the Bazel side from holding many blocked wrappers.
      bazel_args+=(--local_test_jobs=1)
      # The bare `--config=cuda` selects the NCCL collective. Fall back to the
      # native ring when NCCL is absent, so the GPU tests build on a host
      # without it (docs/distributed-native-plan.md section 7).
      if ! have_nccl; then
        bazel_args+=(--config=native)
      fi
    fi
    with_build_lock "$bazel_bin" test "${bazel_args[@]}"
    ;;

  check)
    gpu=0
    [[ ${1:-} == "--gpu" ]] && {
      gpu=1
      shift
    }
    "$0" build
    "$0" test
    if (( gpu )); then
      "$0" test --gpu
    fi
    ;;

  run)
    (( $# )) || die "run needs a profile"
    profile=$1
    shift
    # t0-cpu needs no GPU, so it runs directly. A GPU profile is submitted to
    # the queue (docs/gpu-queue-plan.md section 7).
    if [[ $profile == t0-cpu ]]; then
      run_profile "$profile" "$@"
    else
      submit_profile "$profile" "$@"
    fi
    ;;

  gpuq)
    # The GPU job queue (docs/gpu-queue-plan.md). The worker owns the GPU and
    # runs the jobs in order. The client submits a job, waits, and returns the
    # job exit code.
    exec python3 "$root/python/nanochat_cpp/gpu_queue.py" "$@"
    ;;

  dist)
    # Data-parallel launch: one process per rank, one queue job and one
    # sandbox scope for the group (docs/distributed-launch.md). The command is
    # identical for every rank; the rank values travel in the environment and a
    # `{rank}` token in an argument expands to the rank index. Rank 0 starts
    # first so it wins the port bind race. See docs/distributed-launch.md.
    nproc=2
    device=""
    device_given=0
    dist_profile=train
    master=127.0.0.1
    port=29500
    log_dir=""
    dist_json=0
    cmd=()
    while (( $# )); do
      case "$1" in
        --nproc-per-node)
          nproc=${2:?--nproc-per-node needs a value}
          shift 2
          ;;
        --device)
          device=${2:?--device needs a value}
          device_given=1
          shift 2
          ;;
        --profile)
          dist_profile=${2:?--profile needs a value}
          shift 2
          ;;
        --master)
          master=${2:?--master needs a value}
          shift 2
          ;;
        --port)
          port=${2:?--port needs a value}
          shift 2
          ;;
        --log-dir)
          log_dir=${2:?--log-dir needs a value}
          shift 2
          ;;
        --json)
          dist_json=1
          shift
          ;;
        --)
          shift
          cmd=("$@")
          break
          ;;
        *) die "dist: unknown option $1" ;;
      esac
    done
    (( ${#cmd[@]} )) || die "dist: no command given; use: tools/nanochat dist -- <cmd...>"
    (( nproc >= 1 )) || die "dist: --nproc-per-node must be >= 1"
    if [[ -z $device && -n ${NANOCHAT_GPU_DEVICES:-} ]]; then
      # The worker owns the pool. Take the first nproc devices from it
      # (docs/gpu-queue-plan.md section 4.2).
      IFS=',' read -ra pool <<< "$NANOCHAT_GPU_DEVICES"
      (( ${#pool[@]} >= nproc )) || \
        die "dist: the worker assigned ${#pool[@]} device(s), need $nproc"
      device=$(IFS=,; echo "${pool[*]:0:nproc}")
    fi
    if [[ -z $device ]]; then
      device=$(seq -s, 0 $((nproc - 1)))
    fi
    IFS=',' read -ra devices <<< "$device"
    (( ${#devices[@]} == nproc )) || \
      die "dist: --device has ${#devices[@]} entries, need $nproc"
    if [[ -z $log_dir ]]; then
      log_dir=$(mktemp -d /tmp/nanochat-dist.XXXXXX)
    fi
    mkdir -p "$log_dir"

    # One queue job for the whole rank group (docs/gpu-queue-plan.md section
    # 3.4). The worker sandboxes the launcher, and the ranks are its children,
    # so a rank does not take a nested scope. Kaggle has no queue, so skip when
    # the sandbox backend is `none` or the job is already queued.
    if [[ -z ${NANOCHAT_SANDBOX:-} && -z ${NANOCHAT_GPU_QUEUED:-} && \
          ${NANOCHAT_SANDBOX_BACKEND:-auto} != none ]]; then
      reexec=("$self" dist --nproc-per-node "$nproc"
              --profile "$dist_profile" --master "$master" --port "$port"
              --log-dir "$log_dir")
      (( device_given )) && reexec+=(--device "$device")
      (( dist_json )) && reexec+=(--json)
      exec "$self" gpuq submit --profile "$dist_profile" -- \
        "${reexec[@]}" -- "${cmd[@]}"
    fi

    # Inside a queued job the outer scope already applies the budget and the
    # CPU affinity, and the ranks inherit both.
    launcher=()
    if [[ -z ${NANOCHAT_GPU_QUEUED:-} ]]; then
      launcher=("$sandbox" --profile "$dist_profile" --)
    fi

    start=$(date +%s.%N)
    pids=()
    stdio_paths=()
    for ((rank = 0; rank < nproc; rank++)); do
      expanded=()
      for arg in "${cmd[@]}"; do
        expanded+=("${arg//\{rank\}/$rank}")
      done
      stdio="$log_dir/rank${rank}.stdio.log"
      stdio_paths+=("$stdio")
      CUDA_VISIBLE_DEVICES="${devices[$rank]}" \
        NANOCHAT_WORLD_SIZE="$nproc" \
        NANOCHAT_RANK="$rank" \
        NANOCHAT_LOCAL_RANK="$rank" \
        NANOCHAT_MASTER_ADDR="$master" \
        NANOCHAT_MASTER_PORT="$port" \
        "${launcher[@]}" "${expanded[@]}" \
        >"$stdio" 2>&1 &
      pids+=($!)
      # Rank 0 binds the rendezvous port; give it a moment before the peers
      # start so the connect does not race the bind.
      (( rank == 0 && nproc > 1 )) && sleep 0.5
    done

    codes=()
    for ((rank = 0; rank < nproc; rank++)); do
      if wait "${pids[$rank]}"; then
        codes[$rank]=0
      else
        codes[$rank]=$?
      fi
    done
    end=$(date +%s.%N)
    seconds=$(awk -v a="$start" -v b="$end" 'BEGIN { printf "%.3f", b - a }')
    rc=0
    for code in "${codes[@]}"; do
      if (( code != 0 )); then
        rc=$code
        break
      fi
    done

    if (( dist_json )); then
      printf '{"ranks":['
      for ((rank = 0; rank < nproc; rank++)); do
        (( rank > 0 )) && printf ','
        printf '{"rank":%d,"returncode":%d,"stdio":"%s","seconds":%s}' \
          "$rank" "${codes[$rank]}" "${stdio_paths[$rank]}" "$seconds"
      done
      printf ']}\n'
    else
      for ((rank = 0; rank < nproc; rank++)); do
        printf 'dist: rank %d exit %d (stdio %s)\n' \
          "$rank" "${codes[$rank]}" "${stdio_paths[$rank]}"
      done
    fi
    exit "$rc"
    ;;

  client)
    # Single-process multi-device client: one queue job for the full device
    # set, then one sandbox scope (docs/client-runtime-design.md section 14,
    # docs/gpu-queue-plan.md section 3.4). The client enumerates the devices
    # itself, so only CUDA_VISIBLE_DEVICES travels to the process. Without
    # --device, every local accelerator is selected.
    client_device=""
    client_device_given=0
    client_profile=train
    cmd=()
    while (( $# )); do
      case "$1" in
        --device)
          client_device=${2:?--device needs a value}
          client_device_given=1
          shift 2
          ;;
        --device=*)
          client_device=${1#--device=}
          client_device_given=1
          shift
          ;;
        --profile)
          client_profile=${2:?--profile needs a value}
          shift 2
          ;;
        --profile=*)
          client_profile=${1#--profile=}
          shift
          ;;
        --)
          shift
          cmd=("$@")
          break
          ;;
        *) die "client: unknown option $1" ;;
      esac
    done
    (( ${#cmd[@]} )) || die "client: no command given; use: tools/nanochat client -- <cmd...>"
    if [[ -z $client_device ]]; then
      if [[ -n ${NANOCHAT_GPU_DEVICES:-} ]]; then
        client_device=$NANOCHAT_GPU_DEVICES
      elif command -v nvidia-smi >/dev/null 2>&1; then
        client_device=$(nvidia-smi --query-gpu=index --format=csv,noheader \
          2>/dev/null | paste -sd, -)
        [[ -n $client_device ]] || client_device=0
      else
        client_device=0
      fi
    fi
    # One queue job for the whole device set. The worker owns the devices, so
    # the client does not name one. A per-device split would let two clients
    # split one model across the cards and corrupt the run.
    if [[ -z ${NANOCHAT_SANDBOX:-} && -z ${NANOCHAT_GPU_QUEUED:-} && \
          ${NANOCHAT_SANDBOX_BACKEND:-auto} != none ]]; then
      reexec=("$self" client --profile "$client_profile")
      (( client_device_given )) && reexec+=(--device "$client_device")
      exec "$self" gpuq submit --profile "$client_profile" -- \
        "${reexec[@]}" -- "${cmd[@]}"
    fi
    # Inside a queued job the outer scope already applies the budget.
    if [[ -n ${NANOCHAT_GPU_QUEUED:-} ]]; then
      exec "${cmd[@]}"
    fi
    exec "$sandbox" --profile "$client_profile" -- "${cmd[@]}"
    ;;

  lint)
    # Style gate for the Google C++ Style Guide. Fast and CPU-only: it runs
    # clang-format in check mode plus the cheap text checks. See
    # CONTRIBUTING.md and docs/testing.md.
    exec "$here/lint.sh" "$@"
    ;;

  train) submit_profile train "$@" ;;
  rl) submit_profile train "$@" ;;
  eval) submit_profile eval "$@" ;;
  bench) submit_profile t3-bench "$@" ;;

  profile)
    # Standard performance battery: build the attention benchmark, then submit
    # it as one job under the exclusive benchmark profile. Extra arguments pass
    # through to the binary (--json, --out PATH, --iters N, --rounds N). Use
    # this instead of `bench` when the timing must be exclusive.
    with_build_lock "$bazel_bin" build //backends/cuda/kernels:attention_benchmark
    exec 9>&-
    exec "$self" gpuq submit --profile t3-bench -- \
      "$root/bazel-bin/backends/cuda/kernels/attention_benchmark" "$@"
    ;;

  roofline)
    # The analytic performance model (docs/performance-model.md): build the
    # roofline estimator and run it under the CPU sandbox. It needs no GPU and
    # no queue. Extra arguments pass through to the binary (--device,
    # --precision, --batch, --devices, --tokens, --json).
    with_build_lock "$bazel_bin" build //src:roofline_main
    exec 9>&-
    exec "$sandbox" --profile t0-cpu -- \
      "$root/bazel-bin/src/roofline_main" "$@"
    ;;

  doctor)
    # Read-only diagnostics so an agent can distinguish slow code from a busy
    # or misconfigured host before spending time measuring. See
    # docs/performance.md. `--json` emits one JSON object that the Python
    # orchestration layer parses (docs/python.md section 6).
    doctor_json=0
    if [[ ${1:-} == "--json" ]]; then
      doctor_json=1
      shift
    fi
    d_repo=$root
    d_revision=""
    d_branch=""
    if git -C "$root" rev-parse --short HEAD >/dev/null 2>&1; then
      d_revision=$(git -C "$root" rev-parse --short HEAD)
      d_branch=$(git -C "$root" branch --show-current 2>/dev/null || true)
    fi
    if command -v nvcc >/dev/null 2>&1; then
      d_nvcc=$(nvcc --version 2>/dev/null | grep -o 'release [0-9.]*' \
        | head -1 || true)
    else
      d_nvcc="NOT FOUND"
    fi
    if command -v bazelisk >/dev/null 2>&1; then
      d_bazel=$(bazelisk version 2>/dev/null | head -1 || true)
    else
      d_bazel=""
    fi
    if command -v nvidia-smi >/dev/null 2>&1; then
      d_gpu=$(nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used,utilization.gpu --format=csv,noheader 2>/dev/null | head -1 || true)
      d_gpu_procs=$(nvidia-smi --query-compute-apps=pid,process_name --format=csv,noheader 2>/dev/null | paste -sd'; ' - || true)
    else
      d_gpu="nvidia-smi NOT FOUND"
      d_gpu_procs=""
    fi
    d_sandbox=""
    slice=$(systemctl --user show nanochat.slice -p MemoryCurrent -p MemoryMax -p CPUQuotaPerSecUSec 2>/dev/null || true)
    if [[ -n $slice ]]; then
      d_sandbox=$(echo "$slice" | paste -sd' ' -)
    fi
    # The simulator's S0 tier is CPU-only and takes no queue. The profile name
    # is a build-time capability override, so it is worth reporting beside the
    # device: a run with it set computes on the reference backend as the named
    # target (docs/simulator.md section 10).
    d_sim="${NANOCHAT_SIM_PROFILE:-unset}"
    if [[ -n ${NANOCHAT_SANDBOX_BACKEND:-} ]]; then
      d_sandbox_backend=$NANOCHAT_SANDBOX_BACKEND
    elif systemd-run --user --scope --quiet true >/dev/null 2>&1; then
      d_sandbox_backend=systemd
    else
      d_sandbox_backend="none (systemd unavailable)"
    fi
    # The GPU queue owns the device and the jobs (docs/gpu-queue-plan.md
    # section 9). Report the worker, the pool, and the depth as one object.
    d_gpu_queue=$(python3 "$root/python/nanochat_cpp/gpu_queue.py" \
      status --json 2>/dev/null || true)
    [[ -n $d_gpu_queue ]] || d_gpu_queue='{}'

    if (( doctor_json )); then
      NANOCHAT_DOCTOR_repo="$d_repo" \
      NANOCHAT_DOCTOR_revision="$d_revision" \
      NANOCHAT_DOCTOR_branch="$d_branch" \
      NANOCHAT_DOCTOR_nvcc="$d_nvcc" \
      NANOCHAT_DOCTOR_bazel="$d_bazel" \
      NANOCHAT_DOCTOR_gpu="$d_gpu" \
      NANOCHAT_DOCTOR_gpu_procs="$d_gpu_procs" \
      NANOCHAT_DOCTOR_sandbox="$d_sandbox" \
      NANOCHAT_DOCTOR_sandbox_backend="$d_sandbox_backend" \
      NANOCHAT_DOCTOR_gpu_queue="$d_gpu_queue" \
      NANOCHAT_DOCTOR_sim="$d_sim" \
      python3 - <<'PY'
import json, os
keys = ("repo", "revision", "branch", "nvcc", "bazel", "gpu", "gpu_procs",
        "sandbox", "sandbox_backend", "gpu_queue", "sim")
def value(key):
    raw = os.environ.get("NANOCHAT_DOCTOR_" + key, "")
    if key != "gpu_queue":
        return raw
    try:
        parsed = json.loads(raw)
    except ValueError:
        return {}
    return parsed if isinstance(parsed, dict) else {}
print(json.dumps({key: value(key) for key in keys}))
PY
    else
      echo "nanochat.cpp doctor"
      echo "===================="
      echo "repo:      $d_repo"
      if [[ -n $d_revision ]]; then
        echo "revision:  $d_revision (${d_branch:-detached})"
      fi
      echo "nvcc:      $d_nvcc"
      [[ -n $d_bazel ]] && echo "bazel:     $d_bazel"
      echo "gpu:       $d_gpu"
      [[ -n $d_gpu_procs ]] && echo "gpu procs: $d_gpu_procs"
      [[ -n $d_sandbox ]] && echo "sandbox:   $d_sandbox"
      echo "sandbox backend: $d_sandbox_backend"
      echo "sim profile: $d_sim"
      GPU_QUEUE_JSON="$d_gpu_queue" python3 -c '
import json, os
queue = json.loads(os.environ["GPU_QUEUE_JSON"])
if queue.get("alive"):
    print("gpu queue: worker %s devices %s queued %s running %s" % (
        queue.get("worker_id", ""), queue.get("devices", ""),
        queue.get("queued", 0), queue.get("running_job") or "-"))
else:
    print("gpu queue: idle (no worker)")
'
      for log in /tmp/nanochat-gpu.log /tmp/nanochat-sandbox.log; do
        [[ -f $log ]] || continue
        echo "--- tail $log ---"
        tail -n 5 "$log"
      done
      for binary in "$root/bazel-bin/src/train_main" \
                    "$root/bazel-bin/backends/cuda/kernels/attention_benchmark"; do
        [[ -e $binary ]] || continue
        echo "built:     $binary ($(date -r "$binary" '+%Y-%m-%d %H:%M'))"
      done
    fi
    ;;
  verify) submit_profile t2-parity "$@" ;;

  simulate)
    # The S0 simulator (docs/simulator.md section 10). Every suite is CPU-only:
    # the reference engine computes on the CPU backend under a capability
    # override, the API interposer records runtime and cuBLAS calls, the
    # collective mock runs the gradient-sync seam over four rank processes, and
    # the emulation engine runs the real device kernels on the host. None of
    # them touches the GPU, so this command takes the build lock and never the
    # GPU queue.
    sim_mode=run
    sim_device=h100
    sim_suite=all
    sim_precision=fp32
    while (( $# )); do
      case "$1" in
        --device) sim_device=${2:?--device needs a name}; shift 2 ;;
        --device=*) sim_device=${1#--device=}; shift ;;
        --suite) sim_suite=${2:?--suite needs a name}; shift 2 ;;
        --suite=*) sim_suite=${1#--suite=}; shift ;;
        --mode) sim_mode=${2:?--mode needs a value}; shift 2 ;;
        --mode=*) sim_mode=${1#--mode=}; shift ;;
        # The precision selects the build the reference engine runs
        # (docs/correctness-gates.md section 3.3). fp32 is the default.
        --precision) sim_precision=${2:?--precision needs a name}; shift 2 ;;
        --precision=*) sim_precision=${1#--precision=}; shift ;;
        *) die "simulate: unknown argument '$1'" ;;
      esac
    done
    case "$sim_device" in
      h100|h200|a100|t4|gtx1080ti) ;;
      *) die "simulate: unknown device '$sim_device' (h100 h200 a100 t4 gtx1080ti)" ;;
    esac
    if [[ $sim_mode == compile ]]; then
      # The compile gate (section 8): build the whole CUDA backend for the
      # target architecture under --config=sim-gate, so warnings become errors
      # and ptxas reports the register and shared-memory use. No GPU and no
      # queue; the build lock serializes it against every other build.
      #
      # The aggregate library alone carries no actions, so the gate also builds
      # the binaries that link the whole backend: those compile and link every
      # kernel family and the runtime for the target architecture.
      ptxas_log=${NANOCHAT_SIM_PTXAS_LOG:-/tmp/nanochat-sim-ptxas-${sim_device}.log}
      gate_log=$(mktemp)
      gate_status=0
      with_build_lock "$bazel_bin" build \
        --config="$sim_device" --config=sim-gate \
        //backends/cuda:all_kernels \
        //backends/cuda/collective:native_sync \
        //backends/cuda:cuda_runtime_gpu_test \
        //backends/cuda/kernels:precision_gpu_test \
        //backends/cuda/kernels:row_kernels_gpu_test \
        //backends/cuda/kernels:sequence_oracle_gpu_test \
        > "$gate_log" 2>&1 || gate_status=$?
      if (( gate_status != 0 )); then
        cat "$gate_log" >&2
        rm -f "$gate_log"
        exit "$gate_status"
      fi
      # Keep the ptxas resource lines for the record. Bazel prints the compiler
      # stderr as INFO lines when it carries a diagnostic. A cached build
      # compiles nothing, so keep the previous log rather than erase it.
      fresh_log=$(mktemp)
      grep -E "ptxas info|Used [0-9]+ registers" "$gate_log" \
        > "$fresh_log" 2>/dev/null || true
      fresh_count=$(grep -cE "Used [0-9]+ registers" "$fresh_log" 2>/dev/null || true)
      : "${fresh_count:=0}"
      if (( fresh_count > 0 )); then
        mv "$fresh_log" "$ptxas_log"
        record_count=$fresh_count
        record_note=fresh
      elif [[ -s $ptxas_log ]]; then
        rm -f "$fresh_log"
        record_count=$(grep -cE "Used [0-9]+ registers" "$ptxas_log" 2>/dev/null || true)
        : "${record_count:=0}"
        record_note="build cached; kept the previous log"
      else
        rm -f "$fresh_log"
        record_count=0
        record_note="build cached and no earlier log"
      fi
      echo "simulate: compile gate OK ($sim_device, -Werror, ptxas records: $record_count; $record_note)"
      echo "simulate: ptxas resource log -> $ptxas_log"
      rm -f "$gate_log"
      exit 0
    fi
    [[ $sim_mode == run ]] || die "simulate: unknown mode '$sim_mode' (run compile)"

    # The API suite is the only one that interposes over the real CUDA
    # backend: build the preloadable mock and a CUDA-linked test, check the
    # symbol gate against a real CUDA binary, then run the test with
    # `LD_PRELOAD` pointing at the mock. No GPU queue: the preloaded mock
    # serves memory from the host and never calls the real runtime.
    if [[ $sim_suite == api || $sim_suite == all ]]; then
      with_build_lock "$bazel_bin" build --config=cuda \
        //tools/cuda_sim:cuda_sim_interposer \
        //backends/cuda:cuda_runtime_gpu_test \
        //tests:cuda_sim_preload_test
      mock_so=$(readlink -f "$root/bazel-bin/tools/cuda_sim/libcuda_sim_interposer.so")
      real_bin=$(readlink -f "$root/bazel-bin/backends/cuda/cuda_runtime_gpu_test")
      [[ -f $mock_so ]] || die "simulate: the interposer .so was not built ($mock_so)"
      [[ -f $real_bin ]] || die "simulate: $real_bin was not built"
      # The symbol gate: the mock itself, a real CUDA-linked binary, and the
      # negative case (a missing symbol must be rejected).
      "$here/cuda_sim/check_symbols.sh"
      "$here/cuda_sim/check_symbols.sh" "$real_bin"
      "$here/cuda_sim/check_symbols.sh" --negative-self-test
      sim_log=$(mktemp "${TMPDIR:-/tmp}/nanochat-sim-api.XXXXXX.jsonl")
      trap 'rm -f "$sim_log"' EXIT
      with_build_lock "$bazel_bin" test //tests:cuda_sim_preload_test \
        --config=cuda \
        --test_tag_filters=sim \
        "--run_under=$sandbox --profile=t0-cpu --" \
        --spawn_strategy=local \
        "--test_env=NANOCHAT_SIM_PROFILE=$sim_device" \
        "--test_env=LD_PRELOAD=$mock_so" \
        "--test_env=NANOCHAT_SIM_LOG=$sim_log"
      # The in-process mock unit test: same mock, no preload (it links the mock
      # directly). Kept beside the preload run so the suite covers both halves.
      with_build_lock "$bazel_bin" test //tests:cuda_sim_test \
        --test_tag_filters=sim \
        "--run_under=$sandbox --profile=t0-cpu --" \
        --spawn_strategy=local \
        "--test_env=NANOCHAT_SIM_PROFILE=$sim_device"
    fi
    [[ $sim_suite == api ]] && exit 0

    case "$sim_suite" in
      correctness) sim_targets=(//tests:oracle_test //tests:train_parity_test
                                //tests:sim_numerics_test
                                //tests:numerics_trace_test) ;;
      # The fast fp8 core (docs/correctness-gates.md section 5.1): the shared
      # rounding header and the scaled GEMM seam on the CPU. Milliseconds, so
      # it rides the inner development loop.
      fp8-fast) sim_targets=(//tests:fp8_rounding_test //tests:fp8_gemm_test
                             //tests:fp8_graph_test
                             //tests:device_profile_test) ;;
      collective) sim_targets=(//tests:collective_sim_test) ;;
      kernel) sim_targets=(//tests:kernel_emu_test) ;;
      profile) sim_targets=(//tests:device_profile_test) ;;
      all) sim_targets=(//tests:oracle_test //tests:train_parity_test
                        //tests:sim_numerics_test //tests:numerics_trace_test
                        //tests:fp8_rounding_test //tests:fp8_gemm_test
                        //tests:fp8_graph_test
                        //tests:collective_sim_test
                        //tests:kernel_emu_test //tests:device_profile_test) ;;
      *) die "simulate: unknown suite '$sim_suite'" ;;
    esac

    # fp32 is the default; the other tiers select their build config
    # (docs/precision.md, docs/fp8-training.md section 3.3).
    sim_configs=(--config=sim)
    case "$sim_precision" in
      fp32) ;;
      bf16) sim_configs+=(--config=bf16) ;;
      fp8) sim_configs+=(--config=fp8) ;;
      *) die "simulate: unknown precision '$sim_precision' (fp32 bf16 fp8)" ;;
    esac
    # The reference-engine suites assert the override is live under
    # `--config=sim`, so the profile name must reach the test process.
    with_build_lock "$bazel_bin" test \
      "${sim_targets[@]}" \
      --test_tag_filters=-gpu \
      "--run_under=$sandbox --profile=t0-cpu --" \
      --spawn_strategy=local \
      "--test_env=NANOCHAT_SIM_PROFILE=$sim_device" \
      "${sim_configs[@]}"
    ;;

  gpu)
    # Submit one job to the GPU queue (docs/gpu-queue-plan.md section 7).
    # Inside a sandbox or a queued job the command runs directly.
    if [[ -n ${NANOCHAT_SANDBOX:-} || -n ${NANOCHAT_GPU_QUEUED:-} ]]; then
      gpu_profile=t1-gpu
      while (( $# )); do
        case "$1" in
          --profile)
            gpu_profile=${2:?--profile needs a name}
            shift 2
            ;;
          --profile=*)
            gpu_profile=${1#--profile=}
            shift
            ;;
          --)
            shift
            break
            ;;
          *) break ;;
        esac
      done
      (( $# )) || die "gpu: no command given"
      if [[ -n ${NANOCHAT_GPU_QUEUED:-} ]]; then
        exec "$@"
      fi
      exec "$sandbox" --profile "$gpu_profile" -- "$@"
    fi
    exec "$self" gpuq submit "$@"
    ;;

  *)
    die "unknown command '$command' (try: tools/nanochat help)"
    ;;
esac
