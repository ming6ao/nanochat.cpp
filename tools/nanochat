#!/usr/bin/env bash
# nanochat — the single execution entry point.
#
# usage: tools/nanochat <command> [args...]
#
# Every test, training, eval, benchmark, and verification run goes through here
# so the resource sandbox, the GPU queue, and the Bazel test wiring are chosen
# once and cannot be assembled incorrectly. Run `tools/nanochat help` for the
# command list.
#
# This file is a shim. The command table, the argument assembly, the Bazel
# wiring, and the build lock live in `python/nanochat_cpp/cli.py`. The path
# `tools/nanochat` stays stable because the Bazel `--run_under` strings and
# every document name it. See docs/script-consolidation-plan.md, and
# docs/sandbox.md, docs/testing.md, and docs/gpu-queue-plan.md.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# The host tool requires the Python floor that docs/build.md records.
python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
  2>/dev/null ||
  {
    echo "nanochat: python3 3.10 or later is required; found $(python3 --version 2>&1 || echo 'no python3 on PATH')" >&2
    exit 2
  }

exec python3 "$here/../python/nanochat_cpp/cli.py" "$@"
