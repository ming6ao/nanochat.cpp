#!/usr/bin/env bash
# nanochat_cpp — Python entry point wrapper.
#
# Makes `python -m nanochat_cpp.<script>` work from the repository root without
# a manual PYTHONPATH, and picks the reference virtual environment so torch and
# pyarrow are importable.
#
#   tools/nanochat_cpp base_train --depth=8 --max-seq-len=512 ...
#   tools/nanochat_cpp base_train --help
#
# The training binary itself still runs through tools/nanochat (the sandbox and
# the GPU broker), which the Python entry point invokes. See docs/testing.md.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/.." && pwd)

# Locate the reference nanochat checkout unless NANOCHAT_REPO is set.
ref=${NANOCHAT_REPO:-}
if [[ -z $ref ]]; then
  for candidate in "$root/../nanochat" "$HOME/repos/nanochat"; do
    if [[ -f "$candidate/nanochat/gpt.py" ]]; then
      ref=$candidate
      break
    fi
  done
fi
if [[ -n $ref ]]; then
  export NANOCHAT_REPO=$ref
fi

python=${NANOCHAT_PYTHON:-}
if [[ -z $python && -n $ref && -x "$ref/.venv/bin/python" ]]; then
  python="$ref/.venv/bin/python"
fi
if [[ -z $python ]]; then
  python=python3
fi

export PYTHONPATH="$root/python${PYTHONPATH:+:$PYTHONPATH}"

module=${1:-base_train}
shift || true
exec "$python" -m "nanochat_cpp.$module" "$@"
