# tools/ — the execution entry point and host tooling.
#
# The offline fixture generators are one grouped script, `dump_fixtures.py`,
# with the shared helpers in `fixture_common.py` and the shared SFT machinery in
# `sft_fixture.py`. The scripts run on the host and are source files, not build
# targets. See docs/python.md. A new parity fixture is not
# added here: the producers of docs/build.md Part 1, section 7.3 run
# through `tools/nanochat parity produce <kind>` and live in
# `python/nanochat_cpp_bridge`.
#
# `convert_checkpoint.py` forwards to the PyTorch half of the conversion in
# `python/nanochat_cpp_bridge/torch_checkpoint.py`; the container writer stays in
# `python/nanochat_cpp/checkpoint.py`. The native-tokenizer tools are described
# in `docs/tokenizer.md`.

load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_tokenizer_parity.py",
    "contract_vocabulary.py",
    "convert_checkpoint.py",
    "dump_fixtures.py",
    "fixture_common.py",
    "fixture_format.py",
    "gen_capi_mirrors.py",
    "gen_matrix.py",
    "gen_unicode_tables.py",
    "isolation_gate.py",
    "nanochat",
    "sft_fixture.py",
])

# The sandbox resources. The launcher is
# `python/nanochat_cpp/sandbox.py`, and `python/tests/contract_test.py` runs it
# from the runfiles tree, so the data it reads travels with the test.
filegroup(
    name = "sandbox_data",
    srcs = [
        "sandbox/nanochat.slice",
        "sandbox/profiles.json",
    ],
)

# The merged fixture generator and its shared helpers. The contract suite
# reads the usage line, and a fixture run needs both files. The two P4 oracle
# tools travel in the same group so a test that already consumes
# `//tools:fixtures` gets the selector check, the matrix generator, and the
# isolation gate in its runfiles with no new label.
filegroup(
    name = "fixtures",
    srcs = [
        "dump_fixtures.py",
        "fixture_common.py",
        "fixture_format.py",
        "gen_matrix.py",
        "isolation_gate.py",
        "sft_fixture.py",
    ],
)

# The section 11 matrix generator. It reads models/*/spec.json and
# backends/*/caps.json and is standard-library only.
filegroup(
    name = "matrix",
    srcs = ["gen_matrix.py"],
)

# The capability vocabulary generator and checker (docs/api-surface.md R4a).
# `--write` owns the rows that hold a name, a bit, and a position; `--check`
# compares the rows that also carry prose. It reads spec/capability_bits.md,
# include/nanochat/tensor.h, src/capability_names.h, and the two caps.json
# declarations, so a test that consumes this group lists those as data.
filegroup(
    name = "contract_vocabulary",
    srcs = ["contract_vocabulary.py"],
)

# The C ABI mirror generator (docs/api-surface.md R11b, R20). `--write` owns the
# `_SIGNATURES` table of `python/nanochat_cpp/_core.py` and the `static_assert`
# block of `bindings/nanochat_capi_test.cc`. `--check` compares the hand-written
# `_LAYOUT` table in `_core.py` against include/nanochat/capi.h as well, in both
# directions. It is standard-library only, so a test that consumes this group
# lists the two written files and the header as data.
filegroup(
    name = "gen_capi_mirrors",
    srcs = ["gen_capi_mirrors.py"],
)

# The section 10.4 regenerate-and-diff gate. It drives dump_fixtures.py, so
# the shared helpers travel with it.
filegroup(
    name = "isolation_gate",
    srcs = [
        "isolation_gate.py",
        "dump_fixtures.py",
        "fixture_common.py",
        "fixture_format.py",
        "sft_fixture.py",
    ],
)

# The reference-checkpoint converter. See `docs/python.md`. The script reaches
# `nanochat_cpp_bridge` through its own `sys.path` insertion rather than a
# dependency: the packaging node declares that library in `python/BUILD.bazel`,
# and a host script is not a build target.
filegroup(
    name = "convert_checkpoint",
    srcs = ["convert_checkpoint.py"],
)

filegroup(
    name = "check_tokenizer_parity",
    srcs = ["check_tokenizer_parity.py"],
)

filegroup(
    name = "gen_unicode_tables",
    srcs = ["gen_unicode_tables.py"],
)

# Kaggle Notebook host tooling. See docs/host-portability.md.
filegroup(
    name = "kaggle_scripts",
    srcs = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
)

# T0 syntax test for the Kaggle host scripts. Hermetic and CPU-only: it runs
# `bash -n` on each script and never touches the network.
sh_test(
    name = "kaggle_scripts_test",
    srcs = ["kaggle/scripts_test.sh"],
    args = [
        "$(location kaggle/bootstrap.sh)",
        "$(location kaggle/github-setup.sh)",
    ],
    data = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
    size = "small",
)

# T0 gate for the capability vocabulary and the seam inventory
# (docs/api-surface.md R4a and R14). `--check` compares the hand-written rows of
# src/capability_names.h and every caps.json `features[]` array against
# spec/capability_bits.md section 3 and include/nanochat/tensor.h, the kinds of
# spec/block_kinds.md section 2 against the spellings src/model_spec.cc accepts,
# and every caps.json `primitives[]` entry against the seam symbols of
# include/nanochat/kernels.h. The mutation cases prove each direction fails with
# the file and the row named. Hermetic and CPU-only: the standard library, no
# torch, no GPU, no CUDA toolchain, so it rides the default `-gpu` test leg.
py_test(
    name = "contract_vocabulary_test",
    srcs = ["contract_vocabulary_test.py"],
    data = [
        ":contract_vocabulary",
        "//backends/cpu:caps_json",
        "//backends/cuda:caps_json",
        "//include/nanochat:kernels.h",
        "//include/nanochat:tensor.h",
        "//spec:block_kinds.md",
        "//spec:capability_bits.md",
        "//src:capability_names.h",
        "//src:model_spec.cc",
    ],
    size = "small",
)

# T0 gate for the three C ABI mirrors (docs/api-surface.md R11b). `--check`
# compares the ctypes structures, the signature table, and the `static_assert`
# block against include/nanochat/capi.h, naming the file, the structure, and the
# field on a disagreement in either direction. The mutation cases prove each
# direction fails, and one case proves a header form the parser does not know
# stops the run with the offending line. The fixed-point case proves a second
# `--write` changes no byte. Hermetic and CPU-only: the standard library, no
# torch, no GPU, so it rides the default `-gpu` test leg.
py_test(
    name = "gen_capi_mirrors_test",
    srcs = ["gen_capi_mirrors_test.py"],
    data = [
        ":gen_capi_mirrors",
        "//bindings:nanochat_capi_test.cc",
        "//include/nanochat:capi.h",
        "//python:nanochat_cpp/_core.py",
    ],
    size = "small",
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":contract_vocabulary_test",
        ":gen_capi_mirrors_test",
        ":kaggle_scripts_test",
    ],
)
