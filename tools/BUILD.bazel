# tools/ — the execution entry point and the host tooling (the oracle dump
# script, the GPU broker, the resource sandbox, and the output-base reaper).
#
# `dump_oracle.py`, `dump_train_fixture.py`, `dump_generate_fixture.py`,
# `dump_eval_fixture.py`, `dump_plan_fixture.py`, and `dump_chat_fixture.py` are
# the offline fixture generators, and `convert_checkpoint.py` is the
# reference-checkpoint converter. All of them need torch, so they are not Bazel
# build/test targets: they run on the host (CPU only) and are exported here so
# they are visible from the repository root and reproducible. The converter's
# torch-free logic lives in `nanochat_cpp.checkpoint` and is covered by
# `//python:checkpoint_test`. `dump_numerics_golden.py` is the one exception to
# the torch rule: it drives the C++ emitter of
# `docs/numerics-integration.md`, so it needs no third-party package.
#
# `dump_tokenizer_fixture.py`, `check_tokenizer_parity.py`, and
# `gen_unicode_tables.py` are the native-tokenizer host tools. The first needs
# rustbpe, tiktoken, and regex; the second needs rustbpe, tiktoken, and pyarrow;
# the third is dependency-free. They are exported for the same reason. See
# docs/tokenizer.md.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_tokenizer_parity.py",
    "convert_checkpoint.py",
    "dump_api_fixture.py",
    "dump_numerics_golden.py",
    "dump_oracle.py",
    "dump_train_fixture.py",
    "dump_rl_fixture.py",
    "dump_generate_fixture.py",
    "dump_eval_fixture.py",
    "dump_tokenizer_fixture.py",
    "gen_unicode_tables.py",
    "nanochat",
    "nanochat_cpp",
    "gpu.sh",
    "sandbox.sh",
    "lint.sh",
    "prune_bazel_output_bases",
])

filegroup(
    name = "dump_oracle",
    srcs = ["dump_oracle.py"],
)

filegroup(
    name = "dump_train_fixture",
    srcs = ["dump_train_fixture.py"],
)

# The RL parity fixture generator (docs/rl-notebook.md section 4,
# docs/training-seam.md section 6.4). It records the parameters, the rollouts,
# the targets, and the advantages for `//tests:rl_parity_test`; the pure-Python
# reference needs no third-party package.
filegroup(
    name = "dump_rl_fixture",
    srcs = ["dump_rl_fixture.py"],
)

# The Python-API fixture generator (docs/python.md section 11). It runs the
# committed CPU binaries through `tools/nanochat` and writes
# `tests/data/api_fixture.bin`; it needs no third-party package.
filegroup(
    name = "dump_api_fixture",
    srcs = ["dump_api_fixture.py"],
)

filegroup(
    name = "dump_generate_fixture",
    srcs = ["dump_generate_fixture.py"],
)

filegroup(
    name = "dump_eval_fixture",
    srcs = ["dump_eval_fixture.py"],
)

# The numeric-trace fixture generator (docs/numerics-integration.md). It builds
# the emitter, runs it through `tools/nanochat`, and writes
# `tests/data/numerics_golden_10l.bin`; it needs no third-party package.
filegroup(
    name = "dump_numerics_golden",
    srcs = ["dump_numerics_golden.py"],
)

# The reference-checkpoint converter. It needs torch, so it is data, not a
# build target: `python3 tools/convert_checkpoint.py` in the reference venv.
filegroup(
    name = "convert_checkpoint",
    srcs = ["convert_checkpoint.py"],
)

# The native-tokenizer host tools. See docs/tokenizer.md.
filegroup(
    name = "dump_tokenizer_fixture",
    srcs = ["dump_tokenizer_fixture.py"],
)

filegroup(
    name = "check_tokenizer_parity",
    srcs = ["check_tokenizer_parity.py"],
)

filegroup(
    name = "gen_unicode_tables",
    srcs = ["gen_unicode_tables.py"],
)

# Kaggle Notebook host tooling. See docs/host-portability.md.
filegroup(
    name = "kaggle_scripts",
    srcs = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
)

# T0 test for the output-base reaper. Hermetic and CPU-only: it builds a
# synthetic Bazel output user root under TEST_TMPDIR and never touches the real
# cache. See tools/prune_test.sh.
sh_test(
    name = "prune_test",
    srcs = ["prune_test.sh"],
    args = ["$(location :prune_bazel_output_bases)"],
    data = ["prune_bazel_output_bases"],
)

# T0 syntax test for the Kaggle host scripts. Hermetic and CPU-only: it runs
# `bash -n` on each script and never touches the network.
sh_test(
    name = "kaggle_scripts_test",
    srcs = ["kaggle/scripts_test.sh"],
    args = [
        "$(location kaggle/bootstrap.sh)",
        "$(location kaggle/github-setup.sh)",
    ],
    data = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
    size = "small",
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":prune_test",
        ":kaggle_scripts_test",
    ],
)
