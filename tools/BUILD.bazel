# tools/ — the execution entry point and host tooling.
#
# The offline fixture generators use four grouped scripts. They keep distinct
# commands and output formats, but share the record writer where their layouts
# match. Their optional reference packages load only for the selected command.
# The scripts run on the host and are source files, not build targets.
#
# `convert_checkpoint.py` forwards to the tested implementation in
# `python/nanochat_cpp/checkpoint.py`. The native-tokenizer tools are described
# in `docs/tokenizer.md`.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_tokenizer_parity.py",
    "convert_checkpoint.py",
    "dump_data_fixtures.py",
    "dump_model_fixtures.py",
    "dump_runtime_fixtures.py",
    "dump_training_fixtures.py",
    "fixture_format.py",
    "gen_unicode_tables.py",
    "nanochat",
    "gpu.sh",
    "sandbox.sh",
    "lint.sh",
    "prune_bazel_output_bases",
])

filegroup(
    name = "dump_training_fixtures",
    srcs = ["dump_training_fixtures.py", "fixture_format.py"],
)

filegroup(
    name = "dump_model_fixtures",
    srcs = ["dump_model_fixtures.py", "fixture_format.py"],
)

filegroup(
    name = "dump_data_fixtures",
    srcs = ["dump_data_fixtures.py", "fixture_format.py"],
)

filegroup(
    name = "dump_runtime_fixtures",
    srcs = ["dump_runtime_fixtures.py"],
)

# The reference-checkpoint converter. See `docs/python.md`.
filegroup(
    name = "convert_checkpoint",
    srcs = ["convert_checkpoint.py"],
)

filegroup(
    name = "check_tokenizer_parity",
    srcs = ["check_tokenizer_parity.py"],
)

filegroup(
    name = "gen_unicode_tables",
    srcs = ["gen_unicode_tables.py"],
)

# Kaggle Notebook host tooling. See docs/host-portability.md.
filegroup(
    name = "kaggle_scripts",
    srcs = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
)

# T0 test for the output-base reaper. Hermetic and CPU-only: it builds a
# synthetic Bazel output user root under TEST_TMPDIR and never touches the real
# cache. See tools/prune_test.sh.
sh_test(
    name = "prune_test",
    srcs = ["prune_test.sh"],
    args = ["$(location :prune_bazel_output_bases)"],
    data = ["prune_bazel_output_bases"],
)

# T0 syntax test for the Kaggle host scripts. Hermetic and CPU-only: it runs
# `bash -n` on each script and never touches the network.
sh_test(
    name = "kaggle_scripts_test",
    srcs = ["kaggle/scripts_test.sh"],
    args = [
        "$(location kaggle/bootstrap.sh)",
        "$(location kaggle/github-setup.sh)",
    ],
    data = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
    size = "small",
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":prune_test",
        ":kaggle_scripts_test",
    ],
)
