# tools/ — the execution entry point and the host tooling (the oracle dump
# script, the GPU broker, the resource sandbox, and the output-base reaper).
#
# `dump_oracle.py`, `dump_train_fixture.py`, `dump_generate_fixture.py`, and
# `dump_eval_fixture.py` are the offline fixture generators, and
# `convert_checkpoint.py` is the reference-checkpoint converter. All of them
# need torch, so they are not Bazel build/test targets: they run on the host
# (CPU only) and are exported here so they are visible from the repository root
# and reproducible. The converter's torch-free logic lives in `//python:package`
# (`nanochat_cpp.checkpoint`) and is covered by the selftest.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "convert_checkpoint.py",
    "dump_oracle.py",
    "dump_train_fixture.py",
    "dump_generate_fixture.py",
    "dump_eval_fixture.py",
    "nanochat",
    "nanochat_cpp",
    "gpu.sh",
    "sandbox.sh",
    "lint.sh",
    "prune_bazel_output_bases",
])

filegroup(
    name = "dump_oracle",
    srcs = ["dump_oracle.py"],
)

filegroup(
    name = "dump_train_fixture",
    srcs = ["dump_train_fixture.py"],
)

filegroup(
    name = "dump_generate_fixture",
    srcs = ["dump_generate_fixture.py"],
)

filegroup(
    name = "dump_eval_fixture",
    srcs = ["dump_eval_fixture.py"],
)

# The reference-checkpoint converter. It needs torch, so it is data, not a
# build target: `python3 tools/convert_checkpoint.py` in the reference venv.
filegroup(
    name = "convert_checkpoint",
    srcs = ["convert_checkpoint.py"],
)

# T0 test for the output-base reaper. Hermetic and CPU-only: it builds a
# synthetic Bazel output user root under TEST_TMPDIR and never touches the real
# cache. See tools/prune_test.sh.
sh_test(
    name = "prune_test",
    srcs = ["prune_test.sh"],
    args = ["$(location :prune_bazel_output_bases)"],
    data = ["prune_bazel_output_bases"],
)

# T0 test for the Python bridge's torch-free logic. See docs/python-bridge.md.
sh_test(
    name = "nanochat_cpp_selftest",
    srcs = ["nanochat_cpp_selftest.sh"],
    data = ["//python:package"],
    size = "small",
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":prune_test",
        ":nanochat_cpp_selftest",
    ],
)
