# tools/ — the execution entry point and the host tooling (the oracle dump
# script, the GPU broker, the resource sandbox, and the output-base reaper).
#
# `dump_oracle.py` is the offline fixture generator. It needs torch, so it is
# not a Bazel build/test target: it runs on the host (CPU only) and its output
# is committed as data under tests/data/. It is exported here so it is visible
# from the repository root and reproducible.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "dump_oracle.py",
    "dump_train_fixture.py",
    "nanochat",
    "gpu.sh",
    "sandbox.sh",
    "prune_bazel_output_bases",
])

filegroup(
    name = "dump_oracle",
    srcs = ["dump_oracle.py"],
)

filegroup(
    name = "dump_train_fixture",
    srcs = ["dump_train_fixture.py"],
)

# T0 test for the output-base reaper. Hermetic and CPU-only: it builds a
# synthetic Bazel output user root under TEST_TMPDIR and never touches the real
# cache. See tools/prune_test.sh.
sh_test(
    name = "prune_test",
    srcs = ["prune_test.sh"],
    args = ["$(location :prune_bazel_output_bases)"],
    data = ["prune_bazel_output_bases"],
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [":prune_test"],
)
