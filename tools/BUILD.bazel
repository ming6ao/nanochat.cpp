# tools/ — the execution entry point and host tooling.
#
# The offline fixture generators are one grouped script, `dump_fixtures.py`,
# with the shared helpers in `fixture_common.py`. The script runs on the host
# and is a source file, not a build target. See
# docs/script-consolidation-plan.md.
#
# `convert_checkpoint.py` forwards to the tested implementation in
# `python/nanochat_cpp/checkpoint.py`. The native-tokenizer tools are described
# in `docs/tokenizer.md`.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_tokenizer_parity.py",
    "convert_checkpoint.py",
    "dump_fixtures.py",
    "fixture_common.py",
    "fixture_format.py",
    "gen_unicode_tables.py",
    "nanochat",
    "sandbox.sh",
    "lint.sh",
])

# The sandbox launcher and its resources. `tools/nanochat` wraps the launcher,
# and `python/tests/contract_test.py` runs both from the runfiles tree, so the
# files travel together.
filegroup(
    name = "sandbox_scripts",
    srcs = [
        "sandbox.sh",
        "sandbox/nanochat.slice",
        "sandbox/profiles.conf",
        "sandbox/verify.sh",
    ],
)

# The merged fixture generator and its shared helpers. The contract suite
# reads the usage line, and a fixture run needs both files.
filegroup(
    name = "fixtures",
    srcs = [
        "dump_fixtures.py",
        "fixture_common.py",
        "fixture_format.py",
    ],
)

# The reference-checkpoint converter. See `docs/python.md`.
filegroup(
    name = "convert_checkpoint",
    srcs = ["convert_checkpoint.py"],
)

filegroup(
    name = "check_tokenizer_parity",
    srcs = ["check_tokenizer_parity.py"],
)

filegroup(
    name = "gen_unicode_tables",
    srcs = ["gen_unicode_tables.py"],
)

# Kaggle Notebook host tooling. See docs/host-portability.md.
filegroup(
    name = "kaggle_scripts",
    srcs = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
)

# T0 syntax test for the Kaggle host scripts. Hermetic and CPU-only: it runs
# `bash -n` on each script and never touches the network.
sh_test(
    name = "kaggle_scripts_test",
    srcs = ["kaggle/scripts_test.sh"],
    args = [
        "$(location kaggle/bootstrap.sh)",
        "$(location kaggle/github-setup.sh)",
    ],
    data = [
        "kaggle/bootstrap.sh",
        "kaggle/github-setup.sh",
    ],
    size = "small",
)

# Aggregation point consumed by //:all_tests.
test_suite(
    name = "all",
    tests = [
        ":kaggle_scripts_test",
    ],
)
