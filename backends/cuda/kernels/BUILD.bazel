# Muon's Polar Express GEMM shapes and the whole optimizer phase of one step,
# at the `h100` and `big` profile shapes. Every row carries its model FLOPs
# utilization, which the shared report computes. With `--muon` the run also
# reports the fused path's rows beside the multi-launch ones, over the same
# buffers, so one group's two steps are read side by side.
cuda_binary(
    name = "muon_benchmark",
    srcs = ["muon_benchmark.cc"],
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        ":muon_fused",
        ":optimizer_kernels",
        "//backends/cuda/kernels/testing:bench_utils",
        "//backends/cuda/kernels/testing:optim_test_utils",
        "//include/nanochat:nanochat",
    ],
)

