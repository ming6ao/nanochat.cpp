# backends/cuda/kernels/ — one translation unit per kernel family plus the
# shared device_utils.cuh helpers. This package holds the row and elementwise
# families (RmsNorm, QkPrep, Pointwise, GradNorm) and the sequence families
# (Attention, Classifier, Embedding); the optimizer targets land alongside
# them. See docs/kernels.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_binary",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# Header-only device helpers shared by every row/elementwise family. Built as a
# plain cc_library: the header is text, and each .cu compiles it into its own
# translation unit.
cc_library(
    name = "device_utils",
    hdrs = ["device_utils.cuh"],
    deps = ["//include/nanochat:nanochat"],
)

# The fp8 matrix multiply-accumulate wrapper (docs/tensor-core-gemm-plan.md
# section A.4). Header-only, and the same shape as `device_utils`: it carries
# both arms -- the device instruction and the scalar reference -- because a
# production source may not include `tools/**`, and the emulator needs the
# scalar arm to be the file the host compiler sees.
cc_library(
    name = "mma_ops",
    hdrs = ["mma_ops.cuh"],
    deps = ["//include/nanochat:nanochat"],
)

# The three Polar Express GEMM shapes of one Muon group. `muon.cu` issues them
# and the hand GEMM's shape table reads the same three, so the call sites and
# the closed list cannot drift (docs/tensor-core-gemm-plan.md section B.6).
cc_library(
    name = "muon_gemm_shape",
    hdrs = ["muon_gemm_shape.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
)

# RmsNorm: the frozen forward/backward pair plus the backend-internal fused
# residual variant (rms_norm.h).
cuda_library(
    name = "rms_norm",
    srcs = ["rms_norm.cu"],
    hdrs = ["rms_norm.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# QkPrep: fused RMSNorm -> RoPE -> scale on q and k.
cuda_library(
    name = "qk_prep",
    srcs = ["qk_prep.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Pointwise: scale, scale-add, gate-mul, relu^2, softcap.
cuda_library(
    name = "pointwise",
    srcs = ["pointwise.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Fp8: the dynamic amax and scale, then the fp8 cast
# (docs/precision.md Part 1, section 4.2). The cast uses the CUDA conversion
# intrinsic, which matches the shared `nanochat/fp8.h` rounding.
cuda_library(
    name = "fp8",
    srcs = ["fp8.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# GradNorm: the L2 norm over a set of gradient spans, plus the clip scale.
cuda_library(
    name = "grad_norm",
    srcs = ["grad_norm.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Attention: causal / sliding-window / grouped-query, forward and backward.
# The promoted fused windowed forward (`window_left >= 0`, `head_dim == 128`)
# compiles into this translation unit. It reuses device_utils, the device
# runtime, the cuBLAS gemm seam, and the frozen interface, so the dependency
# set below is unchanged and stays minimal.
#
# The bf16 tensor-core branch is a separate source. The build selects it and not
# a preprocessor guard: a bf16 or fp8 build links `attention_bf16.cu`, and every
# other build links `attention_bf16_absent.cc`, which answers "not this shape"
# and launches nothing. `attention.cu` names both entry points unconditionally,
# so it holds no guard either (`docs/attention.md` Part 6).
cuda_library(
    name = "attention",
    srcs = ["attention.cu"],
    hdrs = [
        "attention_bf16.h",
        "attention_dispatch.h",
    ],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//backends/cuda:gemm",
        "//include/nanochat:nanochat",
    ] + select({
        "//:bf16": [":attention_bf16"],
        "//:fp8": [":attention_bf16"],
        "//conditions:default": [":attention_bf16_absent"],
    }),
    alwayslink = True,
)

# The bf16 tensor-core tile of the windowed forward (docs/attention.md Part 6).
# Only a bf16 or fp8 build compiles it, because it stages two-byte operands
# through `wmma` and `cp.async`. A fourth precision joins the select above when
# its operand type is bf16 too.
cuda_library(
    name = "attention_bf16",
    srcs = ["attention_bf16.cu"],
    hdrs = [
        "attention_bf16.h",
        "attention_dispatch.h",
    ],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# The stand-in the other builds link (`attention_bf16.h`). It is a host source
# and names no vendor type, so an fp32 build and the emulator both compile it.
# `local_defines` is the workspace precision, which is the one the caller
# compiles at, so `ComputeType` agrees on both sides of the call. It is local so
# that a dependent keeps its own answer.
cc_library(
    name = "attention_bf16_absent",
    srcs = ["attention_bf16_absent.cc"],
    hdrs = ["attention_bf16.h"],
    copts = nanochat_copts(),
    local_defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
)

# Classifier: logit softcap + cross-entropy over the vocab slice.
cuda_library(
    name = "classifier",
    srcs = ["classifier.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Embedding: indexed gather forward and scatter-add backward.
cuda_library(
    name = "embedding",
    srcs = ["embedding.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
