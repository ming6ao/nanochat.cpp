# backends/cuda/kernels/ — one translation unit per kernel family plus the
# shared device_utils.cuh helpers. This package currently holds the row and
# elementwise families (RmsNorm, QkPrep, Pointwise, GlobalNorm); attention and
# optimizer targets land alongside them. See docs/kernels.md.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# Header-only device helpers shared by every row/elementwise family. Built as a
# plain cc_library: the header is text, and each .cu compiles it into its own
# translation unit.
cc_library(
    name = "device_utils",
    hdrs = ["device_utils.cuh"],
    deps = ["//include/nanochat:nanochat"],
)

# RmsNorm: the frozen forward/backward pair plus the backend-internal fused
# residual variant (rms_norm.h).
cuda_library(
    name = "rms_norm",
    srcs = ["rms_norm.cu"],
    hdrs = ["rms_norm.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# QkPrep: fused RMSNorm -> RoPE -> scale on q and k.
cuda_library(
    name = "qk_prep",
    srcs = ["qk_prep.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Pointwise: scale, scale-add, gate-mul, relu^2, softcap.
cuda_library(
    name = "pointwise",
    srcs = ["pointwise.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# GlobalNorm: global L2 reduction and in-place clip.
cuda_library(
    name = "global_norm",
    srcs = ["global_norm.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Convenience aggregate the host graph and the dev/kernels tests link.
cc_library(
    name = "row_kernels",
    deps = [
        ":global_norm",
        ":pointwise",
        ":qk_prep",
        ":rms_norm",
    ],
)

# T1 GPU smoke correctness: tiny shapes, host code only, exercises every family
# through the sealed nanochat/kernels.h API plus the fused residual helper.
cc_test(
    name = "row_kernels_gpu_test",
    srcs = ["row_kernels_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_kernels",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# Aggregation point consumed by //:all_tests.
test_suite(name = "all", tests = [":row_kernels_gpu_test"])
