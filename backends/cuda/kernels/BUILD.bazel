    ],
)

# Attention forward/backward device-event timing at `d8_s512`, with a
# head-dimension sweep. The acceptance binary of `tools/nanochat profile`.
cuda_binary(
    name = "attention_benchmark",
    srcs = ["attention_benchmark.cc"],
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
