# backends/cuda/kernels/ — one translation unit per kernel family plus the
# shared device_utils.cuh helpers. This package holds the row and elementwise
# families (RmsNorm, QkPrep, Pointwise, GlobalNorm) and the sequence families
# (Attention, Classifier, Embedding); the optimizer targets land alongside
# them. See docs/kernels.md.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_binary",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# Header-only device helpers shared by every row/elementwise family. Built as a
# plain cc_library: the header is text, and each .cu compiles it into its own
# translation unit.
cc_library(
    name = "device_utils",
    hdrs = ["device_utils.cuh"],
    deps = ["//include/nanochat:nanochat"],
)

# RmsNorm: the frozen forward/backward pair plus the backend-internal fused
# residual variant (rms_norm.h).
cuda_library(
    name = "rms_norm",
    srcs = ["rms_norm.cu"],
    hdrs = ["rms_norm.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# QkPrep: fused RMSNorm -> RoPE -> scale on q and k.
cuda_library(
    name = "qk_prep",
    srcs = ["qk_prep.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Pointwise: scale, scale-add, gate-mul, relu^2, softcap.
cuda_library(
    name = "pointwise",
    srcs = ["pointwise.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# GlobalNorm: global L2 reduction and in-place clip.
cuda_library(
    name = "global_norm",
    srcs = ["global_norm.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Attention: causal / sliding-window / grouped-query, forward and backward.
# The promoted fused windowed forward (`window_left >= 0`, `head_dim == 128`)
# compiles into this translation unit. It reuses device_utils, the device
# runtime, the cuBLAS gemm seam, and the frozen interface, so the dependency
# set below is unchanged and stays minimal.
cuda_library(
    name = "attention",
    srcs = ["attention.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//backends/cuda:gemm",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Classifier: logit softcap + cross-entropy over the vocab slice.
cuda_library(
    name = "classifier",
    srcs = ["classifier.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Embedding: indexed gather forward and scatter-add backward.
cuda_library(
    name = "embedding",
    srcs = ["embedding.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# AdamW: the stateful pointwise update for the embedding, head, and scalar
# parameters.
cuda_library(
    name = "adamw",
    srcs = ["adamw.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Muon: Nesterov momentum, MuonEq equilibration, Polar Express through batched
# cuBLAS GEMMs, NorMuon, and the cautious update for the stacked matrix
# parameters.
cuda_library(
    name = "muon",
    srcs = ["muon.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//backends/cuda:gemm",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# ANVIL: the twin-rail momentum, the Frobenius-normalized whitening cascade
# through batched cuBLAS GEMMs, the per-lane energy equalizer, and the
# sign-aligned cautious update for the stacked matrix parameters. Opt-in beside
# Muon (docs/optimizer-anvil-design.md).
cuda_library(
    name = "anvil",
    srcs = ["anvil.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//backends/cuda:gemm",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# ResFormer value gate: `v += 3*sigmoid(h[:12] @ gate_w^T) * ve`.
cuda_library(
    name = "value_gate",
    srcs = ["value_gate.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Convenience aggregate the host graph and the family tests link.
cc_library(
    name = "row_kernels",
    deps = [
        ":global_norm",
        ":pointwise",
        ":qk_prep",
        ":rms_norm",
    ],
)

# Aggregate for the sequence families (Attention, Classifier, Embedding,
# value gate). The promoted fused windowed attention forward is part of
# `:attention`, so this aggregate keeps the same four family libraries and
# adds no package.
cc_library(
    name = "sequence_kernels",
    deps = [
        ":attention",
        ":classifier",
        ":embedding",
        ":value_gate",
    ],
)

# Aggregate for the optimizer families: AdamW, Muon, and the gradient-clipping
# GlobalNorm. The optimizer tests link this target.
cc_library(
    name = "optimizer_kernels",
    deps = [
        ":adamw",
        ":anvil",
        ":global_norm",
        ":muon",
    ],
)

# T1 GPU smoke correctness: tiny shapes, host code only, exercises every family
# through the sealed nanochat/kernels.h API plus the fused residual helper.
cc_test(
    name = "row_kernels_gpu_test",
    srcs = ["row_kernels_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_kernels",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# T1 GPU correctness with a float reference for the elementwise/norm and
# attention families, run in both the fp32 and fp16 builds. The fp16 half is
# what pins the recorded tolerance and the Pascal atomics on sm_61.
cc_test(
    name = "precision_gpu_test",
    srcs = ["precision_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":row_kernels",
        ":sequence_kernels",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

