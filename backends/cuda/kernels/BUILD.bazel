# AdamW: the stateful pointwise update for the embedding, head, and scalar
# parameters.
cuda_library(
    name = "adamw",
    srcs = ["adamw.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Muon: Nesterov momentum, MuonEq equilibration, Polar Express through batched
# cuBLAS GEMMs, NorMuon, and the cautious update for the stacked matrix
# parameters. The fused single-kernel variant this path selects by shape lives in
# `:muon_fused`, and the seam entry here calls it.
cuda_library(
    name = "muon",
    srcs = ["muon.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        ":muon_fused",
        ":muon_gemm_shape",
        "//backends/cuda:device",
        "//backends/cuda:gemm",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# The fused Muon path: one phase-parameterised device function, its 16 phases and
# three epilogue folds, and the two drivers over one device body
# (docs/kernels.md sections 4 to 6). `:muon` is its one in-tree caller;
# the source is also exported for the emulator library under //tools/cuda_sim/emu,
# which compiles this same file with the host compiler, and the GPU test and the
# benchmark call the entry directly so a phase gate can bisect one driver against
# the other.
#
# The `.cu` and its header are exported as files as well as built into this
# target: `filegroup` srcs of the emulated library refer to them by label, and the
# generated copy is compiled beside the other emulated families.
exports_files([
    "muon_fused.cu",
    "muon_fused.h",
])

cuda_library(
    name = "muon_fused",
    srcs = ["muon_fused.cu"],
    hdrs = ["muon_fused.h"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# ResFormer value gate: `v += 3*sigmoid(h[:12] @ gate_w^T) * ve`.
cuda_library(
    name = "value_gate",
    srcs = ["value_gate.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Smear: the learned bigram residual on the token embedding, one launch per
# direction. The backward reduces the two parameter gradients at a phase
# boundary inside the same launch (see the file header).
cuda_library(
    name = "smear",
    srcs = ["smear.cu"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":device_utils",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# Convenience aggregate the host graph and the family tests link.
cc_library(
    name = "row_kernels",
    deps = [
        ":fp8",
        ":grad_norm",
        ":pointwise",
        ":qk_prep",
        ":rms_norm",
    ],
)

# Aggregate for the sequence families (Attention, Classifier, Embedding,
# value gate). The promoted fused windowed attention forward is part of
# `:attention`, so this aggregate keeps the same four family libraries and
# adds no package.
cc_library(
    name = "sequence_kernels",
    deps = [
        ":attention",
        ":classifier",
        ":embedding",
        ":smear",
        ":value_gate",
    ],
)

# Aggregate for the optimizer families: AdamW, Muon, and the
# gradient-norm GradNorm. The optimizer tests link this target.
cc_library(
    name = "optimizer_kernels",
    deps = [
        ":adamw",
        ":grad_norm",
        ":muon",
    ],
)

