# backends/cuda/gemm/ -- the hand-written tensor-core GEMM
# (docs/kernels.md Part 3, docs/tensor-core-gemm-plan.md Part B).
#
# One bf16 tile for now. The fp8 kernel is a separate campaign
# (docs/tensor-core-gemm-plan.md decision D3); its micro-tile wrapper already
# exists in //backends/cuda/kernels:mma_ops.
#
# The seam entry point is not here: `backends/cuda/gemm.cu` keeps `Gemm` and
# `GemmWgrad` and owns the shape table that decides when this tile takes a call.
# This package supplies the tile and its launcher, and the launcher answers
# false when it cannot serve a call, which keeps cuBLAS as the fallback.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_binary",
    "cuda_library",
    "cuda_test",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# The kernel, the block tile, and the launcher. `alwayslink` keeps the two
# launcher symbols reachable from the seam entry, which is their only caller.
#
# The build selects the translation unit and not a preprocessor guard. The bf16
# tile needs a tensor core with bf16, so only a bf16 or fp8 build compiles
# `gemm_bf16.cu`, `gemm_tile.cuh`, and the kernel; the fp32 build links no tile
# and keeps cuBLAS (docs/tensor-core-gemm-plan.md section B.9). `gemm.cu` names
# the launchers unconditionally and discards the call through `kComputeIsBf16`,
# so no source in this package holds an `#if`. A fourth precision joins the
# select when its operand type is bf16 too.
cuda_library(
    name = "gemm_bf16",
    srcs = select({
        "//:bf16": ["gemm_bf16.cu"],
        "//:fp8": ["gemm_bf16.cu"],
        "//conditions:default": [],
    }),
    hdrs = [
        "gemm_launch.h",
        "gemm_plan.h",
        "gemm_tile.cuh",
        "mma_bf16.cuh",
    ],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":dispatch",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# The closed shape list and the verdict, and the one resolved form of a call
# that the table, the launcher, and the kernel all share
# (docs/tensor-core-gemm-plan.md section B.6). Host only, so its gate rides the
# default CPU loop.
cc_library(
    name = "dispatch",
    srcs = ["dispatch.cc"],
    hdrs = [
        "cutlass_rules.h",
        "dispatch.h",
        "gemm_plan.h",
        "gemm_shape.h",
        "linear_shape.h",
    ],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda/kernels:muon_gemm_shape",
        "//include/nanochat:nanochat",
    ],
)

# The candidate registry (docs/kernels.md section 11.4). Host only: the table is
# data, and no entry names a vendor type, so `candidate_registry_test` reads the
# registry with no card and no CUTLASS header.
cc_library(
    name = "cutlass_candidates",
    srcs = ["cutlass_candidates.cc"],
    hdrs = ["cutlass_candidates.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
)

# The measurement rows of the sweep (docs/kernels.md section 11.5). Host only:
# a row states extents and every other quantity is derived, so
# `bench_shapes_test` checks the list and its arithmetic with no card.
cc_library(
    name = "bench_shapes",
    srcs = ["bench_shapes.cc"],
    hdrs = ["bench_shapes.h"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":dispatch",
        "//include/nanochat:nanochat",
    ],
)

# The Hopper mainloop, borrowed from NVIDIA CUTLASS (docs/kernels.md Part 3
# section 5). One candidate is eight kernels: four operand orientations times two
# store types, and the registry of section 11.4 names four candidates.
#
# **This is the only target in the tree that names an architecture on itself.**
# The warpgroup instruction is architecture conditional and needs `sm_90a`, so
# the target states it and `rules_cuda` ignores the command line for it alone.
# The default build of `//...` therefore stays at `sm_75`, which is what
# `dev/cutlass/README.md` proved before this target existed.
#
# **The vendor options are these targets' own.** The CUTLASS headers emit
# thousands of warnings and `--config=sim-gate` turns warnings into errors, so
# these targets do not load `nanochat_cuda_copts`. `--expt-relaxed-constexpr`
# lets the headers call a host `constexpr` from a device function without a
# warning, which is what they do throughout.
#
# **`-DNDEBUG` is a measurement, not a habit.** Without it, every `assert` of
# the vendored headers becomes a device call to `__assertfail`, which ptxas
# cannot inline. Two defects follow: the calls sit inside the k loop, so the
# accumulator leaves the register file (STACK 576, 2090 LDL, 1124 STL in
# candidate 0), and ptxas serializes the `wgmma` instructions around them
# (warning C7509). With `-DNDEBUG` the same translation unit reads STACK 0, no
# local access, and no call at all. `docs/kernels.md` section 11.9 records it.
#
# The source joins the build on the same selection as the hand tile: the operands
# are bf16, so only a bf16 or fp8 build compiles it, and the fp32 build keeps
# cuBLAS. An fp32 build also has no `sm_90a` target, so no H100 is required to
# build the tree.

#: The candidates the build compiles, as registry indices. One source file,
#: `cutlass_candidate.cu`, holds every kernel body and reads its own row of
#: `kGemmCandidates`, so this list is the build's whole statement of "how many
#: candidates". The registry states the same number in
#: `NANOCHAT_FOR_EACH_CANDIDATE`, and a mismatch fails the build: a missing
#: index leaves a symbol undefined, and an extra one trips the `static_assert`
#: in the source.
#:
#: **One translation unit for each candidate.** A candidate is eight
#: instantiations and `dev/cutlass/README.md` measures one instantiation at 19 s
#: and 1.2 GiB, so four candidates in one compiler process would exceed the
#: development host's budget. One target for each index is what keeps the
#: build's memory peak at one candidate.
_CANDIDATE_INDICES = ["0", "1", "2", "3"]

[
    cuda_library(
        name = "cutlass_candidate_" + index,
        srcs = select({
            "//:bf16": ["cutlass_candidate.cu"],
            "//:fp8": ["cutlass_candidate.cu"],
            "//conditions:default": [],
        }),
        hdrs = [
            "cutlass_candidates.h",
            "cutlass_kernel.cuh",
        ],
        archs = ["sm_90a"],
        copts = [
            "-O2",
            "-Xcompiler",
            "-O2",
            "--expt-relaxed-constexpr",
            "-DNDEBUG",
        ],
        local_defines = ["NANOCHAT_CANDIDATE_INDEX=" + index],
        defines = precision_defines(),
        deps = [
            ":cutlass_candidates",
            ":dispatch",
            "//backends/cuda:device",
            "//include/nanochat:nanochat",
            "@cutlass//:cutlass",
        ],
        alwayslink = True,
    )
    for index in _CANDIDATE_INDICES
]

# The dispatcher: the call table, the choice of candidate, the device test, and
# the two seam entries. It names no numbered entry, because the table is built
# from the registry's own index list and `cutlass_launch.h` declares the entries
# from it.
cuda_library(
    name = "cutlass_bf16",
    srcs = select({
        "//:bf16": ["cutlass_bf16.cu"],
        "//:fp8": ["cutlass_bf16.cu"],
        "//conditions:default": [],
    }),
    hdrs = [
        "cutlass_candidates.h",
        "cutlass_launch.h",
        "gemm_shape.h",
    ],
    archs = ["sm_90a"],
    copts = [
        "-O2",
        "-Xcompiler",
        "-O2",
        "--expt-relaxed-constexpr",
        "-DNDEBUG",
    ],
    defines = precision_defines(),
    deps = [
        ":cutlass_candidate_" + index
        for index in _CANDIDATE_INDICES
    ] + [
        ":cutlass_candidates",
        ":dispatch",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
        "@cutlass//:cutlass",
    ],
    alwayslink = True,
)

# The fp8 arm of the same mainloop (docs/kernels.md section 10.4): E4M3
# operands, an fp32 accumulator, and a dequantization formed on the device. It
# is one tile and not a registry row, so it is one target and eight
# instantiations. Only an fp8 build compiles it, and only an fp8 build of
# `gemm.cu` calls it, through `if constexpr (kFp8Build)`.
cuda_library(
    name = "cutlass_fp8",
    srcs = select({
        "//:fp8": ["cutlass_fp8.cu"],
        "//conditions:default": [],
    }),
    hdrs = [
        "cutlass_candidates.h",
        "cutlass_kernel.cuh",
        "cutlass_launch.h",
        "gemm_shape.h",
    ],
    archs = ["sm_90a"],
    copts = [
        "-O2",
        "-Xcompiler",
        "-O2",
        "--expt-relaxed-constexpr",
        "-DNDEBUG",
    ],
    defines = precision_defines(),
    deps = [
        ":cutlass_candidates",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
        "@cutlass//:cutlass",
    ],
    alwayslink = True,
)

# The shape table's gate: the list matches the shapes `muon.cu` issues, a row
# selects only its own key, and only a turned bit changes a shape's hands.
cc_test(
    name = "dispatch_test",
    srcs = ["dispatch_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":cutlass_candidates",
        ":dispatch",
        "//backends/cuda/kernels:muon_gemm_shape",
        "//include/nanochat:nanochat",
    ],    size = "small",
)

# The registry's gate: four candidates, each at a tile and a stage count the
# probe measured, each fitting the Hopper window, and one override that selects
# exactly the candidate it names.
cc_test(
    name = "candidate_registry_test",
    srcs = ["candidate_registry_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [":cutlass_candidates"],
    size = "small",
)

# The measurement rows' gate: the list, its derived arithmetic, the budget skip,
# the iteration count, and the check's predicate. Host only.
cc_test(
    name = "bench_shapes_test",
    srcs = ["bench_shapes_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [":bench_shapes"],
    size = "small",
)

# The device gate of the same kernel: cuBLAS is the reference, because both
# sides accumulate bf16 products in fp32 and only the order differs. It drives
# the launcher and not the seam, because every row of the shape table is inert.
# Needs a card and a bf16 build. An fp32 build compiles the stand-in `main`
# instead, so the label stays in every test list.
cc_test(
    name = "gemm_gpu_test",
    srcs = select({
        "//:bf16": ["gemm_gpu_test.cc"],
        "//:fp8": ["gemm_gpu_test.cc"],
        "//conditions:default": ["gemm_bf16_only_main.cc"],
    }),
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":cutlass_candidates",
        ":gemm_bf16",
        "//backends/cuda:gemm",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# The rate gate: one row per shape, once on the tile and once on cuBLAS, through
# the shipped `Gemm` and the `NANOCHAT_GEMM_LIB` switch. Needs a card and a bf16
# build, so it is a benchmark and not a test. It takes the same fp32 stand-in as
# the gate above.
cuda_binary(
    name = "gemm_benchmark",
    srcs = select({
        "//:bf16": ["gemm_benchmark.cc"],
        "//:fp8": ["gemm_benchmark.cc"],
        "//conditions:default": ["gemm_bf16_only_main.cc"],
    }),
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        ":bench_shapes",
        ":cutlass_bf16",
        ":cutlass_candidates",
        ":dispatch",
        "//backends/cuda:gemm",
        # The fp8 arms quantize the row's own operands, so the benchmark calls
        # the seam's `QuantizeFp8` and links the kernel that defines it
        # (docs/kernels.md section 10.4).
        "//backends/cuda/kernels:fp8",
        "//backends/cuda/kernels/testing:bench_utils",
        "//include/nanochat:nanochat",
    ],
)

# Phase 1 of docs/kernels.md Part 3: the gate of the `ldmatrix` and `mma.sync`
# micro-tile. One binary holds two rows over one reference. The host row is the
# header's host arm, which is the arm the emulation engine compiles, so it needs
# no card. The device row is the instruction pair in one warp, so the target
# carries `gpu` and `manual`.
#
# The header's device arm is guarded by `__CUDA_ARCH__ >= 800`, and below that
# the plain arm compiles as device code and stays correct, so the target builds
# at every architecture the tree supports.
cuda_test(
    name = "mma_bf16_test",
    srcs = ["mma_bf16_test.cu"],
    hdrs = ["mma_bf16.cuh"],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = ["//include/nanochat:nanochat"],
    size = "small",
    tags = [
        "gpu",
        "manual",
    ],
)

# Aggregation point consumed by `//:all_tests`. The GPU correctness and
# benchmark targets land here as sections B2, B3, and B4 of
# docs/tensor-core-gemm-plan.md add them. The emulated check of this same
# kernel is //tools/cuda_sim/emu:gemm_emu_test, because the host compiler
# builds it at bf16 by construction.
test_suite(
    name = "all",
    tests = [
        ":bench_shapes_test",
        ":candidate_registry_test",
        ":dispatch_test",
        ":gemm_gpu_test",
        ":mma_bf16_test",
    ],
)
