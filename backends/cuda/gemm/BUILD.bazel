# backends/cuda/gemm/ -- the hand-written tensor-core GEMM
# (docs/kernels.md Part 3, docs/tensor-core-gemm-plan.md Part B).
#
# One bf16 tile for now. The fp8 kernel is a separate campaign
# (docs/tensor-core-gemm-plan.md decision D3); its micro-tile wrapper already
# exists in //backends/cuda/kernels:mma_ops.
#
# The seam entry point is not here: `backends/cuda/gemm.cu` keeps `Gemm` and
# `GemmWgrad` and owns the shape table that decides when this tile takes a call.
# This package supplies the tile and its launcher, and the launcher answers
# false when it cannot serve a call, which keeps cuBLAS as the fallback.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load(
    "//:nanochat.bzl",
    "cuda_binary",
    "cuda_library",
    "nanochat_copts",
    "nanochat_cuda_copts",
    "precision_defines",
)

package(default_visibility = ["//visibility:public"])

# The kernel, the block tile, and the launcher. `alwayslink` keeps the two
# launcher symbols reachable from the seam entry, which is their only caller.
#
# The build selects the translation unit and not a preprocessor guard. The bf16
# tile needs a tensor core with bf16, so only a bf16 or fp8 build compiles
# `gemm_bf16.cu`, `gemm_tile.cuh`, and the kernel; the fp32 build links no tile
# and keeps cuBLAS (docs/tensor-core-gemm-plan.md section B.9). `gemm.cu` names
# the launchers unconditionally and discards the call through `kComputeIsBf16`,
# so no source in this package holds an `#if`. A fourth precision joins the
# select when its operand type is bf16 too.
cuda_library(
    name = "gemm_bf16",
    srcs = select({
        "//:bf16": ["gemm_bf16.cu"],
        "//:fp8": ["gemm_bf16.cu"],
        "//conditions:default": [],
    }),
    hdrs = [
        "gemm_launch.h",
        "gemm_plan.h",
        "gemm_tile.cuh",
    ],
    copts = nanochat_cuda_copts(),
    defines = precision_defines(),
    deps = [
        ":dispatch",
        "//backends/cuda:device",
        "//include/nanochat:nanochat",
    ],
    alwayslink = True,
)

# The closed shape list and the verdict, and the one resolved form of a call
# that the table, the launcher, and the kernel all share
# (docs/tensor-core-gemm-plan.md section B.6). Host only, so its gate rides the
# default CPU loop.
cc_library(
    name = "dispatch",
    srcs = ["dispatch.cc"],
    hdrs = [
        "dispatch.h",
        "gemm_plan.h",
        "gemm_shape.h",
        "linear_shape.h",
    ],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        "//backends/cuda/kernels:muon_gemm_shape",
        "//include/nanochat:nanochat",
    ],
)

# The shape table's gate: the list matches the shapes `muon.cu` issues, a row
# selects only its own key, and only a turned bit changes a shape's hands.
cc_test(
    name = "dispatch_test",
    srcs = ["dispatch_test.cc"],
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":dispatch",
        "//backends/cuda/kernels:muon_gemm_shape",
        "//include/nanochat:nanochat",
    ],    size = "small",
)

# The device gate of the same kernel: cuBLAS is the reference, because both
# sides accumulate bf16 products in fp32 and only the order differs. It drives
# the launcher and not the seam, because every row of the shape table is inert.
# Needs a card and a bf16 build. An fp32 build compiles the stand-in `main`
# instead, so the label stays in every test list.
cc_test(
    name = "gemm_gpu_test",
    srcs = select({
        "//:bf16": ["gemm_gpu_test.cc"],
        "//:fp8": ["gemm_gpu_test.cc"],
        "//conditions:default": ["gemm_bf16_only_main.cc"],
    }),
    copts = nanochat_copts(),
    defines = precision_defines(),
    deps = [
        ":gemm_bf16",
        "//backends/cuda:gemm",
        "//include/nanochat:nanochat",
    ],
    size = "small",
    tags = ["gpu"],
)

# The rate gate: one row per shape, once on the tile and once on cuBLAS, through
# the shipped `Gemm` and the `NANOCHAT_GEMM_LIB` switch. Needs a card and a bf16
# build, so it is a benchmark and not a test. It takes the same fp32 stand-in as
# the gate above.
cuda_binary(
    name = "gemm_benchmark",
    srcs = select({
        "//:bf16": ["gemm_benchmark.cc"],
        "//:fp8": ["gemm_benchmark.cc"],
        "//conditions:default": ["gemm_bf16_only_main.cc"],
    }),
    copts = nanochat_cuda_copts(),
    host_copts = nanochat_copts(),
    defines = precision_defines(),
    host_defines = precision_defines(),
    deps = [
        ":dispatch",
        "//backends/cuda:gemm",
        "//backends/cuda/kernels/testing:bench_utils",
        "//include/nanochat:nanochat",
    ],
)

# Aggregation point consumed by `//:all_tests`. The GPU correctness and
# benchmark targets land here as sections B2, B3, and B4 of
# docs/tensor-core-gemm-plan.md add them. The emulated check of this same
# kernel is //tools/cuda_sim/emu:gemm_emu_test, because the host compiler
# builds it at bf16 by construction.
test_suite(
    name = "all",
    tests = [
        ":dispatch_test",
        ":gemm_gpu_test",
    ],
)
