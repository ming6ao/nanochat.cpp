# backends/cpu/ — the reference implementation of every kernel, used as the
# oracle-on-CPU path and as the correctness baseline. See docs/build.md.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//:nanochat.bzl", "nanochat_copts", "precision_defines")

package(default_visibility = ["//visibility:public"])

# The reference declaration of this device: the six utilities, the arithmetic
# primitives (both reductions included), the two stateful entries, both attention
# variants at one tile size, and the capability bits it offers
# (spec/capability_bits.md). Exported as a file so the device-profile derivation
# (`src/device_profile.cc`) and `//backends/cpu:caps_test` read the same bytes
# rather than a second hand-written copy. It declares no fused-override bit, so
# the planner resolves every composition to the composition path here
# (docs/model-and-device-bringup.md section 7.4).
filegroup(
    name = "caps_json",
    srcs = ["caps.json"],
)

# The string-to-constant table of `spec/capability_bits.md` section 2: one row per
# vocabulary name, carrying the `kFeature*` constant the frozen
# `include/nanochat/tensor.h` actually defines. `caps_test` checks the
# declaration against it, so a declared name with no constant fails loudly
# instead of being dropped on the floor. The table includes `tensor.h`, so it
# needs the build precision like every other target that does.
cc_library(
    name = "caps_names",
    hdrs = ["caps_names.h"],
    defines = precision_defines(),
    deps = [
        "//include/nanochat:nanochat",
    ],
)

# The CPU backend: every symbol in nanochat/kernels.h as a naive loop. The
# precision (fp32 / fp16) is a build-time define, so the library is built once
# per `--config` and vendored into whichever executable links it.
# OpenMP parallelises the reference loops on the host. docs/build.md allows
# OpenMP as a CPU dependency. The flag must appear in both `copts` and
# `linkopts`: the compiler needs it to parse the pragmas, and the linker needs
# it to resolve the runtime (`libgomp`). No extra Bazel dependency is required.
cc_library(
    name = "cpu",
    srcs = ["kernels.cc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    # `--config=sim` (docs/simulator.md section 4.1) compiles the capability
    # override into the reference backend. The define is scoped to this target
    # so the rest of the tree is unaffected by a simulated run.
    defines = precision_defines() + select({
        "//:sim": ["NANOCHAT_SIMULATOR"],
        "//conditions:default": [],
    }),
    deps = [
        "//include/nanochat:nanochat",
        # The device profile table the override reads. It is a leaf library, so
        # this does not point a backend at the workflow layer (DESIGN.md 2.1).
        "//src:device_profile",
    ],
)

# Self-check for the reference kernels: analytic identities plus a
# finite-difference gradient check for every family with a backward. The oracle
# parity test lives in //tests.
cc_test(
    name = "kernels_test",
    srcs = ["kernels_test.cc"],
    copts = nanochat_copts() + ["-fopenmp"],
    linkopts = ["-fopenmp"],
    # Under `--config=sim` the linked `:cpu` target answers `GetCaps()` from
    # `NANOCHAT_SIM_PROFILE`, so the test needs the same define to guard its
    # host-caps assertion.
    defines = precision_defines() + select({
        "//:sim": ["NANOCHAT_SIMULATOR"],
        "//conditions:default": [],
    }),
    deps = [
        ":cpu",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# The declaration's own gate: caps.json is data, so this test is what keeps it
# honest. It reads its bits against the vocabulary of spec/capability_bits.md and
# fails on any fused-override bit, which is the section 7.4 consequence stated as
# data.
cc_test(
    name = "caps_test",
    srcs = ["caps_test.cc"],
    copts = nanochat_copts(),
    data = [":caps_json"],
    defines = precision_defines(),
    deps = [
        ":caps_names",
        "//include/nanochat:nanochat",
    ],
    size = "small",
)

# Aggregation point consumed by //:all_tests. Each test is listed, so a new
# test file is added here rather than picked up implicitly.
test_suite(
    name = "all",
    tests = [
        ":caps_test",
        ":kernels_test",
    ],
)
