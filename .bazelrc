# nanochat.cpp — Bazel configuration. See docs/build.md.
#
# Layering:
#   * toolchain: the C++ standard here; the host compiler is host-local;
#   * arch:      Pascal sm_61 is the default; --config=sm_75 and --config=t4
#                select Turing (T4);
#   * precision: fp32 is the default, fp16 is --config=fp16;
#   * resources: cap the Bazel server and per-server action fan-out so several
#                agent worktrees cannot exhaust the small shared host.
# Named configs are additive: `--config=sm_75 --config=fp16` builds the Turing
# half-precision variant. `--config=t4` is the complete Turing CUDA target.

# --- Toolchain --------------------------------------------------------------
#
# The host CUDA toolkit is the Debian/Ubuntu package: nvcc lives in /usr/bin
# (a wrapper around /usr/lib/nvidia-cuda-toolkit), headers in /usr/include, and
# libraries in /usr/lib/x86_64-linux-gnu. CUDA 12.0's host_config rejects the
# distribution default gcc 13, so the workstation pins gcc-12. That pin is
# host-specific and lives in `.bazelrc.local` (see `.bazelrc.wsl`). The tracked
# file sets no compiler, so a host with a supported default builds unchanged.
# See docs/host-portability.md.

# C++20 everywhere (CONTRIBUTING.md). rules_cuda forwards the C++ fragment's
# options to the nvcc host pass.
build --cxxopt=-std=c++20

# --- Architecture -----------------------------------------------------------
#
# sm_61 (GTX 1080 Ti) is the default. Named config sm_75 selects Turing (T4).
build --@rules_cuda//cuda:archs=sm_61
build:sm_75 --@rules_cuda//cuda:archs=sm_75

# --- Precision --------------------------------------------------------------
#
# fp32 is the default; fp16 is for the sm_75 build. The config settings live at
# //:fp32 and //:fp16 and are consumed with select() in per-directory BUILD
# files. See docs/precision.md.
build --define=precision=fp32
build:fp16 --define=precision=fp16

# --- Backend ----------------------------------------------------------------
#
# `src/**` links the reference CPU backend by default; `--config=cuda` links
# the CUDA backend for GPU oracle parity and the sm_75 port. The selection is a
# build/link decision only -- the workflow sources are compiled once. See
# docs/backends.md.
#
# `--config=cpu` states that default backend and precision together. It is the
# configuration the Python API documents for the host-only shared library:
# tools/nanochat build //bindings:nanochat_shared --config=cpu. See
# docs/python-api.md.
build --define=backend=cpu
build:cuda --define=backend=cuda
build:cpu --define=backend=cpu
build:cpu --define=precision=fp32

# --- Host targets -----------------------------------------------------------
#
# A complete named target for one host. `t4` is the Turing half-precision CUDA
# build for a Kaggle Notebook (sm_75). `t4-fp32` is the same card at fp32, for
# the correctness gate. See docs/turing-t4.md and docs/kaggle.md.
build:t4 --@rules_cuda//cuda:archs=sm_75
build:t4 --define=precision=fp16
build:t4 --define=backend=cuda
build:t4-fp32 --@rules_cuda//cuda:archs=sm_75
build:t4-fp32 --define=precision=fp32
build:t4-fp32 --define=backend=cuda

# --- Resources --------------------------------------------------------------
#
# Several agents and verifiers share one small host (8 GiB, ~7.7 GiB visible
# under WSL2), and every git worktree gets its own Bazel output base, hence its
# own long-lived server. Left unbounded, those servers accumulate (the default
# idle timeout is three hours) and each server sizes its own action pool to the
# whole machine, so N worktrees multiply the memory budget by N. That is what
# exhausted host memory on 2026-10-01. Cap the server heap, let it exit when
# idle, let the kernel stop it under pressure, and bound each server's action
# fan-out. `tools/nanochat build`/`test` additionally serialize builds under
# one lock, so only one server compiles at a time. See docs/sandbox.md.
startup --host_jvm_args=-Xmx1500m
startup --max_idle_secs=600
startup --shutdown_on_low_sys_mem

# Bound one server's local action pool. HOST_CPUS/HOST_RAM defaults would let
# each concurrent server use most of the machine.
build --jobs=4
build --local_resources=memory=3072

# --- Tests ------------------------------------------------------------------
test --test_output=errors

# tools/sandbox.sh wraps every test action. The systemd backend needs the
# client's session environment; the none backend needs none of it. Bazel's
# default test environment is minimal, so forward these explicitly.
test --test_env=HOME
test --test_env=XDG_RUNTIME_DIR
test --test_env=DBUS_SESSION_BUS_ADDRESS
# The sandbox backend choice and the GPU device set must reach the test wrapper
# and the test process. See docs/host-portability.md.
test --test_env=NANOCHAT_SANDBOX_BACKEND
test --test_env=NANOCHAT_GPU_DEVICES
# The CUDA driver (libcuda.so.1) lives in the driver mount, not the toolkit, and
# Bazel vendors only libcudart/libcublas into the test runfiles. Without the
# client's LD_LIBRARY_PATH the test action cannot dlopen libcuda, so the
# runtime reports CUDA_ERROR_INSUFFICIENT_DRIVER ("CUDA driver version is
# insufficient for CUDA runtime version") even though the driver is new enough.
# See docs/host-portability.md.
test --test_env=LD_LIBRARY_PATH

# --- Host-local overrides ---------------------------------------------------
#
# A host puts its compiler, arch, and resource budget here. The file is not
# tracked. `try-import` ignores a missing file, so a fresh checkout works.
try-import %workspace%/.bazelrc.local
